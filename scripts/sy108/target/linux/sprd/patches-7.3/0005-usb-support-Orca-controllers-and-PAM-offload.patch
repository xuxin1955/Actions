+	if (ncm->pam_error)
+		return ncm->pam_error;
+	if (ncm->parser_opts != &ndp16_opts || ncm->is_crc ||
+	    input_size < USB_CDC_NCM_NTB_MIN_IN_SIZE || input_size > SZ_16K)
+		return -EOPNOTSUPP;
