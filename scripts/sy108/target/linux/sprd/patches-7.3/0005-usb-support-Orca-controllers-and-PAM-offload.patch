+static int ncm_pamu3_stop(struct f_ncm *ncm)
+{
+	int ret;
+
+	gether_pamu3_disconnect(&ncm->port);
+	ncm->netdev = NULL;
+	WRITE_ONCE(ncm->pam_running, false);
+	ret = sprd_pamu3_stop(ncm->pam);
+	if (!ret) {
+		ncm->pam_armed = false;
+		ncm->pam_prepared = false;
+	}
+	return ret;
+}
