+	{ ANA, REG_ANLG_PHY_G4_RF_ANALOG_USB20_1_REG_SEL_CFG_0,
+	  MASK_ANLG_PHY_G4_RF_DBG_SEL_ANALOG_USB20_1_USB20_DPPULLDOWN |
