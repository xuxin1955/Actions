+		ret = sprd_pamu3_prepare(ncm->pam);
+		if (ret)
+			return ret;
+		ncm->pam_prepared = true;
+	}
+	if (!ncm->pam_armed) {
+		ret = config_ep_by_speed(f->config->cdev->gadget, f,
+					 ncm->port.in_ep);
+		if (!ret)
+			ret = config_ep_by_speed(f->config->cdev->gadget, f,
+						 ncm->port.out_ep);
+		if (!ret)
+			ret = sprd_pamu3_arm(ncm->pam, ncm->port.out_ep,
