index 000000000..6a8029fed
--- /dev/null
+++ b/drivers/pci/controller/dwc/pcie-sprd-orca-client.c
@@ -0,0 +1,648 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * AP-side Orca endpoint client. Derived from GPL sprd_pcie_ep_device.c.
+ * Copyright (C) 2018-2019 Spreadtrum Co., Ltd.
+ * Mainline lifecycle/locking adaptation; does not fabricate a SIPA producer.
+ */
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/overflow.h>
+#include <linux/pci.h>
+#include <linux/pcie-rc-sprd.h>
+#include <linux/rcupdate.h>
+#include <linux/soc/sprd/sprd_pcie_ep_device.h>
+
+#define ORCA_VECTORS 32
+#define ORCA_IRQ_BASE 16
+#define ORCA_HW_VECTORS 4
+#define ORCA_CFG_BAR 4
+#define ORCA_ATU_BASE 0x10000
+#define ORCA_ATU_VIEWPORT 0x900
+#define ORCA_ATU_CR1 0x904
+#define ORCA_ATU_CR2 0x908
+#define ORCA_ATU_TARGET_LO 0x918
+#define ORCA_ATU_TARGET_HI 0x91c
+#define ORCA_ATU_ENABLE BIT(31)
+#define ORCA_ATU_BAR_MATCH BIT(30)
+#define ORCA_DOORBELL_STATUS 0x14
+
+struct orca_irq_callback {
+	irq_handler_t handler;
+	void *data;
+};
+
+struct orca_bar {
+	bool used;
+	int ipa_type;
+	void __iomem *mapping, *address;
+	phys_addr_t ipa_address;
+};
+
+struct orca_endpoint;
+struct orca_irq_context {
+	struct orca_endpoint *endpoint;
+	int index;
+};
+
+struct orca_endpoint {
+	struct pci_dev *pdev;
+	void __iomem *cfg;
+	struct orca_bar bar[4];
+	bool unrolled, dying, suspended, ready;
+	struct orca_irq_context irq_context[PCIE_EP_MAX_IRQ];
+	unsigned int requested_irqs, redirected_irqs;
+};
+
+/* Lock order: notify_lock -> callback_lock -> endpoint_lock -> doorbell_lock. */
+static DEFINE_MUTEX(endpoint_lock);
+static DEFINE_MUTEX(notify_lock);
+static DEFINE_MUTEX(callback_lock);
+static DEFINE_SPINLOCK(doorbell_lock);
+static struct orca_endpoint *endpoint;
+static struct orca_irq_callback __rcu *callbacks[PCIE_EP_MAX_IRQ];
+static void (*endpoint_notify)(int, void *);
+static void *notify_data;
+static bool probe_notified;
+
+static void orca_notify(bool present)
+{
+	mutex_lock(&notify_lock);
+	if (endpoint_notify && probe_notified != present) {
+		probe_notified = present;
+		endpoint_notify(present ? PCIE_EP_PROBE : PCIE_EP_REMOVE,
+				notify_data);
+	}
+	mutex_unlock(&notify_lock);
+}
+
+int sprd_ep_dev_register_notify(int ep, void (*notify)(int, void *), void *data)
+{
+	bool present;
+	int ret = 0;
+
+	if (ep != PCIE_EP_MODEM || !notify)
+		return -EINVAL;
+	mutex_lock(&notify_lock);
+	if (endpoint_notify) {
+		ret = -EBUSY;
+		goto out;
+	}
+	mutex_lock(&endpoint_lock);
+	if (endpoint && (endpoint->dying || endpoint->suspended)) {
+		mutex_unlock(&endpoint_lock);
+		ret = -ENODEV;
+		goto out;
+	}
+	endpoint_notify = notify;
+	notify_data = data;
+	present = endpoint && !endpoint->dying && !endpoint->suspended;
+	mutex_unlock(&endpoint_lock);
+	probe_notified = present;
+	if (present)
+		notify(PCIE_EP_PROBE, data);
+out:
+	mutex_unlock(&notify_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(sprd_ep_dev_register_notify);
+
+int sprd_ep_dev_unregister_notify(int ep)
+{
+	if (ep != PCIE_EP_MODEM)
+		return -EINVAL;
+	mutex_lock(&notify_lock);
+	endpoint_notify = NULL;
+	notify_data = NULL;
+	probe_notified = false;
+	mutex_unlock(&notify_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(sprd_ep_dev_unregister_notify);
+
+int sprd_ep_dev_register_irq_handler(int ep, int irq, irq_handler_t handler,
+				     void *data)
+{
+	struct orca_irq_callback *cb;
+	int ret = 0;
+
+	if (ep != PCIE_EP_MODEM || irq < 0 || irq >= PCIE_EP_MAX_IRQ ||
+	    !handler)
+		return -EINVAL;
+	cb = kmalloc_obj(*cb, GFP_KERNEL);
+	if (!cb)
+		return -ENOMEM;
+	cb->handler = handler;
+	cb->data = data;
+	mutex_lock(&callback_lock);
+	mutex_lock(&endpoint_lock);
+	if (endpoint && (endpoint->dying || endpoint->suspended))
+		ret = -ENODEV;
+	else if (rcu_access_pointer(callbacks[irq]))
+		ret = -EBUSY;
+	else
+		rcu_assign_pointer(callbacks[irq], cb);
+	mutex_unlock(&endpoint_lock);
+	mutex_unlock(&callback_lock);
+	if (ret)
+		kfree(cb);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(sprd_ep_dev_register_irq_handler);
+
+int sprd_ep_dev_unregister_irq_handler(int ep, int irq)
+{
+	struct orca_irq_callback *old;
+
+	if (ep != PCIE_EP_MODEM || irq < 0 || irq >= PCIE_EP_MAX_IRQ)
+		return -EINVAL;
+	mutex_lock(&callback_lock);
+	old = rcu_replace_pointer(callbacks[irq], NULL,
+				  lockdep_is_held(&callback_lock));
+	mutex_unlock(&callback_lock);
+	synchronize_rcu();
+	kfree(old);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(sprd_ep_dev_unregister_irq_handler);
+
+static irqreturn_t orca_endpoint_irq(int irq, void *data)
+{
+	struct orca_irq_callback *cb;
+	struct orca_irq_context *context = data;
+	int index = context->index;
+	irqreturn_t ret = IRQ_HANDLED;
+
+	if (!READ_ONCE(context->endpoint->ready))
+		return IRQ_HANDLED;
+	rcu_read_lock();
+	cb = rcu_dereference(callbacks[index]);
+	if (cb)
+		ret = cb->handler(irq, cb->data);
+	rcu_read_unlock();
+	return ret;
+}
+
+int sprd_ep_dev_raise_irq(int ep, int irq)
+{
+	struct orca_endpoint *e;
+	unsigned long flags;
+	int ret = 0;
+	u32 value;
+
+	if (ep != PCIE_EP_MODEM || irq < 0 || irq >= 32)
+		return -EINVAL;
+	spin_lock_irqsave(&doorbell_lock, flags);
+	e = endpoint;
+	if (!e || e->dying || e->suspended) {
+		ret = -ENODEV;
+		goto out;
+	}
+	value = readl(e->cfg + ORCA_DOORBELL_STATUS);
+	writel(value | BIT(irq), e->cfg + ORCA_DOORBELL_STATUS);
+out:
+	spin_unlock_irqrestore(&doorbell_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(sprd_ep_dev_raise_irq);
+
+/* endpoint_lock covers selection, viewport programming AND the enable poll. */
+static void __iomem *orca_atu_ctrl(struct orca_endpoint *e, int bar)
+{
+	void __iomem *base = e->cfg + ORCA_ATU_BASE;
+
+	if (e->unrolled)
+		return base + (bar << 9) + BIT(8) + 4;
+	writel(BIT(31) | bar, base + ORCA_ATU_VIEWPORT);
+	return base + ORCA_ATU_CR2;
+}
+
+static void orca_disable_bar(struct orca_endpoint *e, int bar)
+{
+	void __iomem *ctrl = orca_atu_ctrl(e, bar);
+
+	writel(readl(ctrl) & ~ORCA_ATU_ENABLE, ctrl);
+	readl(ctrl);
+}
+
+static int orca_enable_bar(struct orca_endpoint *e, int bar, phys_addr_t target)
+{
+	void __iomem *base = e->cfg + ORCA_ATU_BASE, *ctrl;
+	int retry;
+
+	ctrl = orca_atu_ctrl(e, bar);
+	if (e->unrolled) {
+		base += (bar << 9) + BIT(8);
+		writel(lower_32_bits(target), base + 0x14);
+		writel(upper_32_bits(target), base + 0x18);
+		writel(0, base);
+	} else {
+		writel(lower_32_bits(target), base + ORCA_ATU_TARGET_LO);
+		writel(upper_32_bits(target), base + ORCA_ATU_TARGET_HI);
+		writel(0, base + ORCA_ATU_CR1);
+	}
+	writel(ORCA_ATU_ENABLE | ORCA_ATU_BAR_MATCH | (bar << 8), ctrl);
+	for (retry = 0; retry < 5; retry++) {
+		if (readl(ctrl) & ORCA_ATU_ENABLE)
+			return 0;
+		usleep_range(9000, 10000);
+	}
+	orca_disable_bar(e, bar);
+	return -ETIMEDOUT;
+}
+
+static int orca_select_bar(struct orca_endpoint *e, int type)
+{
+	bool hardware = IS_ENABLED(CONFIG_SPRD_IPA_PCIE_WORKROUND);
+	int first = hardware ? 2 : 0, bar;
+
+	if (hardware && type >= 0) {
+		if (e->bar[type].used)
+			return -EBUSY;
+		return type;
+	}
+	for (bar = first; bar < ORCA_CFG_BAR; bar++)
+		if (!e->bar[bar].used &&
+		    (pci_resource_flags(e->pdev, bar) & IORESOURCE_MEM) &&
+		    pci_resource_len(e->pdev, bar))
+			return bar;
+	return -ENOSPC;
+}
+
+static int orca_map_bar(struct orca_endpoint *e, phys_addr_t target,
+			size_t size, int type)
+{
+	resource_size_t len, offset, base, span, end;
+	struct orca_bar *lease;
+	int bar, ret;
+
+	if (!size)
+		return -EINVAL;
+	bar = orca_select_bar(e, type);
+	if (bar < 0)
+		return bar;
+	len = pci_resource_len(e->pdev, bar);
+	if (!(pci_resource_flags(e->pdev, bar) & IORESOURCE_MEM) || !len ||
+	    !is_power_of_2(len) || len > SIZE_MAX)
+		return -EINVAL;
+	base = target & ~(len - 1);
+	offset = target - base;
+	if (check_add_overflow((resource_size_t)target,
+			       (resource_size_t)size - 1, &end) ||
+	    check_add_overflow(offset, (resource_size_t)size, &span) ||
+	    span > len || span > SIZE_MAX - (PAGE_SIZE - 1))
+		return -ERANGE;
+	span = PAGE_ALIGN(span);
+	if (span > len)
+		return -ERANGE;
+	lease = &e->bar[bar];
+	if (type < 0) {
+		lease->mapping =
+			ioremap(pci_resource_start(e->pdev, bar), span);
+		if (!lease->mapping)
+			return -ENOMEM;
+	}
+	ret = orca_enable_bar(e, bar, base);
+	if (ret) {
+		if (lease->mapping)
+			iounmap(lease->mapping);
+		memset(lease, 0, sizeof(*lease));
+		return ret;
+	}
+	lease->used = true;
+	lease->ipa_type = type;
+	if (type < 0)
+		lease->address = lease->mapping + offset;
+	else
+		lease->ipa_address = pci_resource_start(e->pdev, bar) + offset;
+	return bar;
+}
+
+static void orca_unmap_bar(struct orca_endpoint *e, int bar)
+{
+	struct orca_bar *lease = &e->bar[bar];
+
+	orca_disable_bar(e, bar);
+	if (lease->mapping)
+		iounmap(lease->mapping);
+	memset(lease, 0, sizeof(*lease));
+}
+
+void __iomem *sprd_ep_map_memory(int ep, phys_addr_t target, size_t size)
+{
+	void __iomem *result = NULL;
+	int bar;
+
+	if (ep != PCIE_EP_MODEM)
+		return NULL;
+	mutex_lock(&endpoint_lock);
+	if (endpoint && !endpoint->dying && !endpoint->suspended) {
+		bar = orca_map_bar(endpoint, target, size, -1);
+		if (bar >= 0)
+			result = endpoint->bar[bar].address;
+	}
+	mutex_unlock(&endpoint_lock);
+	return result;
+}
+EXPORT_SYMBOL_GPL(sprd_ep_map_memory);
+
+void sprd_ep_unmap_memory(int ep, const void __iomem *address)
+{
+	int bar;
+
+	if (ep != PCIE_EP_MODEM || !address)
+		return;
+	mutex_lock(&endpoint_lock);
+	if (endpoint)
+		for (bar = 0; bar < ORCA_CFG_BAR; bar++)
+			if (endpoint->bar[bar].used &&
+			    endpoint->bar[bar].ipa_type < 0 &&
+			    endpoint->bar[bar].address == address) {
+				orca_unmap_bar(endpoint, bar);
+				break;
+			}
+	mutex_unlock(&endpoint_lock);
+}
+EXPORT_SYMBOL_GPL(sprd_ep_unmap_memory);
+
+phys_addr_t sprd_ep_ipa_map(int type, phys_addr_t target, size_t size)
+{
+	phys_addr_t result = 0;
+	int bar;
+
+	if (type != PCIE_IPA_TYPE_MEM && type != PCIE_IPA_TYPE_REG)
+		return 0;
+	mutex_lock(&endpoint_lock);
+	if (endpoint && !endpoint->dying && !endpoint->suspended) {
+		bar = orca_map_bar(endpoint, target, size, type);
+		if (bar >= 0)
+			result = endpoint->bar[bar].ipa_address;
+	}
+	mutex_unlock(&endpoint_lock);
+	return result;
+}
+EXPORT_SYMBOL_GPL(sprd_ep_ipa_map);
+
+int sprd_ep_ipa_unmap(int type, phys_addr_t address)
+{
+	int bar, ret = -ENOENT;
+
+	if ((type != PCIE_IPA_TYPE_MEM && type != PCIE_IPA_TYPE_REG) ||
+	    !address)
+		return -EINVAL;
+	mutex_lock(&endpoint_lock);
+	if (endpoint)
+		for (bar = 0; bar < ORCA_CFG_BAR; bar++)
+			if (endpoint->bar[bar].used &&
+			    endpoint->bar[bar].ipa_type == type &&
+			    endpoint->bar[bar].ipa_address == address) {
+				orca_unmap_bar(endpoint, bar);
+				ret = 0;
+				break;
+			}
+	mutex_unlock(&endpoint_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(sprd_ep_ipa_unmap);
+
+/* Dynamic RC removal is refused until clients explicitly release ownership. */
+int sprd_ep_dev_prepare_remove(struct device *host)
+{
+	struct pci_host_bridge *bridge;
+	unsigned long flags;
+	int bar, ret = 0;
+
+	mutex_lock(&notify_lock);
+	mutex_lock(&callback_lock);
+	mutex_lock(&endpoint_lock);
+	if (!endpoint)
+		goto out;
+	bridge = pci_find_host_bridge(endpoint->pdev->bus);
+	if (bridge->dev.parent != host)
+		goto out;
+	if (endpoint_notify || rcu_access_pointer(callbacks[0]) ||
+	    rcu_access_pointer(callbacks[1])) {
+		ret = -EBUSY;
+		goto out;
+	}
+	for (bar = 0; bar < ORCA_CFG_BAR; bar++)
+		if (endpoint->bar[bar].used) {
+			ret = -EBUSY;
+			goto out;
+		}
+	spin_lock_irqsave(&doorbell_lock, flags);
+	endpoint->dying = true;
+	spin_unlock_irqrestore(&doorbell_lock, flags);
+out:
+	mutex_unlock(&endpoint_lock);
+	mutex_unlock(&callback_lock);
+	mutex_unlock(&notify_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(sprd_ep_dev_prepare_remove);
+
+static void orca_free_irqs(struct orca_endpoint *e)
+{
+	unsigned int i;
+
+	for (i = 0; i < e->redirected_irqs; i++)
+		sprd_pcie_set_msi_ap_target(pci_irq_vector(e->pdev, i), true);
+	for (i = 0; i < e->requested_irqs; i++)
+		free_irq(pci_irq_vector(e->pdev, ORCA_IRQ_BASE + i),
+			 &e->irq_context[i]);
+	pci_free_irq_vectors(e->pdev);
+}
+
+static int orca_client_probe(struct pci_dev *pdev,
+			     const struct pci_device_id *id)
+{
+	struct orca_endpoint *e;
+	unsigned long flags;
+	u32 viewport;
+	int ret, i;
+
+	if (pci_is_bridge(pdev))
+		return -ENODEV;
+	e = kzalloc_obj(*e, GFP_KERNEL);
+	if (!e)
+		return -ENOMEM;
+	e->pdev = pdev;
+	ret = pci_enable_device_mem(pdev);
+	if (ret)
+		goto free;
+	ret = pci_request_regions(pdev, "sprd-orca-client");
+	if (ret)
+		goto disable;
+	if (!(pci_resource_flags(pdev, ORCA_CFG_BAR) & IORESOURCE_MEM) ||
+	    pci_resource_len(pdev, ORCA_CFG_BAR) < ORCA_ATU_BASE + 0x920) {
+		ret = -EINVAL;
+		goto regions;
+	}
+	e->cfg = pci_ioremap_bar(pdev, ORCA_CFG_BAR);
+	if (!e->cfg) {
+		ret = -ENOMEM;
+		goto regions;
+	}
+	ret = pci_read_config_dword(pdev, ORCA_ATU_VIEWPORT, &viewport);
+	if (ret) {
+		ret = pcibios_err_to_errno(ret);
+		goto unmap;
+	}
+	e->unrolled = viewport == U32_MAX;
+	ret = pci_alloc_irq_vectors(pdev, ORCA_VECTORS, ORCA_VECTORS,
+				    PCI_IRQ_MSI);
+	if (ret < 0)
+		goto unmap;
+	for (i = 0; i < PCIE_EP_MAX_IRQ; i++) {
+		e->irq_context[i].index = i;
+		e->irq_context[i].endpoint = e;
+		ret = request_irq(pci_irq_vector(pdev, ORCA_IRQ_BASE + i),
+				  orca_endpoint_irq, 0, "sprd-orca-client",
+				  &e->irq_context[i]);
+		if (ret)
+			goto irqs;
+		e->requested_irqs++;
+	}
+	if (IS_ENABLED(CONFIG_SPRD_IPA_PCIE_WORKROUND)) {
+		/* Exact BSP fixed BAR and MSI indices; opt-in, not board-inferred. */
+		for (i = 0; i < 2; i++)
+			if (!(pci_resource_flags(pdev, i) & IORESOURCE_MEM) ||
+			    !pci_resource_len(pdev, i)) {
+				ret = -ENODEV;
+				goto irqs;
+			}
+		for (i = 0; i < ORCA_HW_VECTORS; i++) {
+			ret = sprd_pcie_set_msi_ap_target(
+				pci_irq_vector(pdev, i), false);
+			if (ret)
+				goto irqs;
+			e->redirected_irqs++;
+		}
+	}
+	mutex_lock(&endpoint_lock);
+	if (endpoint) {
+		mutex_unlock(&endpoint_lock);
+		ret = -EBUSY;
+		goto irqs;
+	}
+	/* BSP's status initialisation; DOOR_BELL_ENABLE is not invented here. */
+	writel(U32_MAX, e->cfg + ORCA_DOORBELL_STATUS);
+	pci_set_master(pdev);
+	pci_set_drvdata(pdev, e);
+	spin_lock_irqsave(&doorbell_lock, flags);
+	e->ready = true;
+	endpoint = e;
+	spin_unlock_irqrestore(&doorbell_lock, flags);
+	mutex_unlock(&endpoint_lock);
+	orca_notify(true);
+	return 0;
+irqs:
+	orca_free_irqs(e);
+unmap:
+	pci_iounmap(pdev, e->cfg);
+regions:
+	pci_release_regions(pdev);
+disable:
+	pci_disable_device(pdev);
+free:
+	kfree(e);
+	return ret;
+}
+
+static void orca_client_remove(struct pci_dev *pdev)
+{
+	struct orca_endpoint *e = pci_get_drvdata(pdev);
+	unsigned long flags;
+	int bar;
+
+	mutex_lock(&endpoint_lock);
+	spin_lock_irqsave(&doorbell_lock, flags);
+	e->dying = true;
+	spin_unlock_irqrestore(&doorbell_lock, flags);
+	mutex_unlock(&endpoint_lock);
+	/* Consumers still have valid BARs while synchronously quiescing. */
+	orca_notify(false);
+	WRITE_ONCE(e->ready, false);
+	pci_clear_master(pdev);
+	orca_free_irqs(e);
+	mutex_lock(&endpoint_lock);
+	for (bar = 0; bar < ORCA_CFG_BAR; bar++)
+		if (e->bar[bar].used) {
+			dev_warn(&pdev->dev,
+				 "BAR%d lease survived REMOVE notification\n",
+				 bar);
+			orca_unmap_bar(e, bar);
+		}
+	spin_lock_irqsave(&doorbell_lock, flags);
+	endpoint = NULL;
+	spin_unlock_irqrestore(&doorbell_lock, flags);
+	pci_iounmap(pdev, e->cfg);
+	mutex_unlock(&endpoint_lock);
+	pci_release_regions(pdev);
+	pci_disable_device(pdev);
+	kfree(e);
+}
+
+static int orca_client_suspend(struct device *dev)
+{
+	struct orca_endpoint *e = pci_get_drvdata(to_pci_dev(dev));
+	unsigned long flags;
+	int bar, ret = 0;
+
+	mutex_lock(&notify_lock);
+	mutex_lock(&callback_lock);
+	mutex_lock(&endpoint_lock);
+	/* Legacy callback ABI has no sleep/quiesce acknowledgment. */
+	if (endpoint_notify || rcu_access_pointer(callbacks[0]) ||
+	    rcu_access_pointer(callbacks[1])) {
+		ret = -EBUSY;
+		goto out;
+	}
+	/* Do not invalidate live AP/IPA apertures without consumer quiescence. */
+	for (bar = 0; bar < ORCA_CFG_BAR; bar++)
+		if (e->bar[bar].used) {
+			ret = -EBUSY;
+			goto out;
+		}
+	spin_lock_irqsave(&doorbell_lock, flags);
+	e->suspended = true;
+	spin_unlock_irqrestore(&doorbell_lock, flags);
+out:
+	mutex_unlock(&endpoint_lock);
+	mutex_unlock(&callback_lock);
+	mutex_unlock(&notify_lock);
+	return ret;
+}
+
+static int orca_client_resume(struct device *dev)
+{
+	struct orca_endpoint *e = pci_get_drvdata(to_pci_dev(dev));
+	unsigned long flags;
+
+	mutex_lock(&endpoint_lock);
+	spin_lock_irqsave(&doorbell_lock, flags);
+	e->suspended = false;
+	spin_unlock_irqrestore(&doorbell_lock, flags);
+	mutex_unlock(&endpoint_lock);
+	return 0;
+}
+
+static const struct dev_pm_ops orca_client_pm = { SYSTEM_SLEEP_PM_OPS(
+	orca_client_suspend, orca_client_resume) };
+static const struct pci_device_id orca_client_ids[] = { { PCI_DEVICE(0x16c3,
+								     0xabcd) },
+							{} };
+MODULE_DEVICE_TABLE(pci, orca_client_ids);
+static struct pci_driver orca_client_driver = {
+	.name = "sprd-orca-client",
+	.id_table = orca_client_ids,
+	.probe = orca_client_probe,
+	.remove = orca_client_remove,
+	.driver.pm = pm_sleep_ptr(&orca_client_pm),
+	/* Legacy BAR consumers cannot acknowledge removal or drain accesses. */
+	.driver.suppress_bind_attrs = true,
+};
+module_pci_driver(orca_client_driver);
+MODULE_DESCRIPTION("AP-side Spreadtrum Orca PCI endpoint client");
+MODULE_LICENSE("GPL");
diff --git a/drivers/pci/controller/dwc/pcie-sprd-orca.c b/drivers/pci/controller/dwc/pcie-sprd-orca.c
new file mode 100644
index 000000000..cff127308
--- /dev/null
+++ b/drivers/pci/controller/dwc/pcie-sprd-orca.c
@@ -0,0 +1,563 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Orca PCIe root complex glue.
+ * Derived from the GPL Spreadtrum 2018-2019 pcie-sprd.c/pcie-sprd-misc.c.
+ * Copyright (C) 2018-2019 Spreadtrum corporation.
+ */
+#include <linux/delay.h>
+#include <linux/clk.h>
+#include <linux/iopoll.h>
+#include <linux/irq.h>
+#include <linux/msi.h>
+#include <linux/mutex.h>
+#include <linux/pcie-rc-sprd.h>
+#include <linux/soc/sprd/sprd_pcie_ep_device.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#include "pcie-designware.h"
+
+#define ORCA_PCIE_GEN_CTRL3 0xe58
+#define ORCA_PCIE_LTSSM_EN BIT(0)
+#define ORCA_PCIE_L1_AUXCLK_EN BIT(8)
+#define ORCA_PCIE_PM_CTRL 0xe60
+#define ORCA_PCIE_APP_CLK_PM_EN BIT(21)
+#define ORCA_PCIE_TX_MSG 0xe80
+#define ORCA_PCIE_PME_TURN_OFF BIT(19)
+#define ORCA_PCIE_MAX_STEPS 64
+#define ORCA_IPA_AHB_BASE 0x29000000
+#define ORCA_PCIE_CORE_GATE 0
+#define ORCA_PCIE_AUX_GATE 1
+#define ORCA_PCIE_GATE_COUNT 2
+
+enum orca_pcie_sequence {
+	ORCA_STARTUP,
+	ORCA_SHUTDOWN,
+	ORCA_SUSPEND,
+	ORCA_RESUME,
+	ORCA_ASPM,
+	ORCA_SEQUENCE_COUNT,
+};
+
+static const char *const orca_sequence_names[] = {
+	"sprd,pcie-startup-syscons",  "sprd,pcie-shutdown-syscons",
+	"sprd,pcie-suspend-syscons",  "sprd,pcie-resume-syscons",
+	"sprd,pcie-aspml1p2-syscons",
+};
+
+struct orca_pcie_step {
+	struct regmap *map;
+	u32 type, delay_ms, reg, mask, value;
+	int gate;
+};
+
+struct orca_pcie_sequence_data {
+	struct orca_pcie_step *steps;
+	unsigned int count;
+};
+
+struct orca_pcie {
+	struct dw_pcie pci;
+	struct mutex lifecycle_lock;
+	bool manually_offline;
+	struct orca_pcie_sequence_data sequence[ORCA_SEQUENCE_COUNT];
+	u32 msi_enable[MAX_MSI_CTRLS];
+	bool initialized;
+	bool powered;
+	bool suspending;
+	bool msi_saved;
+	int power_error;
+	struct clk *gates[ORCA_PCIE_GATE_COUNT];
+	bool gate_enabled[ORCA_PCIE_GATE_COUNT];
+};
+
+static struct orca_pcie *to_orca(struct dw_pcie *pci)
+{
+	return container_of(pci, struct orca_pcie, pci);
+}
+
+/* Resolve and validate every resource before executing any sequence. */
+static int orca_pcie_parse_sequence(struct orca_pcie *pcie, unsigned int which)
+{
+	struct device *dev = pcie->pci.dev;
+	struct device_node *np = dev->of_node;
+	struct orca_pcie_sequence_data *seq = &pcie->sequence[which];
+	const char *property = orca_sequence_names[which];
+	struct of_phandle_args args;
+	struct resource res;
+	int count, i, ret;
+
+	if (!of_property_present(np, property))
+		return which == ORCA_ASPM ? 0 : -EINVAL;
+	count = of_property_count_elems_of_size(np, property, 6 * sizeof(u32));
+	if (count <= 0 || count > ORCA_PCIE_MAX_STEPS)
+		return -EINVAL;
+	seq->steps = devm_kcalloc(dev, count, sizeof(*seq->steps), GFP_KERNEL);
+	if (!seq->steps)
+		return -ENOMEM;
+	for (i = 0; i < count; i++) {
+		struct orca_pcie_step *step = &seq->steps[i];
+
+		ret = of_parse_phandle_with_fixed_args(np, property, 5, i,
+						       &args);
+		if (ret)
+			return ret;
+		step->type = args.args[0];
+		step->delay_ms = args.args[1];
+		step->reg = args.args[2];
+		step->mask = args.args[3];
+		step->value = args.args[4];
+		step->gate = -1;
+		ret = of_address_to_resource(args.np, 0, &res);
+		if (ret || step->type > 2 || step->delay_ms > 10000 ||
+		    (step->reg & 3) || !step->mask ||
+		    (step->value & ~step->mask) ||
+		    (!ret && (u64)step->reg + 4 > resource_size(&res))) {
+			of_node_put(args.np);
+			return ret ?: -EINVAL;
+		}
+		step->map = syscon_node_to_regmap(args.np);
+		of_node_put(args.np);
+		if (IS_ERR(step->map))
+			return PTR_ERR(step->map);
+		/* The captured power sequences place the core/aux clock writes
+		 * between PHY/domain operations. Preserve that ordering, while
+		 * making these two gates visible to CCF instead of bypassing it.
+		 */
+		if (res.start == ORCA_IPA_AHB_BASE && !step->reg &&
+		    step->type != 2) {
+			if (step->mask == BIT(5))
+				step->gate = ORCA_PCIE_CORE_GATE;
+			else if (step->mask == BIT(6))
+				step->gate = ORCA_PCIE_AUX_GATE;
+		}
+	}
+	seq->count = count;
+	return 0;
+}
+
+static int orca_pcie_gate(struct orca_pcie *pcie, unsigned int gate,
+			  bool enable)
+{
+	int ret;
+
+	if (pcie->gate_enabled[gate] == enable)
+		return 0;
+	if (enable) {
+		ret = clk_prepare_enable(pcie->gates[gate]);
+		if (ret)
+			return ret;
+	} else {
+		clk_disable_unprepare(pcie->gates[gate]);
+	}
+	pcie->gate_enabled[gate] = enable;
+	return 0;
+}
+
+static void orca_pcie_release_gates(void *data)
+{
+	struct orca_pcie *pcie = data;
+
+	orca_pcie_gate(pcie, ORCA_PCIE_CORE_GATE, false);
+	orca_pcie_gate(pcie, ORCA_PCIE_AUX_GATE, false);
+}
+
+static int orca_pcie_run(struct orca_pcie *pcie, unsigned int which)
+{
+	struct orca_pcie_sequence_data *seq = &pcie->sequence[which];
+	unsigned int i;
+	int ret;
+	u32 value;
+
+	for (i = 0; i < seq->count; i++) {
+		struct orca_pcie_step *step = &seq->steps[i];
+
+		if (step->gate >= 0) {
+			ret = orca_pcie_gate(pcie, step->gate, !!step->value);
+			goto step_done;
+		}
+		switch (step->type) {
+		case 0:
+			ret = regmap_update_bits(step->map, step->reg,
+						 step->mask, step->value);
+			break;
+		case 1:
+			/* BSP forced RMW write; keep atomic regmap locking. */
+			ret = regmap_write_bits(step->map, step->reg,
+						step->mask, step->value);
+			break;
+		case 2:
+			ret = regmap_read_poll_timeout(
+				step->map, step->reg, value,
+				(value & step->mask) == step->value, 50, 10000);
+			break;
+		default:
+			return -EINVAL;
+		}
+step_done:
+		if (ret)
+			return ret;
+		if (step->delay_ms)
+			msleep(step->delay_ms);
+	}
+	return 0;
+}
+
+static int orca_pcie_start_link(struct dw_pcie *pci)
+{
+	struct orca_pcie *pcie = to_orca(pci);
+	unsigned int i;
+
+	/* Exact BSP application-control write, not a fabricated PHY sequence. */
+	dw_pcie_writel_dbi(pci, ORCA_PCIE_GEN_CTRL3,
+			   ORCA_PCIE_LTSSM_EN | ORCA_PCIE_L1_AUXCLK_EN);
+	/* Preserve endpoint-client hardware-owned MSI enables across resume. */
+	if (pcie->msi_saved)
+		for (i = 0; i < pci->pp.num_vectors / MAX_MSI_IRQS_PER_CTRL;
+		     i++)
+			dw_pcie_writel_dbi(pci,
+					   PCIE_MSI_INTR0_ENABLE +
+						   i * MSI_REG_CTRL_BLOCK_SIZE,
+					   pcie->msi_enable[i]);
+	return 0;
+}
+
+static void orca_pcie_stop_link(struct dw_pcie *pci)
+{
+	u32 value = dw_pcie_readl_dbi(pci, ORCA_PCIE_GEN_CTRL3);
+
+	value &= ~ORCA_PCIE_LTSSM_EN;
+	dw_pcie_writel_dbi(pci, ORCA_PCIE_GEN_CTRL3, value);
+}
+
+static int orca_pcie_host_init(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct orca_pcie *pcie = to_orca(pci);
+	int ret;
+
+	ret = orca_pcie_run(pcie,
+			    pcie->initialized ? ORCA_RESUME : ORCA_STARTUP);
+	if (!ret)
+		ret = orca_pcie_run(pcie, ORCA_ASPM);
+	if (ret) {
+		int cleanup = orca_pcie_run(pcie, ORCA_SHUTDOWN);
+
+		if (cleanup)
+			dev_warn(pci->dev, "PCIe cleanup failed: %d\n",
+				 cleanup);
+		orca_pcie_release_gates(pcie);
+		pcie->initialized = false;
+		return ret;
+	}
+	pcie->initialized = true;
+	pcie->powered = true;
+	pcie->suspending = false;
+	pcie->power_error = 0;
+	return orca_pcie_start_link(pci);
+}
+
+static void orca_pcie_host_deinit(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct orca_pcie *pcie = to_orca(pci);
+	unsigned int i;
+
+	if (!pcie->powered)
+		return;
+	if (pcie->suspending) {
+		for (i = 0; i < pp->num_vectors / MAX_MSI_IRQS_PER_CTRL; i++)
+			pcie->msi_enable[i] = dw_pcie_readl_dbi(
+				pci, PCIE_MSI_INTR0_ENABLE +
+					     i * MSI_REG_CTRL_BLOCK_SIZE);
+		pcie->msi_saved = true;
+	}
+	pcie->power_error = orca_pcie_run(
+		pcie, pcie->suspending ? ORCA_SUSPEND : ORCA_SHUTDOWN);
+	if (pcie->power_error)
+		dev_err(pci->dev, "PCIe power sequence failed: %d\n",
+			pcie->power_error);
+	/* Suspend keeps AUX running for the captured resume/wake sequence.
+	 * Full shutdown has no remaining link/wake consumer and releases it.
+	 */
+	if (!pcie->suspending) {
+		orca_pcie_release_gates(pcie);
+		pcie->initialized = false;
+	}
+	pcie->powered = false;
+}
+
+static void orca_pcie_pme_turn_off(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	u32 value;
+
+	value = dw_pcie_readl_dbi(pci, ORCA_PCIE_PM_CTRL);
+	dw_pcie_writel_dbi(pci, ORCA_PCIE_PM_CTRL,
+			   value | ORCA_PCIE_APP_CLK_PM_EN);
+	value = dw_pcie_readl_dbi(pci, ORCA_PCIE_TX_MSG);
+	dw_pcie_writel_dbi(pci, ORCA_PCIE_TX_MSG,
+			   value | ORCA_PCIE_PME_TURN_OFF);
+}
+
+static const struct dw_pcie_host_ops orca_pcie_host_ops = {
+	.init = orca_pcie_host_init,
+	.deinit = orca_pcie_host_deinit,
+	.pme_turn_off = orca_pcie_pme_turn_off,
+};
+
+static const struct dw_pcie_ops orca_pcie_ops = {
+	.start_link = orca_pcie_start_link,
+	.stop_link = orca_pcie_stop_link,
+};
+
+static int orca_pcie_msi_irq(struct platform_device *pdev)
+{
+	struct device_node *child;
+	const char *label;
+	int irq;
+
+	irq = platform_get_irq_byname_optional(pdev, "msi");
+	if (irq == -EPROBE_DEFER || irq > 0)
+		return irq;
+	/* Stock DT put the GIC MSI line in a labelled child. */
+	for_each_available_child_of_node(pdev->dev.of_node, child) {
+		if (of_property_read_string(child, "label", &label) ||
+		    strcmp(label, "msi_int"))
+			continue;
+		irq = of_irq_get(child, 0);
+		of_node_put(child);
+		return irq;
+	}
+	return -ENXIO;
+}
+
+/* Only accept our own bridge; other hosts may have unrelated driver data. */
+static struct orca_pcie *orca_from_pdev(struct platform_device *pdev)
+{
+	if (!pdev || !pdev->dev.driver ||
+	    strcmp(pdev->dev.driver->name, "sprd-orca-pcie"))
+		return NULL;
+	return platform_get_drvdata(pdev);
+}
+
+int sprd_pcie_set_msi_ap_target(unsigned int irq, bool enable)
+{
+	struct msi_desc *desc = irq_get_msi_desc(irq);
+	struct pci_host_bridge *bridge;
+	struct irq_data *data;
+	struct orca_pcie *pcie;
+	struct dw_pcie_rp *pp;
+	struct pci_dev *ep;
+	unsigned long flags;
+	u32 reg, value, bit;
+	unsigned int group;
+
+	if (!desc || !desc->dev || !dev_is_pci(desc->dev))
+		return -EINVAL;
+	ep = msi_desc_to_pci_dev(desc);
+	bridge = pci_find_host_bridge(ep->bus);
+	if (!bridge || !bridge->dev.parent ||
+	    !dev_is_platform(bridge->dev.parent))
+		return -ENODEV;
+	pcie = orca_from_pdev(to_platform_device(bridge->dev.parent));
+	if (!pcie || !READ_ONCE(pcie->powered))
+		return -ENODEV;
+	pp = &pcie->pci.pp;
+	for (data = irq_get_irq_data(irq); data; data = data->parent_data)
+		if (data->domain == pp->irq_domain)
+			break;
+	if (!data || data->hwirq >= pp->num_vectors)
+		return -EINVAL;
+	group = data->hwirq / MAX_MSI_IRQS_PER_CTRL;
+	bit = BIT(data->hwirq % MAX_MSI_IRQS_PER_CTRL);
+	reg = PCIE_MSI_INTR0_ENABLE + group * MSI_REG_CTRL_BLOCK_SIZE;
+	raw_spin_lock_irqsave(&pp->lock, flags);
+	value = dw_pcie_readl_dbi(&pcie->pci, reg);
+	value = enable ? value | bit : value & ~bit;
+	dw_pcie_writel_dbi(&pcie->pci, reg, value);
+	if (pcie->msi_saved)
+		pcie->msi_enable[group] = value;
+	raw_spin_unlock_irqrestore(&pp->lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(sprd_pcie_set_msi_ap_target);
+
+void sprd_pcie_teardown_msi_irq(unsigned int irq)
+{
+	WARN_ON_ONCE(sprd_pcie_set_msi_ap_target(irq, false));
+}
+EXPORT_SYMBOL_GPL(sprd_pcie_teardown_msi_irq);
+
+int sprd_pcie_unconfigure_device(struct platform_device *pdev)
+{
+	struct orca_pcie *pcie = orca_from_pdev(pdev);
+	struct pci_dev *child, *tmp;
+	int ret = 0;
+
+	if (!pcie)
+		return -ENODEV;
+	pci_lock_rescan_remove();
+	mutex_lock(&pcie->lifecycle_lock);
+	if (pcie->manually_offline)
+		goto out;
+#if IS_ENABLED(CONFIG_SPRD_PCIE_EP_DEVICE)
+	ret = sprd_ep_dev_prepare_remove(&pdev->dev);
+	if (ret)
+		goto out;
+#endif
+	/* No active registered consumer or BAR lease may survive this point. */
+	list_for_each_entry_safe(child, tmp, &pcie->pci.pp.bridge->bus->devices,
+				 bus_list)
+		pci_stop_and_remove_bus_device(child);
+	pcie->suspending = true;
+	ret = dw_pcie_suspend_noirq(&pcie->pci);
+	if (!ret)
+		ret = pcie->power_error;
+	/* Even partial power-down cannot be advertised as usable. */
+	pcie->manually_offline = true;
+out:
+	mutex_unlock(&pcie->lifecycle_lock);
+	pci_unlock_rescan_remove();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(sprd_pcie_unconfigure_device);
+
+int sprd_pcie_configure_device(struct platform_device *pdev)
+{
+	struct orca_pcie *pcie = orca_from_pdev(pdev);
+	int ret;
+
+	if (!pcie)
+		return -ENODEV;
+	pci_lock_rescan_remove();
+	mutex_lock(&pcie->lifecycle_lock);
+	if (pcie->power_error) {
+		ret = pcie->power_error;
+		goto out;
+	}
+	ret = dw_pcie_resume_noirq(&pcie->pci);
+	if (ret)
+		goto out;
+	if (!dw_pcie_link_up(&pcie->pci)) {
+		ret = -ENOLINK;
+		goto out;
+	}
+	pci_rescan_bus(pcie->pci.pp.bridge->bus);
+	pcie->manually_offline = false;
+out:
+	mutex_unlock(&pcie->lifecycle_lock);
+	pci_unlock_rescan_remove();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(sprd_pcie_configure_device);
+
+static int orca_pcie_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct orca_pcie *pcie;
+	unsigned int i;
+	int ret;
+	u32 vectors;
+
+	if (of_property_read_bool(dev->of_node, "no-pcie"))
+		return -ENODEV;
+	pcie = devm_kzalloc(dev, sizeof(*pcie), GFP_KERNEL);
+	if (!pcie)
+		return -ENOMEM;
+	mutex_init(&pcie->lifecycle_lock);
+	pcie->pci.dev = dev;
+	pcie->pci.ops = &orca_pcie_ops;
+	pcie->pci.pp.ops = &orca_pcie_host_ops;
+	pcie->gates[ORCA_PCIE_CORE_GATE] = devm_clk_get(dev, "core");
+	if (IS_ERR(pcie->gates[ORCA_PCIE_CORE_GATE]))
+		return dev_err_probe(dev,
+				     PTR_ERR(pcie->gates[ORCA_PCIE_CORE_GATE]),
+				     "missing PCIe core clock\n");
+	pcie->gates[ORCA_PCIE_AUX_GATE] = devm_clk_get(dev, "aux");
+	if (IS_ERR(pcie->gates[ORCA_PCIE_AUX_GATE]))
+		return dev_err_probe(dev,
+				     PTR_ERR(pcie->gates[ORCA_PCIE_AUX_GATE]),
+				     "missing PCIe auxiliary clock\n");
+	ret = devm_add_action_or_reset(dev, orca_pcie_release_gates, pcie);
+	if (ret)
+		return ret;
+	for (i = 0; i < ORCA_SEQUENCE_COUNT; i++) {
+		ret = orca_pcie_parse_sequence(pcie, i);
+		if (ret)
+			return dev_err_probe(dev, ret, "invalid %s\n",
+					     orca_sequence_names[i]);
+	}
+	ret = of_property_read_u32(dev->of_node, "num-vectors", &vectors);
+	if (ret || !vectors || vectors > MAX_MSI_IRQS ||
+	    vectors % MAX_MSI_IRQS_PER_CTRL)
+		return dev_err_probe(dev, -EINVAL,
+				     "invalid MSI vector count\n");
+	pcie->pci.pp.num_vectors = vectors;
+	ret = orca_pcie_msi_irq(pdev);
+	if (ret <= 0)
+		return dev_err_probe(dev, ret ?: -EINVAL,
+				     "missing MSI interrupt\n");
+	pcie->pci.pp.msi_irq[0] = ret;
+	platform_set_drvdata(pdev, pcie);
+	return dw_pcie_host_init(&pcie->pci.pp);
+}
+
+static int orca_pcie_suspend_noirq(struct device *dev)
+{
+	struct orca_pcie *pcie = dev_get_drvdata(dev);
+	int ret;
+
+	if (pcie->manually_offline)
+		return 0;
+	pcie->suspending = true;
+	ret = dw_pcie_suspend_noirq(&pcie->pci);
+	return ret ?: pcie->power_error;
+}
+
+static int orca_pcie_resume_noirq(struct device *dev)
+{
+	struct orca_pcie *pcie = dev_get_drvdata(dev);
+
+	if (pcie->manually_offline)
+		return 0;
+	return dw_pcie_resume_noirq(&pcie->pci);
+}
+
+static void orca_pcie_shutdown(struct platform_device *pdev)
+{
+	struct orca_pcie *pcie = platform_get_drvdata(pdev);
+
+	if (!pcie->powered) {
+		/* A manually suspended controller still owns its AUX reference. */
+		orca_pcie_release_gates(pcie);
+		return;
+	}
+	pcie->suspending = false;
+	orca_pcie_stop_link(&pcie->pci);
+	orca_pcie_host_deinit(&pcie->pci.pp);
+}
+
+static const struct dev_pm_ops orca_pcie_pm_ops = { NOIRQ_SYSTEM_SLEEP_PM_OPS(
+	orca_pcie_suspend_noirq, orca_pcie_resume_noirq) };
+
+static const struct of_device_id orca_pcie_of_match[] = {
+	{ .compatible = "sprd,orca-pcie" },
+	{}
+};
+
+static struct platform_driver orca_pcie_driver = {
+	.probe = orca_pcie_probe,
+	.shutdown = orca_pcie_shutdown,
+	.driver = {
+		.name = "sprd-orca-pcie",
+		.of_match_table = orca_pcie_of_match,
+		.pm = pm_sleep_ptr(&orca_pcie_pm_ops),
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(orca_pcie_driver);
