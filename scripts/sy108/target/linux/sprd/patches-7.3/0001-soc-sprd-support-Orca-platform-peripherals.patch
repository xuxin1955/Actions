@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/nvmem/sprd,orca-efuse.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum Orca public read-only eFuse
+
+description: |
+  The byte-addressed public region covers hardware blocks 2 through 46
+  inclusive (180 bytes). Offset zero maps to hardware block 2. All public
+  blocks use the redundant double-bit read mode. The driver provides no
+  programming operation. Thermal calibration uses the standard NVMEM cell
+  bits property; no calibrated values are encoded in this binding.
+
+maintainers:
+  - Orson Zhai <orsonzhai@gmail.com>
+  - Baolin Wang <baolin.wang7@gmail.com>
+  - Chunyan Zhang <zhang.lyra@gmail.com>
+
+properties:
+  compatible:
+    const: sprd,orca-efuse
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: enable
+
+  hwlocks:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - hwlocks
+
+allOf:
+  - $ref: nvmem.yaml#
+  - $ref: nvmem-deprecated-cells.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sprd,orca-clk.h>
+
+    efuse@63400000 {
+      compatible = "sprd,orca-efuse";
+      reg = <0x63400000 0x10000>;
+      clocks = <&aonapb_gate CLK_EFUSE_EB>;
+      clock-names = "enable";
+      hwlocks = <&hwlock 8>;
+      #address-cells = <1>;
+      #size-cells = <1>;
+
+      /* Data cells */
+      thermal_calib: calib@98 {
+        reg = <0x98 0x4>;
+        bits = <1 7>;
+      };
+    };
+...
diff --git a/Documentation/devicetree/bindings/pci/sprd,orca-pcie.yaml b/Documentation/devicetree/bindings/pci/sprd,orca-pcie.yaml
new file mode 100644
index 000000000..4409f34c6
--- /dev/null
+++ b/Documentation/devicetree/bindings/pci/sprd,orca-pcie.yaml
@@ -0,0 +1,112 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pci/sprd,orca-pcie.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum Orca PCIe root complex
+
+maintainers:
+  - Orson Zhai <orsonzhai@gmail.com>
+  - Baolin Wang <baolin.wang7@gmail.com>
+  - Chunyan Zhang <zhang.lyra@gmail.com>
+
+description: |
+  Orca integrates a DesignWare root complex and an application register
+  block in the DBI window. The transitional BSP sequence properties below
+  retain the exact board-provided PLL, sleep and PERST sequencing while
+  their ownership is converted to dedicated providers. They must not be
+  combined with another owner writing the same control bits.
+
+allOf:
+  - $ref: /schemas/pci/snps,dw-pcie.yaml#
+
+properties:
+  compatible:
+    const: sprd,orca-pcie
+
+  reg:
+    maxItems: 2
+
+  reg-names:
+    items:
+      - const: dbi
+      - const: config
+
+  num-lanes:
+    const: 1
+
+  num-vectors:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [32, 64, 96, 128, 160, 192, 224, 256]
+    description: Number of vectors in the integrated MSI receiver.
+
+  num-viewport:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Legacy BSP iATU window count; mainline detects the windows.
+    deprecated: true
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-names:
+    const: msi
+
+  no-pcie:
+    type: boolean
+    description: Legacy board-disable flag; new boards should use status.
+    deprecated: true
+
+  dummy@0:
+    type: object
+    description: Legacy placement of the GIC MSI interrupt in the stock tree.
+    properties:
+      label:
+        const: msi_int
+      interrupt-parent: true
+      '#interrupt-cells':
+        const: 3
+      interrupts:
+        maxItems: 1
+    required:
+      - label
+      - interrupts
+    additionalProperties: false
+    deprecated: true
+
+patternProperties:
+  '^sprd,pcie-(startup|shutdown|suspend|resume|aspml1p2)-syscons$':
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    minItems: 1
+    maxItems: 64
+    items:
+      items:
+        - description: Syscon provider
+        - description: Operation, 0 masked update, 1 forced masked write, 2 poll
+          minimum: 0
+          maximum: 2
+        - description: Delay after this operation, in milliseconds
+          maximum: 10000
+        - description: Aligned byte offset inside the syscon resource
+          multipleOf: 4
+        - description: Nonzero register mask
+          minimum: 1
+        - description: Value restricted to the mask
+    description: Ordered BSP syscon operations; poll has a bounded timeout.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - num-lanes
+  - num-vectors
+  - sprd,pcie-startup-syscons
+  - sprd,pcie-shutdown-syscons
+  - sprd,pcie-suspend-syscons
+  - sprd,pcie-resume-syscons
+
+oneOf:
+  - required: [interrupts, interrupt-names]
+  - required: [dummy@0]
+
+unevaluatedProperties: false
diff --git a/Documentation/devicetree/bindings/pinctrl/sprd,orca-pinctrl.yaml b/Documentation/devicetree/bindings/pinctrl/sprd,orca-pinctrl.yaml
new file mode 100644
index 000000000..79aa46d67
--- /dev/null
+++ b/Documentation/devicetree/bindings/pinctrl/sprd,orca-pinctrl.yaml
@@ -0,0 +1,562 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pinctrl/sprd,orca-pinctrl.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum Orca (UDX710) Pin Controller
+
+maintainers:
+  - Bruce Chen <bruce.chen@unisoc.com>
+
+description: |
+  Orca exposes global control fields, 174 common pad registers starting at
+  offset 0x30, and 174 miscellaneous pad registers starting at offset 0x430.
+  The common and miscellaneous registers are spaced four bytes apart.
+  Global control fields retain the names and field layout of the vendor BSP.
+
+  Register layouts and pull resistor encodings differ from SC9860, so an
+  SC9860 fallback compatible is not valid. The controller has no interrupt
+  or GPIO-provider interface in this binding.
+
+  Sleep-domain bits 0 through 3 select AP, PUBCP, TGLDSP and AGDSP, matching
+  the implemented Orca BSP behavior. Further domains need hardware evidence.
+  Hardware-controlled sleep states do not imply that Linux controls CP or
+  DSP firmware or their power state.
+
+  In sleep-hardware-state nodes, output-enable and output-disable control
+  the sleep output buffer. The legacy BSP output-high and output-low both
+  enabled that buffer without selecting a signal level; use output-enable
+  when translating those legacy properties. Do not infer output voltage or
+  logic level from this operation.
+
+properties:
+  compatible:
+    const: sprd,orca-pinctrl
+
+  reg:
+    maxItems: 1
+
+patternProperties:
+  '^[a-z][a-z0-9-]*-pins$':
+    $ref: '#/$defs/pin-node'
+    unevaluatedProperties: false
+
+    properties:
+      input-enable: false
+      input-disable: false
