From 4941301e9c618a4ed084ed5c3bd7add8ef48e3d0 Mon Sep 17 00:00:00 2001
From: jason-liu-4980 <38558962+jason-liu-4980@users.noreply.github.com>
Date: Sun, 18 Oct 2026 21:30:56 +0800
Subject: [PATCH 2/7] mtd: rawnand: support the Orca NAND controller

Add the Orca NAND controller with geometry-aware OOB/ECC handling and the vendor parameter table. Preserve all 28 hardware parameter records and reject incompatible geometry. Support the existing bad-block marker contract without changing the stored flash layout.
---
 drivers/mtd/nand/raw/Kconfig                 |    9 +
 drivers/mtd/nand/raw/Makefile                |    2 +
 drivers/mtd/nand/raw/nand_bbt.c              |    8 +
 drivers/mtd/nand/raw/sprd-orca-nand-params.h |  405 +++++
 drivers/mtd/nand/raw/sprd-orca-nand-regs.h   |  226 +++
 drivers/mtd/nand/raw/sprd-orca-nand.c        | 1714 ++++++++++++++++++
 include/linux/mtd/bbm.h                      |    4 +
 7 files changed, 2368 insertions(+)
 create mode 100644 drivers/mtd/nand/raw/sprd-orca-nand-params.h
 create mode 100644 drivers/mtd/nand/raw/sprd-orca-nand-regs.h
 create mode 100644 drivers/mtd/nand/raw/sprd-orca-nand.c

diff --git a/drivers/mtd/nand/raw/Kconfig b/drivers/mtd/nand/raw/Kconfig
index 1f4053e53..a75db8086 100644
--- a/drivers/mtd/nand/raw/Kconfig
+++ b/drivers/mtd/nand/raw/Kconfig
@@ -538,4 +538,13 @@ config MTD_NAND_DISKONCHIP_BBTWRITE
 	  load time (assuming you build diskonchip as a module) with the module
 	  parameter "inftl_bbt_write=1".
 
+config MTD_NAND_SPRD_ORCA
+	tristate "Spreadtrum UDX710 Orca raw NAND controller"
+	depends on OF && HAS_DMA
+	depends on ARCH_SPRD || COMPILE_TEST
+	help
+	  DMA and hardware ECC support for the Spreadtrum Orca (UDX710) raw
+	  NAND controller, using the vendor NAND parameter table and stock
+	  ECC/OOB geometry.
+
 endif # MTD_RAW_NAND
diff --git a/drivers/mtd/nand/raw/Makefile b/drivers/mtd/nand/raw/Makefile
index 619760138..4420d1d61 100644
--- a/drivers/mtd/nand/raw/Makefile
+++ b/drivers/mtd/nand/raw/Makefile
@@ -71,3 +71,5 @@ nand-objs += nand_micron.o
 nand-objs += nand_sandisk.o
 nand-objs += nand_samsung.o
 nand-objs += nand_toshiba.o
+
+obj-$(CONFIG_MTD_NAND_SPRD_ORCA) += sprd-orca-nand.o
diff --git a/drivers/mtd/nand/raw/nand_bbt.c b/drivers/mtd/nand/raw/nand_bbt.c
index b0e7592a2..8eb9564fa 100644
--- a/drivers/mtd/nand/raw/nand_bbt.c
+++ b/drivers/mtd/nand/raw/nand_bbt.c
@@ -127,6 +127,14 @@ static int check_pattern(uint8_t *buf, int len, int paglen, struct nand_bbt_desc
  */
 static int check_short_pattern(uint8_t *buf, struct nand_bbt_descr *td)
 {
+	if (td->min_good_bits) {
+		unsigned int bits = 0;
+		int i;
+
+		for (i = 0; i < td->len; i++)
+			bits += hweight8(buf[td->offs + i]);
+		return bits < td->min_good_bits ? -1 : 0;
+	}
 	/* Compare the pattern */
 	if (memcmp(buf + td->offs, td->pattern, td->len))
 		return -1;
