+static inline u32 ipa_phy_get_flow_ctrl_to_src_sts(void __iomem *reg_base,
+						   u32 *dst, u32 src)
+{
+	u32 tmp = 0;
+
+	tmp = readl_relaxed(reg_base + (u64)dst);
+
+	return (tmp & src);
+}
