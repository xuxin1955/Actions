+++ b/drivers/staging/sprd/sipa/sipa_phy_v0/sipa_common_fifo_hal.c
@@ -0,0 +1,1437 @@
+#include <linux/sipa.h>
+#include <linux/dma-mapping.h>
+
+#include "../sipa_hal_priv.h"
+#include "sipa_device.h"
+#include "sipa_glb_phy.h"
+#include "sipa_fifo_phy.h"
+
+static int
+ipa_reclaim_tx_fifo_unread_node_desc(struct sipa_common_fifo_cfg_tag *fifo_cfg,
+				     u32 tx_rptr, u32 tx_wptr, u32 rx_rptr,
+				     u32 rx_wptr)
+{
+	u32 index, tmp, depth;
+	ssize_t node_size = sizeof(struct sipa_node_description_tag);
+	struct sipa_node_description_tag *fill_node, *free_node;
+
+	fill_node = fifo_cfg->tx_fifo.virtual_addr;
+	free_node = fifo_cfg->rx_fifo.virtual_addr;
+	depth = (tx_wptr - rx_wptr) & PTR_MASK(fifo_cfg->rx_fifo.depth);
+
+	index = rx_wptr & (fifo_cfg->tx_fifo.depth - 1);
+	if (index + depth <= fifo_cfg->rx_fifo.depth) {
+		memcpy(free_node + index, fill_node + index, node_size * depth);
+	} else {
+		tmp = fifo_cfg->rx_fifo.depth - index;
+		memcpy(free_node + index, fill_node + index, node_size * tmp);
+		tmp = depth - tmp;
+		memcpy(free_node, fill_node, node_size * tmp);
+	}
+
+	/* Ensure that data copy completion before we update rptr/wptr */
+	dma_wmb();
+
+	tx_rptr = tx_wptr;
+	if (!ipa_phy_update_tx_fifo_rptr(fifo_cfg->fifo_reg_base, tx_rptr)) {
+		pr_err("sipa reclaim update tx_fifo rptr failed\n");
+		return -EIO;
+	}
+	rx_wptr = (rx_wptr + depth) & PTR_MASK(fifo_cfg->rx_fifo.depth);
+	if (!ipa_phy_update_rx_fifo_wptr(fifo_cfg->fifo_reg_base, rx_wptr)) {
+		pr_err("sipa reclaim update rx_fifo wptr failed\n");
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int
+ipa_reclaim_unfree_node_desc(struct sipa_common_fifo_cfg_tag *fifo_cfg,
+			     u32 tx_rptr, u32 tx_wptr, u32 rx_rptr, u32 rx_wptr)
+{
+	u32 index, tmp, num;
+	ssize_t node_size = sizeof(struct sipa_node_description_tag);
+	struct sipa_node_description_tag *fill_node, *free_node;
+
+	fill_node = fifo_cfg->tx_fifo.virtual_addr;
+	free_node = fifo_cfg->rx_fifo.virtual_addr;
+	num = (tx_wptr - rx_wptr) & PTR_MASK(fifo_cfg->rx_fifo.depth);
+
+	index = rx_wptr & (fifo_cfg->rx_fifo.depth - 1);
+	if (index + num <= fifo_cfg->rx_fifo.depth) {
+		memcpy(free_node + index, fill_node + index, node_size * num);
+	} else {
+		tmp = fifo_cfg->rx_fifo.depth - index;
+		memcpy(free_node + index, fill_node + index, node_size * tmp);
+		tmp = num - tmp;
+		memcpy(free_node, fill_node, node_size * tmp);
+	}
+
+	/* Ensure that data copy completion before we update rptr/wptr */
+	dma_wmb();
+
+	rx_wptr = (rx_wptr + num) & PTR_MASK(fifo_cfg->rx_fifo.depth);
+	if (!ipa_phy_update_rx_fifo_wptr(fifo_cfg->fifo_reg_base, rx_wptr)) {
+		pr_err("sipa reclaim unfree update rx_fifo wptr failed\n");
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static inline int
+ipa_put_pkts_to_rx_fifo(struct device *dev,
+			struct sipa_common_fifo_cfg_tag *fifo_cfg, u32 num)
+{
+	u32 filled, index, first, next;
+	size_t node_size = sizeof(struct sipa_node_description_tag);
+	struct sipa_node_description_tag *node = fifo_cfg->rx_fifo.virtual_addr;
+
+	filled = ipa_phy_get_rx_fifo_filled_depth(fifo_cfg->fifo_reg_base);
+	if (filled > fifo_cfg->rx_fifo.depth)
+		return -EIO;
+	if (filled == fifo_cfg->rx_fifo.depth)
+		return -ENOSPC;
+	num = min(num, fifo_cfg->rx_fifo.depth - filled);
+	if (!num || kfifo_len(&fifo_cfg->rx_priv_fifo) < num * node_size)
+		return -EINVAL;
+
+	index = fifo_cfg->rx_fifo.wr & (fifo_cfg->rx_fifo.depth - 1);
+	first = min(num, fifo_cfg->rx_fifo.depth - index);
+	if (kfifo_out(&fifo_cfg->rx_priv_fifo, node + index,
+		      first * node_size) != first * node_size)
+		return -EIO;
+	if (num > first &&
+	    kfifo_out(&fifo_cfg->rx_priv_fifo, node,
+		      (num - first) * node_size) != (num - first) * node_size)
+		return -EIO;
+
+	dma_wmb();
+	next = (fifo_cfg->rx_fifo.wr + num) & PTR_MASK(fifo_cfg->rx_fifo.depth);
+	/*
+	 * Publish failure is ambiguous: software callers must retain every
+	 * mapping and quarantine, never retry the consumed private descriptors.
+	 */
+	if (!ipa_phy_update_rx_fifo_wptr(fifo_cfg->fifo_reg_base, next)) {
+		dev_err(dev, "SIPA RX write pointer publication failed\n");
+		return -EIO;
+	}
+	fifo_cfg->rx_fifo.wr = next;
+	return num;
+}
+
+static inline u32
+ipa_recv_pkts_from_tx_fifo(struct device *dev,
+			   struct sipa_common_fifo_cfg_tag *fifo_cfg, u32 num)
+{
+	num = ipa_phy_get_tx_fifo_filled_depth(fifo_cfg->fifo_reg_base);
+	/* MMIO producer count is observed before descriptor contents. Rings
+	 * are coherent DDR or uncached SRAM, never streaming DMA aliases.
+	 */
+	dma_rmb();
+	return num;
+}
+
+static u32 ipa_common_fifo_hal_open(enum sipa_cmn_fifo_index id,
+				    struct sipa_common_fifo_cfg_tag *cfg_base,
+				    void *cookie)
+{
+	struct sipa_common_fifo_cfg_tag *ipa_term_fifo = NULL;
+
+	if (likely(id >= 0 && id < SIPA_FIFO_MAX)) {
+		ipa_term_fifo = cfg_base + id;
+	} else {
+		pr_err("don't have this id %d\n", id);
+		return FALSE;
+	}
+
+	if (ipa_term_fifo->state == TRUE) {
+		pr_err("fifo_id = %d has already opened\n",
+		       ipa_term_fifo->fifo_id);
+		return TRUE;
+	}
+
+	if (!ipa_phy_set_rx_fifo_total_depth(ipa_term_fifo->fifo_reg_base,
+					     ipa_term_fifo->rx_fifo.depth))
+		return FALSE;
+	if (!ipa_phy_set_rx_fifo_addr(ipa_term_fifo->fifo_reg_base,
+				      ipa_term_fifo->rx_fifo.fifo_base_addr_l,
+				      ipa_term_fifo->rx_fifo.fifo_base_addr_h))
+		return FALSE;
+
+	if (!ipa_phy_set_tx_fifo_total_depth(ipa_term_fifo->fifo_reg_base,
+					     ipa_term_fifo->tx_fifo.depth))
+		return FALSE;
+	if (!ipa_phy_set_tx_fifo_addr(ipa_term_fifo->fifo_reg_base,
+				      ipa_term_fifo->tx_fifo.fifo_base_addr_l,
+				      ipa_term_fifo->tx_fifo.fifo_base_addr_h))
+		return FALSE;
+
+	if (!ipa_phy_set_cur_term_num(ipa_term_fifo->fifo_reg_base,
+				      ipa_term_fifo->cur))
+		return FALSE;
+	if (!ipa_phy_set_dst_term_num(ipa_term_fifo->fifo_reg_base,
+				      ipa_term_fifo->dst))
+		return FALSE;
+
+	if (!ipa_phy_update_rx_fifo_rptr(ipa_term_fifo->fifo_reg_base, 0))
+		return FALSE;
+	if (!ipa_phy_update_rx_fifo_wptr(ipa_term_fifo->fifo_reg_base, 0))
+		return FALSE;
+	if (!ipa_phy_update_tx_fifo_rptr(ipa_term_fifo->fifo_reg_base, 0))
+		return FALSE;
+	if (!ipa_phy_update_tx_fifo_wptr(ipa_term_fifo->fifo_reg_base, 0))
+		return FALSE;
+
+	ipa_term_fifo->rx_fifo.rd = 0;
+	ipa_term_fifo->rx_fifo.wr = 0;
+	ipa_term_fifo->tx_fifo.rd = 0;
+	ipa_term_fifo->tx_fifo.wr = 0;
+
+	ipa_term_fifo->fifo_name = cookie;
+	ipa_term_fifo->state = TRUE;
+
+	return TRUE;
+}
+
+static u32 ipa_common_fifo_hal_close(enum sipa_cmn_fifo_index id,
+				     struct sipa_common_fifo_cfg_tag *cfg_base)
+{
+	struct sipa_common_fifo_cfg_tag *ipa_term_fifo;
+
+	if (likely(id >= 0 && id < SIPA_FIFO_MAX)) {
+		ipa_term_fifo = cfg_base + id;
+	} else {
+		pr_err("don't have this id %d\n", id);
+		return FALSE;
+	}
+
+	if (!ipa_phy_stop_receive(ipa_term_fifo->fifo_reg_base) ||
+	    !ipa_phy_disable_int_bit(ipa_term_fifo->fifo_reg_base,
+				     IPA_INT_EN_BIT_GROUP))
+		return FALSE;
+
+	if (!ipa_phy_set_rx_fifo_total_depth(ipa_term_fifo->fifo_reg_base, 0))
+		return FALSE;
+	if (!ipa_phy_set_tx_fifo_total_depth(ipa_term_fifo->fifo_reg_base, 0))
+		return FALSE;
+
+	if (!ipa_phy_update_rx_fifo_rptr(ipa_term_fifo->fifo_reg_base, 0))
+		return FALSE;
+	if (!ipa_phy_update_rx_fifo_wptr(ipa_term_fifo->fifo_reg_base, 0))
+		return FALSE;
+	if (!ipa_phy_update_tx_fifo_rptr(ipa_term_fifo->fifo_reg_base, 0))
+		return FALSE;
+	if (!ipa_phy_update_tx_fifo_wptr(ipa_term_fifo->fifo_reg_base, 0))
+		return FALSE;
+
+	ipa_term_fifo->rx_fifo.rd = 0;
+	ipa_term_fifo->rx_fifo.wr = 0;
+	ipa_term_fifo->tx_fifo.rd = 0;
+	ipa_term_fifo->tx_fifo.wr = 0;
+
+	ipa_term_fifo->state = FALSE;
+
+	return TRUE;
+}
+
+static u32
+ipa_common_fifo_hal_reset_fifo(enum sipa_cmn_fifo_index id,
+			       struct sipa_common_fifo_cfg_tag *cfg_base)
+{
+	struct sipa_common_fifo_cfg_tag *ipa_term_fifo;
+
+	if (likely(id < SIPA_FIFO_MAX)) {
+		ipa_term_fifo = cfg_base + id;
+	} else {
+		pr_err("don't have this id %d\n", id);
+		return FALSE;
+	}
+
+	ipa_phy_set_rx_fifo_total_depth(ipa_term_fifo->fifo_reg_base,
+					ipa_term_fifo->rx_fifo.depth);
+	ipa_phy_set_rx_fifo_addr(ipa_term_fifo->fifo_reg_base,
+				 ipa_term_fifo->rx_fifo.fifo_base_addr_l,
+				 ipa_term_fifo->rx_fifo.fifo_base_addr_h);
+
+	ipa_phy_set_tx_fifo_total_depth(ipa_term_fifo->fifo_reg_base,
+					ipa_term_fifo->tx_fifo.depth);
+	ipa_phy_set_tx_fifo_addr(ipa_term_fifo->fifo_reg_base,
+				 ipa_term_fifo->tx_fifo.fifo_base_addr_l,
+				 ipa_term_fifo->tx_fifo.fifo_base_addr_h);
+
+	ipa_phy_update_rx_fifo_rptr(ipa_term_fifo->fifo_reg_base, 0);
+	ipa_phy_update_rx_fifo_wptr(ipa_term_fifo->fifo_reg_base, 0);
+
+	ipa_phy_update_tx_fifo_rptr(ipa_term_fifo->fifo_reg_base, 0);
+	ipa_phy_update_tx_fifo_wptr(ipa_term_fifo->fifo_reg_base, 0);
+	ipa_term_fifo->rx_fifo.rd = 0;
+	ipa_term_fifo->rx_fifo.wr = 0;
+
+	ipa_term_fifo->tx_fifo.rd = 0;
+	ipa_term_fifo->tx_fifo.wr = 0;
+
+	ipa_term_fifo->state = TRUE;
+
+	return TRUE;
+}
+
+static u32
+ipa_common_fifo_hal_set_rx_depth(enum sipa_cmn_fifo_index id,
+				 struct sipa_common_fifo_cfg_tag *cfg_base,
+				 u32 depth)
+{
+	u32 ret;
+	struct sipa_common_fifo_cfg_tag *ipa_term_fifo;
+
+	if (likely(id < SIPA_FIFO_MAX)) {
+		ipa_term_fifo = cfg_base + id;
+	} else {
+		pr_err("don't have this id %d\n", id);
+		return FALSE;
+	}
+
+	ret = ipa_phy_set_rx_fifo_total_depth(ipa_term_fifo->fifo_reg_base,
+					      depth);
+
+	return ret;
+}
+
+static u32
+ipa_common_fifo_hal_get_rx_depth(enum sipa_cmn_fifo_index id,
+				 struct sipa_common_fifo_cfg_tag *cfg_base)
+{
+	struct sipa_common_fifo_cfg_tag *ipa_term_fifo;
+
+	if (likely(id < SIPA_FIFO_MAX)) {
+		ipa_term_fifo = cfg_base + id;
+	} else {
+		pr_err("don't have this id %d\n", id);
+		return 0;
+	}
+
+	return ipa_phy_get_rx_fifo_total_depth(ipa_term_fifo->fifo_reg_base);
+}
+
+static u32
+ipa_common_fifo_hal_set_tx_depth(enum sipa_cmn_fifo_index id,
+				 struct sipa_common_fifo_cfg_tag *cfg_base,
+				 u32 depth)
+{
+	u32 ret;
+	struct sipa_common_fifo_cfg_tag *ipa_term_fifo;
+
+	if (likely(id < SIPA_FIFO_MAX)) {
