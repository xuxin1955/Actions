+int sipa_get_ep_info(enum sipa_ep_id id, struct sipa_to_pam_info *out);
+
+/* Process-context PAM lifecycle. Caller holds an RM grant, keeps its producer
+ * disabled until connect returns zero, and supplies no caller-owned data_ptr
+ * pool (partial publication/reclamation is not supported).
+ *
+ * connect: -EUCLEAN retains an enable lease and requires START/drain/END;
+ * other errors precede hardware publication or complete the enable rollback.
+ * START: zero confirms stop-receive readback, not external DMA completion.
+ * END: caller has completed PAM RELEASE/DONE, disabled its producer, proved
+ * TX/RX DMA idle and released external endpoints. Zero retires the connection;
+ * any error retains SIPA rings, the lease, and caller ownership. -EAGAIN means
+ * FIFO descriptor ownership is not yet balanced. Retry START/END after the
+ * underlying condition is resolved. Repeated END after success is harmless.
+ * No API success permits freeing rings that are still installed in hardware.
+ */
+int sipa_pam_connect(const struct sipa_connect_params *in);
