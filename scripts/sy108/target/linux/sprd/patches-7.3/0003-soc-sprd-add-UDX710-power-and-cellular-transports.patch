+	ops->enable_def_flowctrl_to_src_blk =
+		sipa_hal_enable_def_flowctrl_to_src_blk;
+	ops->enable_to_pcie_no_mac = sipa_hal_enable_to_pcie_no_mac;
+	ops->enable_from_pcie_no_mac = sipa_hal_enable_from_pcie_no_mac;
+	ops->set_cp_ul_pri = sipa_hal_set_cp_ul_pri;
+	ops->set_cp_ul_dst_num = sipa_hal_set_cp_ul_dst_num;
+	ops->set_cp_ul_cur_num = sipa_hal_set_cp_ul_cur_num;
+	ops->set_cp_ul_flow_ctrl_mode = sipa_hal_set_cp_ul_flow_ctrl_mode;
+	ops->set_cp_dl_pri = sipa_hal_set_cp_dl_pri;
+	ops->set_cp_dl_dst_num = sipa_hal_set_cp_dl_dst_num;
+	ops->set_cp_dl_cur_num = sipa_hal_set_cp_dl_cur_num;
+	ops->set_cp_dl_flow_ctrl_mode = sipa_hal_set_cp_dl_flow_ctrl_mode;
+	ops->ctrl_cp_work = sipa_hal_ctrl_cp_work;
+	ops->enable_pcie_intr_write_reg_mode =
+		sipa_hal_enable_pcie_intr_write_reg_mode;
+	ops->get_resume_status = sipa_hal_check_resume_status;
+	ops->get_pause_status = sipa_hal_check_pause_status;
