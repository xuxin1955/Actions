+/* quickly fill a smsg body */
+static inline void smsg_set(struct smsg *msg, u8 channel, u8 type, u16 flag,
+			    u32 value)
+{
+	msg->channel = channel;
+	msg->type = type;
+	msg->flag = flag;
+	msg->value = value;
