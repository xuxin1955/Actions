+static int ipa_reclaim_cmn_fifo(enum sipa_cmn_fifo_index id,
+				struct sipa_common_fifo_cfg_tag *cfg_base)
+{
+	int ret = 0;
+	u32 tx_rptr, tx_wptr, rx_wptr, rx_rptr, count, mask;
+	struct sipa_common_fifo_cfg_tag *fifo_cfg;
+
+	if (unlikely(id < 0 || id >= SIPA_FIFO_MAX))
+		return -EINVAL;
+
+	fifo_cfg = cfg_base + id;
+	if (!fifo_cfg->is_pam) {
+		pr_err("sipa reclaim fifo id is err\n");
+		return -EINVAL;
+	}
+	if (!fifo_cfg->tx_fifo.virtual_addr ||
+	    !fifo_cfg->rx_fifo.virtual_addr ||
+	    !is_power_of_2(fifo_cfg->rx_fifo.depth) ||
+	    fifo_cfg->rx_fifo.depth != fifo_cfg->tx_fifo.depth)
+		return -EINVAL;
+	/* The caller has quiesced the peer and paused SIPA. The stop bit alone
+	 * would not establish that all external DMA has completed.
+	 */
+	if (!(readl(fifo_cfg->fifo_reg_base + IPA_FLOW_CTRL_CONFIG) & BIT(3)))
+		return -EBUSY;
+	if (ipa_phy_get_rx_fifo_axi_sts(fifo_cfg->fifo_reg_base))
+		return -EBUSY;
+	rx_rptr = ipa_phy_get_rx_fifo_rptr(fifo_cfg->fifo_reg_base);
+	rx_wptr = ipa_phy_get_rx_fifo_wptr(fifo_cfg->fifo_reg_base);
+	tx_rptr = ipa_phy_get_tx_fifo_rptr(fifo_cfg->fifo_reg_base);
+	tx_wptr = ipa_phy_get_tx_fifo_wptr(fifo_cfg->fifo_reg_base);
+
+	mask = PTR_MASK(fifo_cfg->rx_fifo.depth);
+	if ((tx_rptr | tx_wptr | rx_rptr | rx_wptr) & ~mask)
+		return -EIO;
+	count = (tx_wptr - rx_wptr) & mask;
+	if (count > fifo_cfg->rx_fifo.depth ||
+	    ((rx_wptr - rx_rptr) & mask) + count > fifo_cfg->rx_fifo.depth ||
+	    ((tx_wptr - tx_rptr) & mask) > count)
+		return -EIO;
+	dma_rmb();
+
+	if (tx_wptr != tx_rptr)
+		ret = ipa_reclaim_tx_fifo_unread_node_desc(
+			fifo_cfg, tx_rptr, tx_wptr, rx_rptr, rx_wptr);
+	else if (tx_wptr != rx_wptr)
+		ret = ipa_reclaim_unfree_node_desc(fifo_cfg, tx_rptr, tx_wptr,
+						   rx_rptr, rx_wptr);
+
+	return ret;
+}
+
+static int ipa_set_tx_fifo_rptr(enum sipa_cmn_fifo_index id,
+				struct sipa_common_fifo_cfg_tag *cfg_base,
+				u32 tx_rd)
+{
+	int ret;
+	struct sipa_common_fifo_cfg_tag *fifo_cfg;
+
+	if (unlikely(id >= SIPA_FIFO_MAX))
+		return -EINVAL;
+
+	fifo_cfg = cfg_base + id;
+	/* Complete descriptor loads before returning ownership to hardware. */
+	dma_mb();
+	fifo_cfg->tx_fifo.rd = (fifo_cfg->tx_fifo.rd + tx_rd) &
+			       PTR_MASK(fifo_cfg->tx_fifo.depth);
+	ret = ipa_phy_update_tx_fifo_rptr(fifo_cfg->fifo_reg_base,
+					  fifo_cfg->tx_fifo.rd);
+
+	if (!ret) {
+		pr_err("update tx fifo rptr fail !!!\n");
+		return -EINVAL;
+	}
+
+	return 0;
+}
