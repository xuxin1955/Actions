+#define SIPA_CP_SRC                                                            \
+	((1 << SIPA_TERM_VAP0) | (1 << SIPA_TERM_VAP1) |                       \
+	 (1 << SIPA_TERM_VAP2) | (1 << SIPA_TERM_CP0) | (1 << SIPA_TERM_CP1) | \
+	 (1 << SIPA_TERM_VCP))
