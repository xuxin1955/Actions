+static int smsg_ch_wake_unlock_legacy(u8 dst, u8 channel)
+{
+	struct smsg_ipc *ipc = dst < SIPC_ID_NR ? smsg_ipcs[dst] : NULL;
+	struct smsg_channel *ch;
+	u8 ch_index;
+
+	ch_index = channel2index[channel];
+	if (ch_index == INVALID_CHANEL_INDEX) {
+		pr_err("%s:channel %d invalid!\n", __func__, channel);
+		return -EINVAL;
+	}
+
+	if (!ipc)
+		return -ENODEV;
+
+	ch = ipc->channels[ch_index];
+	if (!ch)
+		return -ENODEV;
+
+	__pm_relax(ch->sipc_wake_lock);
+	return 0;
+}
+int smsg_ch_wake_unlock(u8 dst, u8 channel)
+{
+	int ret;
+
+	ret = smsg_uart_legacy_enter(dst, channel, SMSG_UART_LEGACY_IO);
+	if (ret)
+		return ret;
+	ret = smsg_ch_wake_unlock_legacy(dst, channel);
+	return smsg_uart_legacy_exit(dst, channel, SMSG_UART_LEGACY_IO, ret);
+}
+EXPORT_SYMBOL_GPL(smsg_ch_wake_unlock);
+
+static int smsg_ch_open_legacy(u8 dst, u8 channel, int timeout)
+{
+	struct smsg_ipc *ipc = dst < SIPC_ID_NR ? smsg_ipcs[dst] : NULL;
+	struct smsg_channel *ch;
+	struct smsg mopen;
+	struct smsg mrecv;
+	int rval = 0;
+	u8 ch_index;
+
+	ch_index = channel2index[channel];
+	if (ch_index == INVALID_CHANEL_INDEX) {
+		pr_err("%s:channel %d invalid!\n", __func__, channel);
+		return -EINVAL;
+	}
+
+	if (!ipc)
+		return -ENODEV;
+
+	ch = kzalloc_obj(*ch, GFP_KERNEL);
+	if (!ch)
+		return -ENOMEM;
+
+	sprintf(ch->wake_lock_name, "smsg-%d-%d", dst, channel);
+	ch->sipc_wake_lock =
+		wakeup_source_register(ipc->dev, ch->wake_lock_name);
+	if (IS_ENABLED(CONFIG_PM_SLEEP) && !ch->sipc_wake_lock) {
+		kfree(ch);
+		return -ENOMEM;
+	}
+
+	atomic_set(&ipc->busy[ch_index], 1);
+	init_waitqueue_head(&ch->rxwait);
+	mutex_init(&ch->rxlock);
+	ipc->channels[ch_index] = ch;
+
+	pr_info("%s: channel %d-%d send open msg!\n", __func__, dst, channel);
+
+	smsg_set(&mopen, channel, SMSG_TYPE_OPEN, SMSG_OPEN_MAGIC, 0);
+	rval = smsg_send(dst, &mopen, timeout);
+	if (rval != 0) {
+		pr_err("%s: channel %d-%d send open msg error = %d!\n",
+		       __func__, dst, channel, rval);
+		ipc->states[ch_index] = CHAN_STATE_UNUSED;
+		ipc->channels[ch_index] = NULL;
+		atomic_dec(&ipc->busy[ch_index]);
+		/* guarantee that channel resource isn't used in irq handler  */
+		while (atomic_read(&ipc->busy[ch_index]))
+			;
+
+		wakeup_source_unregister(ch->sipc_wake_lock);
+		kfree(ch);
+
+		return rval;
+	}
+
+	/* open msg might be got before */
+	if (ipc->states[ch_index] == CHAN_STATE_CLIENT_OPENED)
+		goto open_done;
+
+	ipc->states[ch_index] = CHAN_STATE_HOST_OPENED;
+
+	do {
+		smsg_set(&mrecv, channel, 0, 0, 0);
+		rval = smsg_recv(dst, &mrecv, timeout);
+		if (rval != 0) {
+			pr_err("%s: channel %d-%d smsg receive error = %d!\n",
+			       __func__, dst, channel, rval);
+			ipc->states[ch_index] = CHAN_STATE_UNUSED;
+			ipc->channels[ch_index] = NULL;
+			atomic_dec(&ipc->busy[ch_index]);
+			/* guarantee that channel resource isn't used
+			 * in irq handler
+			 */
+			while (atomic_read(&ipc->busy[ch_index]))
+				;
+
+			wakeup_source_unregister(ch->sipc_wake_lock);
+			kfree(ch);
+			return rval;
+		}
+	} while (mrecv.type != SMSG_TYPE_OPEN || mrecv.flag != SMSG_OPEN_MAGIC);
+
+	pr_info("%s: channel %d-%d receive open msg!\n", __func__, dst,
+		channel);
+
+open_done:
+	pr_info("%s: channel %d-%d success\n", __func__, dst, channel);
+	ipc->states[ch_index] = CHAN_STATE_OPENED;
+	atomic_dec(&ipc->busy[ch_index]);
+
+	return 0;
+}
+int smsg_ch_open(u8 dst, u8 channel, int timeout)
+{
+	int ret;
+
+	ret = smsg_uart_legacy_enter(dst, channel, SMSG_UART_LEGACY_OPEN);
+	if (ret)
+		return ret;
+	ret = smsg_ch_open_legacy(dst, channel, timeout);
+	return smsg_uart_legacy_exit(dst, channel, SMSG_UART_LEGACY_OPEN, ret);
+}
+EXPORT_SYMBOL_GPL(smsg_ch_open);
+
+static int smsg_ch_close_legacy(u8 dst, u8 channel, int timeout)
+{
+	struct smsg_ipc *ipc = dst < SIPC_ID_NR ? smsg_ipcs[dst] : NULL;
+	struct smsg_channel *ch;
+	struct smsg mclose;
+	u8 ch_index;
+
+	ch_index = channel2index[channel];
+	if (ch_index == INVALID_CHANEL_INDEX) {
+		pr_err("%s:channel %d invalid!\n", __func__, channel);
+		return -EINVAL;
+	}
+
+	if (!ipc)
+		return -ENODEV;
+	ch = ipc->channels[ch_index];
+	if (!ch)
+		return 0;
+
+	smsg_set(&mclose, channel, SMSG_TYPE_CLOSE, SMSG_CLOSE_MAGIC, 0);
+	smsg_send(dst, &mclose, timeout);
+
+	ipc->states[ch_index] = CHAN_STATE_FREE;
+	wake_up_interruptible_all(&ch->rxwait);
+
+	/* wait for the channel being unused */
+	while (atomic_read(&ipc->busy[ch_index]))
+		;
+
+	/* maybe channel has been free for smsg_ch_open failed */
+	if (ipc->channels[ch_index]) {
+		ipc->channels[ch_index] = NULL;
+		/* guarantee that channel resource isn't used in irq handler */
+		while (atomic_read(&ipc->busy[ch_index]))
+			;
+
+		wakeup_source_unregister(ch->sipc_wake_lock);
+		kfree(ch);
+	}
+
+	/* finally, update the channel state*/
+	ipc->states[ch_index] = CHAN_STATE_UNUSED;
+
+	return 0;
+}
+int smsg_ch_close(u8 dst, u8 channel, int timeout)
+{
+	int ret;
+
+	ret = smsg_uart_legacy_enter(dst, channel, SMSG_UART_LEGACY_CLOSE);
+	if (ret)
+		return ret;
+	ret = smsg_ch_close_legacy(dst, channel, timeout);
+	return smsg_uart_legacy_exit(dst, channel, SMSG_UART_LEGACY_CLOSE, ret);
+}
+EXPORT_SYMBOL_GPL(smsg_ch_close);
+
+int smsg_senddie(u8 dst)
+{
+	struct smsg msg;
+	struct smsg_ipc *ipc = dst < SIPC_ID_NR ? smsg_ipcs[dst] : NULL;
+	uintptr_t txpos;
+	int rval = 0;
+
+	if (!ipc)
+		return -ENODEV;
+
+#ifdef CONFIG_SPRD_SIPC_MBOX_CLIENT
+	/* Panic/crash injection needs a reviewed poll/flush path. */
+	return -EOPNOTSUPP;
+#endif
+	msg.channel = SMSG_CH_CTRL;
+	msg.type = SMSG_TYPE_DIE;
+	msg.flag = 0;
+	msg.value = 0;
+
+#if defined(CONFIG_SPRD_MAILBOX) && !defined(CONFIG_SPRD_SIPC_MBOX_CLIENT)
+	if (ipc->type == SIPC_BASE_MBOX) {
+		mbox_just_sent(ipc->core_id, *((u64 *)&msg));
+		return 0;
+	}
+#endif
+
+	if (ipc->ring_base) {
+		if ((int)(SIPC_READL(ipc->txbuf_wrptr) -
+			  SIPC_READL(ipc->txbuf_rdptr)) >= ipc->txbuf_size) {
+			pr_info("smsg_send: smsg txbuf is full!\n");
+			rval = -EBUSY;
+			goto send_failed;
+		}
+
+		/* calc txpos and write smsg */
+		txpos = (SIPC_READL(ipc->txbuf_wrptr) & (ipc->txbuf_size - 1)) *
+				sizeof(struct smsg) +
+			ipc->txbuf_addr;
+		memcpy((void *)txpos, &msg, sizeof(struct smsg));
+
+		pr_debug("write smsg: wrptr=%u, rdptr=%u, txpos=0x%lx\n",
+			 SIPC_READL(ipc->txbuf_wrptr),
+			 SIPC_READL(ipc->txbuf_rdptr), txpos);
+
+		/* update wrptr */
+		SIPC_WRITEL(SIPC_READL(ipc->txbuf_wrptr) + 1, ipc->txbuf_wrptr);
+	}
+
+	rval = ipc->txirq_trigger(ipc->dst, *((u64 *)&msg));
+send_failed:
+
+	return rval;
+}
+EXPORT_SYMBOL_GPL(smsg_senddie);
+
+static int smsg_send_legacy(u8 dst, struct smsg *msg, int timeout)
+{
+	struct smsg_ipc *ipc = dst < SIPC_ID_NR ? smsg_ipcs[dst] : NULL;
+	uintptr_t txpos;
+	int rval = 0;
+	unsigned long flags;
+	u8 ch_index;
+
+	if (!msg || msg->channel >= SMSG_CH_NR || msg->type >= SMSG_TYPE_NR)
+		return -EINVAL;
+	ch_index = channel2index[msg->channel];
+	if (ch_index == INVALID_CHANEL_INDEX) {
+		pr_err("%s:channel %d invalid!\n", __func__, msg->channel);
+		return -EINVAL;
+	}
+
+	if (!ipc)
+		return -ENODEV;
+
+	if (!ipc->channels[ch_index]) {
+		pr_err("%s: channel %d not inited!\n", __func__, msg->channel);
+		return -ENODEV;
+	}
+
+	if (ipc->states[ch_index] != CHAN_STATE_OPENED &&
+	    msg->type != SMSG_TYPE_OPEN && msg->type != SMSG_TYPE_CLOSE) {
+		pr_err("%s: channel %d not opened!\n", __func__, msg->channel);
+		return -EINVAL;
+	}
+
+	pr_debug("%s: dst=%d, channel=%d, timeout=%d, suspend=%d\n", __func__,
+		 dst, msg->channel, timeout, ipc->suspend);
+
+	if (ipc->suspend) {
+		if (!timeout)
+			return -EAGAIN;
+		if (timeout < 0) {
+			rval = wait_event_interruptible(
+				ipc->suspend_wait, !READ_ONCE(ipc->suspend));
+		} else {
+			rval = wait_event_interruptible_timeout(
+				ipc->suspend_wait, !READ_ONCE(ipc->suspend),
+				timeout);
+			if (!rval)
+				return -ETIME;
+			if (rval > 0)
+				timeout = rval;
+		}
+		if (rval < 0)
+			return rval;
+	}
+	pr_debug("send smsg: channel=%d, type=%d, flag=0x%04x, value=0x%08x\n",
+		 msg->channel, msg->type, msg->flag, msg->value);
+
+#ifdef CONFIG_SPRD_SIPC_MBOX_CLIENT
+	if (!ipc->ring_base) {
+		struct udx710_smsg message = {
+			.channel = msg->channel,
+			.type = msg->type,
+			.flag = msg->flag,
+			.value = msg->value,
+		};
+
+		/* Local mailbox payload has no shared SMSG ring to serialize. */
+		return udx710_smsg_link_send_timeout(ipc->mbox_link, &message,
+						     timeout);
+	}
+#endif
+	spin_lock_irqsave(&ipc->txpinlock, flags);
+
+	if (ipc->ring_base) {
+		if (((int)(SIPC_READL(ipc->txbuf_wrptr) -
+			   SIPC_READL(ipc->txbuf_rdptr)) >= ipc->txbuf_size)) {
+			pr_info("%s: smsg txbuf is full!\n", __func__);
+			rval = -EBUSY;
+			goto send_failed;
+		}
+
+		/* calc txpos and write smsg */
+		txpos = (SIPC_READL(ipc->txbuf_wrptr) & (ipc->txbuf_size - 1)) *
+				sizeof(struct smsg) +
+			ipc->txbuf_addr;
+		memcpy((void *)txpos, msg, sizeof(struct smsg));
+
+		pr_debug("write smsg: wrptr=0x%x, rdptr=0x%x, txpos=0x%lx\n",
+			 SIPC_READL(ipc->txbuf_wrptr),
+			 SIPC_READL(ipc->txbuf_rdptr), txpos);
+
+		/* update wrptr */
+		SIPC_WRITEL(SIPC_READL(ipc->txbuf_wrptr) + 1, ipc->txbuf_wrptr);
+	}
+
+	rval = ipc->txirq_trigger(ipc->dst, *(u64 *)msg);
+
+send_failed:
+	spin_unlock_irqrestore(&ipc->txpinlock, flags);
+
+	return rval;
+}
+int smsg_send(u8 dst, struct smsg *msg, int timeout)
+{
+	int ret;
+
+	if (!msg)
+		return -EINVAL;
+	ret = smsg_uart_legacy_enter(dst, msg->channel, SMSG_UART_LEGACY_IO);
+	if (ret)
+		return ret;
+	ret = smsg_send_legacy(dst, msg, timeout);
+	return smsg_uart_legacy_exit(dst, msg->channel, SMSG_UART_LEGACY_IO,
+				     ret);
+}
+EXPORT_SYMBOL_GPL(smsg_send);
+
+static int smsg_recv_legacy(u8 dst, struct smsg *msg, int timeout)
+{
+	struct smsg_ipc *ipc = dst < SIPC_ID_NR ? smsg_ipcs[dst] : NULL;
+	struct smsg_channel *ch;
+	u32 rd;
+	int rval = 0;
+	u8 ch_index;
+
+	if (!msg || msg->channel >= SMSG_CH_NR)
+		return -EINVAL;
+	ch_index = channel2index[msg->channel];
+	if (ch_index == INVALID_CHANEL_INDEX) {
+		pr_err("%s:channel %d invalid!\n", __func__, msg->channel);
+		return -EINVAL;
+	}
+
+	if (!ipc)
+		return -ENODEV;
+
+	atomic_inc(&ipc->busy[ch_index]);
+
+	ch = ipc->channels[ch_index];
+
+	if (!ch) {
+		pr_err("%s: channel %d not opened!\n", __func__, msg->channel);
+		atomic_dec(&ipc->busy[ch_index]);
+		return -ENODEV;
+	}
+
+	pr_debug("%s: dst=%d, channel=%d, timeout=%d, ch_index = %d\n",
+		 __func__, dst, msg->channel, timeout, ch_index);
+
+	if (timeout == 0) {
+		if (!mutex_trylock(&ch->rxlock)) {
+			pr_err("dst=%d, channel=%d recv smsg busy!\n", dst,
+			       msg->channel);
+			atomic_dec(&ipc->busy[ch_index]);
+
+			return -EBUSY;
+		}
+
+		/* no wait */
+		if (SIPC_READL(ch->wrptr) == SIPC_READL(ch->rdptr)) {
+			pr_info("dst=%d, channel=%d smsg rx cache is empty!\n",
+				dst, msg->channel);
+
+			rval = -ENODATA;
+
+			goto recv_failed;
+		}
+	} else if (timeout < 0) {
+		mutex_lock(&ch->rxlock);
+		/* wait forever */
+		rval = wait_event_interruptible(
+			ch->rxwait,
+			(SIPC_READL(ch->wrptr) != SIPC_READL(ch->rdptr)) ||
+				(ipc->states[ch_index] == CHAN_STATE_FREE));
+		if (rval < 0) {
+			pr_debug("%s: dst=%d, channel=%d wait interrupted!\n",
+				 __func__, dst, msg->channel);
+
+			goto recv_failed;
+		}
+
+		if (ipc->states[ch_index] == CHAN_STATE_FREE) {
+			pr_info("%s: dst=%d, channel=%d channel is free!\n",
+				__func__, dst, msg->channel);
+
+			rval = -EIO;
+
+			goto recv_failed;
+		}
+	} else {
+		mutex_lock(&ch->rxlock);
+		/* wait timeout */
+		rval = wait_event_interruptible_timeout(
+			ch->rxwait,
+			(SIPC_READL(ch->wrptr) != SIPC_READL(ch->rdptr)) ||
+				(ipc->states[ch_index] == CHAN_STATE_FREE),
+			timeout);
+		if (rval < 0) {
+			pr_debug("%s: dst=%d, channel=%d wait interrupted!\n",
+				 __func__, dst, msg->channel);
+
+			goto recv_failed;
+		} else if (rval == 0) {
+			pr_debug("%s: dst=%d, channel=%d wait timeout!\n",
+				 __func__, dst, msg->channel);
+
+			rval = -ETIME;
+
+			goto recv_failed;
+		}
+
+		if (ipc->states[ch_index] == CHAN_STATE_FREE) {
+			pr_info("%s: dst=%d, channel=%d channel is free!\n",
+				__func__, dst, msg->channel);
+
+			rval = -EIO;
+
+			goto recv_failed;
+		}
+	}
+
+	/* A completed receive returns zero; timeout wait returns remaining ticks. */
+	rval = 0;
+	/* read smsg from cache */
+	rd = SIPC_READL(ch->rdptr) & (SMSG_CACHE_NR - 1);
+	memcpy(msg, &ch->caches[rd], sizeof(struct smsg));
+	SIPC_WRITEL(SIPC_READL(ch->rdptr) + 1, ch->rdptr);
+
+	if (ipc->ring_base)
+		pr_debug(
+			"read smsg: dst=%d, channel=%d, wrptr=%d, rdptr=%d, rd=%d\n",
+			dst, msg->channel, SIPC_READL(ch->wrptr),
+			SIPC_READL(ch->rdptr), rd);
+
+	pr_debug(
+		"recv smsg: dst=%d, channel=%d, type=%d, flag=0x%04x, value=0x%08x, rval = %d\n",
+		dst, msg->channel, msg->type, msg->flag, msg->value, rval);
+
+recv_failed:
+	mutex_unlock(&ch->rxlock);
+	atomic_dec(&ipc->busy[ch_index]);
+	return rval;
+}
+int smsg_recv(u8 dst, struct smsg *msg, int timeout)
+{
+	int ret;
+
+	if (!msg)
+		return -EINVAL;
+	ret = smsg_uart_legacy_enter(dst, msg->channel, SMSG_UART_LEGACY_IO);
+	if (ret)
+		return ret;
+	ret = smsg_recv_legacy(dst, msg, timeout);
+	return smsg_uart_legacy_exit(dst, msg->channel, SMSG_UART_LEGACY_IO,
+				     ret);
+}
+EXPORT_SYMBOL_GPL(smsg_recv);
+
+u8 sipc_channel2index(u8 channel)
+{
+	return channel2index[channel];
+}
+EXPORT_SYMBOL_GPL(sipc_channel2index);
+
+#if defined(CONFIG_DEBUG_FS)
+static int smsg_debug_show(struct seq_file *m, void *private)
+{
+	struct smsg_ipc *ipc = NULL;
+	struct smsg_channel *ch;
+
+	int i, j, cnt, ch_index;
+
+	for (i = 0; i < SIPC_ID_NR; i++) {
+		ipc = smsg_ipcs[i];
+		if (!ipc)
+			continue;
+
+		sipc_debug_putline(m, '*', 120);
+		seq_printf(m, "sipc: %s:\n", ipc->name);
+		seq_printf(m, "dst: 0x%0x, irq: 0x%0x\n", ipc->dst, ipc->irq);
+		if (ipc->ring_base) {
+			seq_printf(
+				m,
+				"txbufAddr: 0x%p, txbufsize: 0x%x, txbufrdptr: [0x%p]=%d, txbufwrptr: [0x%p]=%d\n",
+				(void *)ipc->txbuf_addr, ipc->txbuf_size,
+				(void *)ipc->txbuf_rdptr,
+				SIPC_READL(ipc->txbuf_rdptr),
+				(void *)ipc->txbuf_wrptr,
+				SIPC_READL(ipc->txbuf_wrptr));
+			seq_printf(
+				m,
+				"rxbufAddr: 0x%p, rxbufsize: 0x%x, rxbufrdptr: [0x%p]=%d, rxbufwrptr: [0x%p]=%d\n",
+				(void *)ipc->rxbuf_addr, ipc->rxbuf_size,
+				(void *)ipc->rxbuf_rdptr,
+				SIPC_READL(ipc->rxbuf_rdptr),
+				(void *)ipc->rxbuf_wrptr,
+				SIPC_READL(ipc->rxbuf_wrptr));
+		}
+		sipc_debug_putline(m, '-', 80);
+		seq_puts(m, "1. all channel state list:\n");
+
+		for (j = 0; j < SMSG_VALID_CH_NR; j++)
+			seq_printf(m,
+				   "%2d. channel[%3d] states: %d, name: %s\n",
+				   j, sipc_cfg[j].channel, ipc->states[j],
+				   sipc_cfg[j].name);
+
+		sipc_debug_putline(m, '-', 80);
+		seq_puts(m, "2. channel rdpt < wrpt list:\n");
+
+		cnt = 1;
+		for (j = 0; j < SMSG_VALID_CH_NR; j++) {
+			ch_index = channel2index[i];
+			ch = ipc->channels[ch_index];
+			if (!ch)
+				continue;
+
+			if (SIPC_READL(ch->rdptr) < SIPC_READL(ch->wrptr))
+				seq_printf(
+					m,
+					"%2d. channel[%3d] rd: %d, wt: %d, name: %s\n",
+					cnt++, sipc_cfg[j].channel,
+					SIPC_READL(ch->rdptr),
+					SIPC_READL(ch->wrptr),
+					sipc_cfg[j].name);
+		}
+	}
+	return 0;
+}
+
+static int smsg_debug_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, smsg_debug_show, inode->i_private);
+}
+
+static const struct file_operations smsg_debug_fops = {
+	.open = smsg_debug_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+int smsg_init_debugfs(void *root)
+{
+	if (!root)
+		return -ENXIO;
+	debugfs_create_file("smsg", 0444, (struct dentry *)root, NULL,
+			    &smsg_debug_fops);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(smsg_init_debugfs);
+
+#endif /* CONFIG_DEBUG_FS */
+
+MODULE_AUTHOR("Chen Gaopeng");
+MODULE_DESCRIPTION("SIPC/SMSG driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/sprd/modem/sipc_v2/smsg_uart.h b/drivers/soc/sprd/modem/sipc_v2/smsg_uart.h
new file mode 100644
index 000000000..a8d5066c9
--- /dev/null
+++ b/drivers/soc/sprd/modem/sipc_v2/smsg_uart.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SPRD_SMSG_UART_H
+#define _SPRD_SMSG_UART_H
+
+#include <linux/types.h>
+
+struct smsg;
+struct smsg_uart_channel;
+
+/* Fixed PM_SYS/COMM (6/1), local host mailbox only. Caller must serialize
+ * endpoint lookup/binding/removal and keep IPC/link alive through release.
+ * This interface does not acquire a device/driver lifetime reference.
+ *
+ * One successful reservation consumes this tuple for this kernel boot.
+ * Cancel and release permanently quarantine it; neither sends CLOSE nor
+ * establishes remote quiescence. No reset/reopen/reclaim interface exists.
+ * Initialize caller state before reserve/start. All external users must be
+ * joined before the caller frees their own state or releases the endpoint.
+ *
+ * The private slot/cache are boot-lifetime. IRQ ingress, admission, cancellation
+ * and cache access share one short spinlock. No channel pointer escapes IRQ
+ * while unreferenced. try_send holds that lock through the verified atomic-safe
+ * mailbox enqueue; zero means queued, not delivered or processed remotely.
+ */
+int smsg_uart_reserve(struct smsg_uart_channel **out);
+int smsg_uart_try_send(struct smsg_uart_channel *channel,
+		       const struct smsg *msg);
+int smsg_uart_try_recv(struct smsg_uart_channel *channel, struct smsg *msg);
+
+/* Process context; absolute jiffies deadline, at most MAX_JIFFY_OFFSET ahead.
+ * recv_until returns 0 with a message, or a negative error. wait_retry sleeps
+ * at most interval ticks and returns 0 to retry, or a negative error. Each call
+ * checks the same caller-owned absolute deadline; messages never renew it.
+ */
+int smsg_uart_recv_until(struct smsg_uart_channel *channel, struct smsg *msg,
+			 unsigned long deadline);
+int smsg_uart_wait_retry(struct smsg_uart_channel *channel,
+			 unsigned long deadline, unsigned long interval);
+void smsg_uart_cancel(struct smsg_uart_channel *channel);
+int smsg_uart_release(struct smsg_uart_channel *channel);
+
+/* Conservative history, also valid after cancel/release. False only means
+ * this handle never called the transport; it is NOT a remote-silence proof.
+ */
+bool smsg_uart_may_have_sent(struct smsg_uart_channel *channel);
+
+/* Legacy SBUF creation must acquire BEFORE lookup/allocation/publication and
+ * retain this claim until its manager has been fully destroyed. Every failure
+ * after a successful acquire must release. Other tuples are no-ops. Internal
+ * managed-UART creation must not call these legacy admission helpers.
+ */
+int smsg_uart_legacy_sbuf_acquire(u8 dst, u8 channel);
+void smsg_uart_legacy_sbuf_release(u8 dst, u8 channel);
+
+#endif
diff --git a/drivers/soc/sprd/modem/sipc_v2/spipe.c b/drivers/soc/sprd/modem/sipc_v2/spipe.c
new file mode 100644
index 000000000..bb4c7cddb
--- /dev/null
+++ b/drivers/soc/sprd/modem/sipc_v2/spipe.c
@@ -0,0 +1,359 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2018 Spreadtrum Communications Inc.
+ *
+ * This software is licensed under the terms of the GNU General Public
+ * License version 2, as published by the Free Software Foundation, and
+ * may be copied, distributed, and modified under those terms.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ */
+
+#include <linux/cdev.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/of.h>
+#include <linux/poll.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/sipc.h>
+
+#include "sipc_priv.h"
+#include "spipe.h"
+
+struct spipe_device {
+	struct spipe_init_data *init;
+	int major;
+	int minor;
+	struct cdev cdev;
+};
+
+struct spipe_sbuf {
+	u8 dst;
+	u8 channel;
+	u32 bufid;
+};
+
+static struct class *spipe_class;
+
+static ssize_t session_show(struct device *dev, struct device_attribute *attr,
+			    char *buf)
+{
+	struct spipe_device *spipe = dev_get_drvdata(dev);
+	u32 generation, state;
+	int ret;
+
+	ret = sbuf_get_session(spipe->init->dst, spipe->init->channel,
+			       &generation, &state);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "1 %u %u %u %u\n", spipe->init->dst,
+			  spipe->init->channel, generation, state);
+}
+static DEVICE_ATTR_RO(session);
+
+static struct attribute *spipe_session_attrs[] = {
+	&dev_attr_session.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(spipe_session);
+
+static int spipe_open(struct inode *inode, struct file *filp)
+{
+	int minor = iminor(filp->f_path.dentry->d_inode);
+	struct spipe_device *spipe;
+	struct spipe_sbuf *sbuf;
+	int ret;
+
+	spipe = container_of(inode->i_cdev, struct spipe_device, cdev);
+	ret = sbuf_status(spipe->init->dst, spipe->init->channel);
+	if (ret)
+		return ret;
+
+	sbuf = kmalloc_obj(struct spipe_sbuf, GFP_KERNEL);
+	if (!sbuf)
+		return -ENOMEM;
+	filp->private_data = sbuf;
+
+	sbuf->dst = spipe->init->dst;
+	sbuf->channel = spipe->init->channel;
+	sbuf->bufid = minor - spipe->minor;
+
+	return stream_open(inode, filp);
+}
+
+static int spipe_release(struct inode *inode, struct file *filp)
+{
+	struct spipe_sbuf *sbuf = filp->private_data;
+
+	kfree(sbuf);
+
+	return 0;
+}
+
+static ssize_t spipe_read(struct file *filp, char __user *buf, size_t count,
+			  loff_t *ppos)
+{
+	struct spipe_sbuf *sbuf = filp->private_data;
+	int ret, timeout = -1;
+
+	if (filp->f_flags & O_NONBLOCK)
+		timeout = 0;
+
+	ret = sbuf_read_user(sbuf->dst, sbuf->channel, sbuf->bufid, buf,
+			     min_t(size_t, count, MAX_RW_COUNT), timeout);
+	if (!timeout && (ret == -ENODATA || ret == -EBUSY))
+		return -EAGAIN;
+	return ret;
+}
+
+static ssize_t spipe_write(struct file *filp, const char __user *buf,
+			   size_t count, loff_t *ppos)
+{
+	struct spipe_sbuf *sbuf = filp->private_data;
+	int ret, timeout = -1;
+
+	if (filp->f_flags & O_NONBLOCK)
+		timeout = 0;
+
+	ret = sbuf_write_user(sbuf->dst, sbuf->channel, sbuf->bufid, buf,
+			      min_t(size_t, count, MAX_RW_COUNT), timeout);
+	if (!timeout && (ret == -ENODATA || ret == -EBUSY))
+		return -EAGAIN;
+	return ret;
+}
+
+static __poll_t spipe_poll(struct file *filp, poll_table *wait)
+{
+	struct spipe_sbuf *sbuf = filp->private_data;
+
+	return sbuf_poll_wait(sbuf->dst, sbuf->channel, sbuf->bufid, filp,
+			      wait);
+}
+
+static long spipe_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+	return -ENOTTY;
+}
+
+static const struct file_operations spipe_fops = {
+	.open = spipe_open,
+	.release = spipe_release,
+	.read = spipe_read,
+	.write = spipe_write,
+	.poll = spipe_poll,
+	.unlocked_ioctl = spipe_ioctl,
+	.owner = THIS_MODULE,
+};
+
+static int spipe_parse_dt(struct spipe_init_data **init, struct device_node *np,
+			  struct device *dev)
+{
+	struct spipe_init_data *pdata = NULL;
+	int ret;
+	u32 data;
+
+	pdata = devm_kzalloc(dev, sizeof(struct spipe_init_data), GFP_KERNEL);
+	if (!pdata)
+		return -ENOMEM;
+
+	ret = of_property_read_string(np, "sprd,name",
+				      (const char **)&pdata->name);
+	if (ret)
+		goto error;
+
+	ret = of_property_read_u32(np, "sprd,dst", (u32 *)&data);
+	if (ret)
+		goto error;
+	if (data >= SIPC_ID_NR) {
+		ret = -EINVAL;
+		goto error;
+	}
+	pdata->dst = (u8)data;
+
+	ret = of_property_read_u32(np, "sprd,channel", (u32 *)&data);
+	if (ret)
+		goto error;
+	if (data >= SMSG_CH_NR ||
+	    sipc_channel2index(data) == INVALID_CHANEL_INDEX) {
+		ret = -EINVAL;
+		goto error;
+	}
+	pdata->channel = (u8)data;
+
+	ret = of_property_read_u32(np, "sprd,ringnr", (u32 *)&pdata->ringnr);
+	if (ret)
+		goto error;
+
+	ret = of_property_read_u32(np, "sprd,size-rxbuf",
+				   (u32 *)&pdata->rxbuf_size);
+	if (ret)
+		goto error;
+
+	ret = of_property_read_u32(np, "sprd,size-txbuf",
+				   (u32 *)&pdata->txbuf_size);
+	if (ret)
+		goto error;
+
+	*init = pdata;
+	return ret;
+error:
+	devm_kfree(dev, pdata);
+	*init = NULL;
+	return ret;
+}
+
+static inline void spipe_destroy_pdata(struct spipe_init_data **init,
+				       struct device *dev)
+{
+	struct spipe_init_data *pdata = *init;
+
+	devm_kfree(dev, pdata);
+
+	*init = NULL;
+}
+
+static int spipe_probe(struct platform_device *pdev)
+{
+	struct spipe_init_data *init;
+	struct spipe_device *spipe;
+	struct device *dev;
+	dev_t devid;
+	int i, ret;
+
+	if (!pdev->dev.of_node)
+		return -ENODEV;
+	ret = spipe_parse_dt(&init, pdev->dev.of_node, &pdev->dev);
+	if (ret)
+		return ret;
+	if (!init->ringnr || init->ringnr > MINORMASK + 1U) {
+		ret = -EINVAL;
+		goto free_pdata;
+	}
+
+	spipe = devm_kzalloc(&pdev->dev, sizeof(*spipe), GFP_KERNEL);
+	if (!spipe) {
+		ret = -ENOMEM;
+		goto free_pdata;
+	}
+	spipe->init = init;
+	ret = sbuf_create(init->dst, init->channel, init->ringnr,
+			  init->txbuf_size, init->rxbuf_size);
+	if (ret)
+		goto free_pdata;
+	ret = alloc_chrdev_region(&devid, 0, init->ringnr, init->name);
+	if (ret)
+		goto destroy_sbuf;
+	spipe->major = MAJOR(devid);
+	spipe->minor = MINOR(devid);
+
+	for (i = 0; i < init->ringnr; i++) {
+		if (init->ringnr > 1)
+			dev = device_create_with_groups(spipe_class, &pdev->dev,
+							devid + i, spipe,
+							spipe_session_groups,
+							"%s%d", init->name, i);
+		else
+			dev = device_create_with_groups(spipe_class, &pdev->dev,
+							devid, spipe,
+							spipe_session_groups,
+							"%s", init->name);
+		if (IS_ERR(dev)) {
+			ret = PTR_ERR(dev);
+			goto destroy_devices;
+		}
+	}
+
+	/* Initialize all open-time data before the cdev becomes visible. */
+	cdev_init(&spipe->cdev, &spipe_fops);
+	spipe->cdev.owner = THIS_MODULE;
+	ret = cdev_add(&spipe->cdev, devid, init->ringnr);
+	if (ret)
+		goto destroy_devices;
+	platform_set_drvdata(pdev, spipe);
+	return 0;
+
+destroy_devices:
+	while (i--)
+		device_destroy(spipe_class, devid + i);
+	unregister_chrdev_region(devid, init->ringnr);
+destroy_sbuf:
+	sbuf_destroy(init->dst, init->channel);
+free_pdata:
+	spipe_destroy_pdata(&init, &pdev->dev);
+	return ret;
+}
+
+static void spipe_remove(struct platform_device *pdev)
+{
+	struct spipe_device *spipe = platform_get_drvdata(pdev);
+	int i;
+
+	if (spipe) {
+		for (i = 0; i < spipe->init->ringnr; i++) {
+			device_destroy(spipe_class,
+				       MKDEV(spipe->major, spipe->minor + i));
+		}
+		cdev_del(&(spipe->cdev));
+		unregister_chrdev_region(MKDEV(spipe->major, spipe->minor),
+					 spipe->init->ringnr);
+
+		sbuf_destroy(spipe->init->dst, spipe->init->channel);
+
+		spipe_destroy_pdata(&spipe->init, &pdev->dev);
+
+		devm_kfree(&pdev->dev, spipe);
+
+		platform_set_drvdata(pdev, NULL);
+	}
+
+}
+
+static const struct of_device_id spipe_match_table[] = {
+	{
+		.compatible = "sprd,spipe",
+	},
+	{},
+};
+
+static struct platform_driver spipe_driver = {
+	.driver = {
+		.owner = THIS_MODULE,
+		.name = "spipe",
+		.suppress_bind_attrs = true,
+		.of_match_table = spipe_match_table,
+	},
+	.probe = spipe_probe,
+	.remove = spipe_remove,
+};
+
+static int __init spipe_init(void)
+{
+	int ret;
+
+	spipe_class = class_create("spipe");
+	if (IS_ERR(spipe_class))
+		return PTR_ERR(spipe_class);
+
+	ret = platform_driver_register(&spipe_driver);
+	if (ret)
+		class_destroy(spipe_class);
+	return ret;
+}
+
+static void __exit spipe_exit(void)
+{
+	platform_driver_unregister(&spipe_driver);
+	class_destroy(spipe_class);
+}
+
+module_init(spipe_init);
+module_exit(spipe_exit);
+
+MODULE_AUTHOR("Chen Gaopeng");
+MODULE_DESCRIPTION("SIPC/SPIPE driver");
+MODULE_LICENSE("GPL");
