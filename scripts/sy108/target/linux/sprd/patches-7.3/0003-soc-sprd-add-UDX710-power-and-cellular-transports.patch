+/* put back */
+int sipx_put(u8 dst, u8 channel, struct sblock *blk)
+{
+	struct sipx_mgr *sipx = (struct sipx_mgr *)sipxs[dst];
+	struct sipx_channel *sipx_chan;
+	u8 ch_index;
+
