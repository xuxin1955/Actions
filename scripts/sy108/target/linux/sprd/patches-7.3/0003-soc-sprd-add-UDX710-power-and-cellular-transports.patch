+#define pr_fmt(fmt) "sipa_eth: " fmt
+
+#include "sipa_flowtable.h"
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/init.h>
+#include <linux/netdevice.h>
+#include <linux/etherdevice.h>
+#include <linux/skbuff.h>
+#include <linux/ip.h>
+#include <linux/ipv6.h>
+#include <linux/udp.h>
+#include <linux/if_arp.h>
+#include <linux/platform_device.h>
+#include <linux/sched.h>
+#include <linux/kthread.h>
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
+#include <linux/of_device.h>
+#include <linux/of.h>
+#include <linux/interrupt.h>
+#include "sipa_eth.h"
+#include "sipa_priv.h"
+
+/* Device status */
+#define DEV_ON 1
+#define DEV_OFF 0
+
+#define SIPA_ETH_NAPI_WEIGHT 64
+#define SIPA_ETH_IFACE_PREF "sipa_eth"
+
+static struct dentry *root;
+static int sipa_eth_debugfs_mknod(void *root, void *data);
+
+static u64 gro_enable;
+
+static inline void sipa_eth_dt_stats_init(struct sipa_eth_dtrans_stats *stats)
+{
+	memset(stats, 0, sizeof(*stats));
+}
+
+static inline void sipa_eth_rx_stats_update(struct sipa_eth_dtrans_stats *stats,
+					    u32 len)
+{
+	stats->rx_sum += len;
+	stats->rx_cnt++;
+}
+
+static inline void sipa_eth_tx_stats_update(struct sipa_eth_dtrans_stats *stats,
+					    u32 len)
+{
+	stats->tx_sum += len;
+	stats->tx_cnt++;
+}
+
+static int sipa_eth_prepare_skb(struct SIPA_ETH *sipa_eth, struct sk_buff *skb)
+{
+	struct iphdr *iph;
+	struct ethhdr *peth;
+	struct net_device *dev;
+	struct sipa_eth_init_data *pdata = sipa_eth->pdata;
+	unsigned int offset = pdata->mac_h ? ETH_HLEN : 0;
+	u8 version;
+
+	dev = sipa_eth->netdev;
+	/* Descriptor length validation does not prove an IP header is present. */
+	if (!pskb_may_pull(skb, offset + 1))
+		return -EINVAL;
+	version = skb->data[offset] >> 4;
+	if (version == 4) {
+		if (!pskb_may_pull(skb, offset + sizeof(struct iphdr)))
+			return -EINVAL;
+		iph = (struct iphdr *)(skb->data + offset);
+		if (iph->ihl < 5 || !pskb_may_pull(skb, offset + iph->ihl * 4))
+			return -EINVAL;
+	} else if (version == 6) {
+		if (!pskb_may_pull(skb, offset + sizeof(struct ipv6hdr)))
+			return -EINVAL;
+	} else {
+		return -EPROTONOSUPPORT;
+	}
+	if (!pdata->mac_h && skb_cow_head(skb, ETH_HLEN))
+		return -ENOMEM;
+
+	/* eth is rawip */
+	/*
+	 * The purpose of adding a fake mac header is
+	 * to prevent a "out-of order" issue
+	 * when doing napi_gro_receive.
+	 *
+	 * On ORCA CPE, ASIC has set a 14byte offset
+	 * in a skb for mac header,
+	 * but the content of this mac header is not initialized,
+	 * so we need to fulfill this offset with a fake mac header.
+	 *
+	 * On Roc1+Orca, a skb arrives at sipa_eth
+	 * has no mac header or a offset.
+	 * But it has a 64 byte header room,
+	 * We have to take advantage of the 64-byte header room,
+	 * because the information in the header room
+	 * is no longer useful for IP layer.
+	 */
+	if (pdata->mac_h) {
+		skb_reset_mac_header(skb);
+		peth = (struct ethhdr *)skb->data;
+	} else {
+		peth = (struct ethhdr *)skb_push(skb, ETH_HLEN);
+		skb_reset_mac_header(skb);
+	}
+	ether_addr_copy(peth->h_source, "12345");
+	ether_addr_copy(peth->h_dest, "54321");
+
+	skb_set_network_header(skb, ETH_HLEN);
+	iph = ip_hdr(skb);
+	if (iph->version == 4)
+		skb->protocol = htons(ETH_P_IP);
+	else
+		skb->protocol = htons(ETH_P_IPV6);
+
+	peth->h_proto = skb->protocol;
+	skb_pull_inline(skb, ETH_HLEN);
+
+	/* TODO chechsum ... */
+	skb->ip_summed = CHECKSUM_NONE;
+	skb->dev = dev;
+	return 0;
+}
+
+static int sipa_eth_rx(struct SIPA_ETH *sipa_eth, int budget)
+{
+	struct sk_buff *skb;
+	struct net_device *dev;
+	struct sipa_eth_dtrans_stats *dt_stats;
+	int skb_cnt = 0;
+	int ret;
+
+	if (!sipa_eth) {
+		pr_err("no sipa_eth device\n");
+		return -EINVAL;
+	}
+
+	dt_stats = &sipa_eth->dt_stats;
+	dev = sipa_eth->netdev;
+
+	while (skb_cnt < budget) {
+		ret = sipa_nic_rx(sipa_eth->nic_id, &skb);
+
+		if (ret) {
+			switch (ret) {
+			case -ENODEV:
+				pr_err("fail to find dev");
+				sipa_eth->stats.rx_errors++;
+				dt_stats->rx_fail++;
+				break;
+			case -ENODATA:
+				pr_debug("no more skb to recv");
+				break;
+			}
+			break;
+		}
+
+		if (!skb) {
+			sipa_eth->stats.rx_errors++;
+			break;
+		}
+		skb_cnt++;
+		ret = sipa_eth_prepare_skb(sipa_eth, skb);
+		if (ret) {
+			sipa_eth->stats.rx_errors++;
+			sipa_eth->stats.rx_dropped++;
+			dt_stats->rx_fail++;
+			dev_kfree_skb_any(skb);
+			continue;
+		}
+
+		sipa_eth->stats.rx_packets++;
+		sipa_eth->stats.rx_bytes += skb->len;
+		sipa_eth_rx_stats_update(dt_stats, skb->len);
+
+		if (gro_enable)
+			napi_gro_receive(&sipa_eth->napi, skb);
+		else
+			netif_receive_skb(skb);
+	}
+
+	return skb_cnt;
+}
+
+static int sipa_eth_rx_poll_handler(struct napi_struct *napi, int budget)
+{
+	struct SIPA_ETH *sipa_eth = container_of(napi, struct SIPA_ETH, napi);
+	int pkts;
+
+	pkts = sipa_eth_rx(sipa_eth, budget);
+
+	/* If the number of pkt is more than weight(64),
+	 * we cannot read them all with a single poll.
+	 * When the return value of poll func equals to weight(64),
+	 * napi structure invokes the poll func one more time by
+	 * __raise_softirq_irqoff.(See napi_poll for details)
+	 * So do not do napi_complete in that case.
+	 */
+	if (pkts < budget)
+		napi_complete_done(napi, pkts);
+	return pkts;
+}
+
+static void sipa_eth_rx_handler(void *priv)
+{
+	struct SIPA_ETH *sipa_eth = (struct SIPA_ETH *)priv;
+
+	if (!sipa_eth) {
+		pr_err("data is NULL\n");
+		return;
+	}
+
+	/* NAPI's MISSED bit closes the final-empty-read/completion race. */
+	napi_schedule(&sipa_eth->napi);
+}
+
+static void sipa_eth_flowctrl_handler(void *priv, int flowctrl)
+{
+	struct SIPA_ETH *sipa_eth = (struct SIPA_ETH *)priv;
+	struct net_device *dev = sipa_eth->netdev;
+
+	if (flowctrl)
+		netif_stop_queue(dev);
+	else if (netif_queue_stopped(dev))
+		netif_wake_queue(dev);
+}
+
+static void sipa_eth_notify_cb(void *priv, enum sipa_evt_type evt,
+			       unsigned long data)
+{
+	switch (evt) {
+	case SIPA_RECEIVE:
+		sipa_eth_rx_handler(priv);
+		break;
+	case SIPA_LEAVE_FLOWCTRL:
+		pr_info("SIPA LEAVE FLOWCTRL\n");
+		sipa_eth_flowctrl_handler(priv, 0);
+		break;
+	case SIPA_ENTER_FLOWCTRL:
+		pr_info("SIPA ENTER FLOWCTRL\n");
+		sipa_eth_flowctrl_handler(priv, 1);
+		break;
+	default:
+		break;
+	}
+}
+
+static int sipa_eth_start_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	struct SIPA_ETH *sipa_eth = netdev_priv(dev);
+	struct sipa_eth_init_data *pdata = sipa_eth->pdata;
+	struct sipa_eth_dtrans_stats *dt_stats;
+	int ret = 0;
+	int netid;
+	unsigned int payload_len;
+
+	dt_stats = &sipa_eth->dt_stats;
+	if (sipa_eth->state != DEV_ON) {
+		pr_err("called when %s is down\n", dev->name);
+		dt_stats->tx_fail++;
+		netif_carrier_off(dev);
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+
+	netid = pdata->netid;
+	/* eth is rawip, so pull 14 bytes */
+	if (!pdata->mac_h) {
+		if (!pskb_may_pull(skb, ETH_HLEN))
+			goto err;
+		skb_pull_inline(skb, ETH_HLEN);
+	}
+	/* Success transfers ownership: do not read skb after the call. */
+	payload_len = skb->len;
+
+	ret = sipa_nic_tx(sipa_eth->nic_id, pdata->term_type, netid, skb);
+	if (unlikely(ret != 0)) {
+		pr_err("fail to send skb, ret %d\n", ret);
+		if (ret == -EAGAIN || ret == -EINPROGRESS) {
+			/* NETDEV_TX_BUSY leaves ownership with the networking stack. */
+			if (!pdata->mac_h)
+				skb_push(skb, ETH_HLEN);
+			dt_stats->tx_fail++;
+			sipa_eth->stats.tx_errors++;
+			netif_stop_queue(dev);
+			sipa_nic_trigger_flow_ctrl_work(sipa_eth->nic_id, ret);
+			return NETDEV_TX_BUSY;
+		}
+		goto err;
+	}
+
+	/* update netdev statistics */
+	sipa_eth->stats.tx_packets++;
+	sipa_eth->stats.tx_bytes += payload_len;
+	sipa_eth_tx_stats_update(dt_stats, payload_len);
+
+	return NETDEV_TX_OK;
+
+err:
+	sipa_eth->netdev->stats.tx_dropped++;
+	dev_kfree_skb_any(skb);
+	return NETDEV_TX_OK;
+}
+
+/* Open interface */
+static int sipa_eth_open(struct net_device *dev)
+{
+	struct SIPA_ETH *sipa_eth = netdev_priv(dev);
+	struct sipa_eth_init_data *pdata = sipa_eth->pdata;
+	int ret = 0;
+
+	pr_info("open %s netid %d term_type %d mac_h %d\n", dev->name,
+		pdata->netid, pdata->term_type, pdata->mac_h);
+	ret = sipa_nic_open(pdata->term_type, pdata->netid, sipa_eth_notify_cb,
+			    (void *)sipa_eth);
+
+	if (ret < 0)
+		return ret;
+
+	sipa_eth->nic_id = ret;
+	sipa_eth->state = DEV_ON;
+
+	sipa_eth_dt_stats_init(&sipa_eth->dt_stats);
+	memset(&sipa_eth->stats, 0, sizeof(sipa_eth->stats));
+
+	if (!netif_carrier_ok(sipa_eth->netdev)) {
+		pr_info("set netif_carrier_on\n");
+		netif_carrier_on(sipa_eth->netdev);
+	}
+
+	/* Open publishes a callback before returning its NIC id. Keep NAPI
+	 * disabled until the id is installed, then poll once for that window.
+	 */
+	napi_enable(&sipa_eth->napi);
+	napi_schedule(&sipa_eth->napi);
+	netif_start_queue(dev);
+
+	return 0;
+}
+
+/* Close interface */
+static int sipa_eth_close(struct net_device *dev)
+{
+	struct SIPA_ETH *sipa_eth = netdev_priv(dev);
+
+	pr_info("close %s!\n", dev->name);
+
+	netif_stop_queue(dev);
+	sipa_nic_close(sipa_eth->nic_id);
+	sipa_eth->state = DEV_OFF;
+	napi_disable(&sipa_eth->napi);
+	netif_carrier_off(dev);
+
+	return 0;
+}
+
+static struct net_device_stats *sipa_eth_get_stats(struct net_device *dev)
+{
+	struct SIPA_ETH *sipa_eth = netdev_priv(dev);
+
+	return &sipa_eth->stats;
+}
+
+static const struct net_device_ops sipa_eth_ops = {
+	.ndo_open = sipa_eth_open,
+	.ndo_stop = sipa_eth_close,
+	.ndo_start_xmit = sipa_eth_start_xmit,
+	.ndo_get_stats = sipa_eth_get_stats,
+#if IS_ENABLED(CONFIG_SPRD_SIPA_NF_FLOWTABLE)
+	.ndo_setup_tc = sipa_flowtable_setup_tc,
+#endif
+};
+
+#if IS_ENABLED(CONFIG_SPRD_SIPA_NF_FLOWTABLE)
+/* BSP sfp_mgr maps a genuine SIPA cellular netdev to VCP terminal 6.
+ * Do not infer hardware endpoints from mutable names or Linux ifindex.
+ * Descriptor lacks netid; admission remains blocked until mux semantics
+ * are established. USB/WLAN need their own verified endpoint adapters.
+ */
+int sipa_eth_flowtable_port(struct net_device *dev, u8 *port)
+{
+	if (!dev || !port || dev->netdev_ops != &sipa_eth_ops)
+		return -EOPNOTSUPP;
+	*port = SIPA_TERM_VCP;
+	return 0;
+}
+#endif
+
+static int sipa_eth_parse_dt(struct sipa_eth_init_data **init,
+			     struct device *dev)
+{
+	struct sipa_eth_init_data *pdata = NULL;
+	struct device_node *np = dev->of_node;
+	int ret;
+	u32 udata, id;
+	s32 sdata;
+
+	if (!np)
+		pr_err("dev of_node np is null\n");
+
+	pdata = devm_kzalloc(dev, sizeof(*pdata), GFP_KERNEL);
+	if (!pdata)
+		return -ENOMEM;
+
+	id = of_alias_get_id(np, "eth");
+	switch (id) {
+	case 0 ... 7:
+		snprintf(pdata->name, IFNAMSIZ, "%s%d", SIPA_ETH_IFACE_PREF,
+			 id);
+		break;
+	default:
+		pr_err("wrong alias id from dts, id %d\n", id);
+		return -EINVAL;
+	}
+
+	ret = of_property_read_s32(np, "sprd,netid", &sdata);
+	if (ret) {
+		pr_err("read sprd,netid ret %d\n", ret);
+		return ret;
+	}
+	/* dts reflect */
+	pdata->netid = sdata - 1;
+
+	ret = of_property_read_u32(np, "sprd,term-type", &udata);
+	if (ret) {
+		pr_err("read sprd,term-type ret %d\n", ret);
+		return ret;
+	}
+
+	pdata->term_type = udata;
+
+	pdata->mac_h = of_property_read_bool(np, "sprd,mac-header");
+
+	*init = pdata;
+	pr_debug("after dt parse, name %s netid %d term-type %d mac_h %d\n",
+		 pdata->name, pdata->netid, pdata->term_type, pdata->mac_h);
+	return 0;
+}
+
+static void s_setup(struct net_device *dev)
+{
+	ether_setup(dev);
+	/*
+	 * avoid mdns to be send
+	 * also disable arp
+	 */
+	dev->flags &= ~(IFF_BROADCAST | IFF_MULTICAST);
+	/* Cellular IP has no ARP peer. Retain its required 14-byte DMA framing. */
+	dev->flags |= IFF_NOARP;
+}
+
+static int sipa_eth_probe(struct platform_device *pdev)
+{
+	struct sipa_eth_init_data *pdata = pdev->dev.platform_data;
+	struct net_device *netdev;
+	struct SIPA_ETH *sipa_eth;
+	char ifname[IFNAMSIZ];
+	int ret;
+
+	if (pdev->dev.of_node && !pdata) {
+		ret = sipa_eth_parse_dt(&pdata, &pdev->dev);
+		if (ret) {
+			pr_err("failed to parse device tree, ret=%d\n", ret);
+			return ret;
+		}
+		pdev->dev.platform_data = pdata;
+	}
+
+	if (!pdata)
+		return -EINVAL;
+	if (!sipa_get_ctrl_pointer() || !sipa_get_ctrl_pointer()->ctx)
+		return -EPROBE_DEFER;
+	strscpy(ifname, pdata->name, IFNAMSIZ);
+	netdev = alloc_netdev(sizeof(struct SIPA_ETH), ifname, NET_NAME_UNKNOWN,
+			      s_setup);
+
+	if (!netdev) {
+		pr_err("alloc_netdev() failed.\n");
+		return -ENOMEM;
+	}
+
+	/*
+	 * If net_device's type is ARPHRD_ETHER, the ipv6 interface identifier
+	 * specified by the network will be covered by addrconf_ifid_eui48,
+	 * this will casue ipv6 fail in some test environment.
+	 * So set the sipa_eth net_device's type to ARPHRD_RAWIP here.
+	 */
+	netdev->type = ARPHRD_RAWIP;
+
+	sipa_eth = netdev_priv(netdev);
+	sipa_eth_dt_stats_init(&sipa_eth->dt_stats);
+	sipa_eth->netdev = netdev;
+	sipa_eth->pdata = pdata;
+	netdev->netdev_ops = &sipa_eth_ops;
+	netdev->watchdog_timeo = 1 * HZ;
+	netdev->irq = 0;
+	netdev->dma = 0;
+
+	eth_hw_addr_random(netdev);
+
+	netif_napi_add_weight(netdev, &sipa_eth->napi, sipa_eth_rx_poll_handler,
+			      SIPA_ETH_NAPI_WEIGHT);
+
+	/* Register new Ethernet interface */
+	ret = register_netdev(netdev);
+	if (ret) {
+		pr_err("register_netdev() failed (%d)\n", ret);
+		netif_napi_del(&sipa_eth->napi);
+		free_netdev(netdev);
+		return ret;
+	}
+
+	sipa_eth->state = DEV_OFF;
+	/* Set link as disconnected */
+	netif_carrier_off(netdev);
+	platform_set_drvdata(pdev, sipa_eth);
+	sipa_eth_debugfs_mknod(root, (void *)sipa_eth);
+	return 0;
+}
+
+/* Cleanup Ethernet device driver. */
+static void sipa_eth_remove(struct platform_device *pdev)
+{
+	struct SIPA_ETH *sipa_eth = platform_get_drvdata(pdev);
+
+	debugfs_remove_recursive(sipa_eth->debugfs_dir);
+	unregister_netdev(sipa_eth->netdev);
+	netif_napi_del(&sipa_eth->napi);
+	free_netdev(sipa_eth->netdev);
+	platform_set_drvdata(pdev, NULL);
+}
+
+static const struct of_device_id sipa_eth_match_table[] = {
+	{ .compatible = "sprd,sipa_eth" },
+	{}
+};
+
+static struct platform_driver sipa_eth_driver = {
+	.probe = sipa_eth_probe,
+	.remove = sipa_eth_remove,
+	.driver = { .owner = THIS_MODULE,
+		    .name = SIPA_ETH_IFACE_PREF,
+		    .of_match_table = sipa_eth_match_table }
+};
+
+static int sipa_eth_debug_show(struct seq_file *m, void *v)
+{
+	struct SIPA_ETH *sipa_eth = (struct SIPA_ETH *)(m->private);
+	struct sipa_eth_dtrans_stats *stats;
+	struct sipa_eth_init_data *pdata;
+
+	if (!sipa_eth) {
+		pr_err("invalid data, sipa_eth is NULL\n");
+		return -EINVAL;
+	}
+	pdata = sipa_eth->pdata;
+	stats = &sipa_eth->dt_stats;
+
+	seq_puts(m, "*************************************************\n");
+	seq_printf(m, "DEVICE: %s, term_type %d, netid %d, state %s mac_h %d\n",
+		   pdata->name, pdata->term_type, pdata->netid,
+		   sipa_eth->state == DEV_ON ? "UP" : "DOWN", pdata->mac_h);
+	seq_puts(m, "\nRX statistics:\n");
+	seq_printf(m, "rx_sum=%u, rx_cnt=%u\n", stats->rx_sum, stats->rx_cnt);
+	seq_printf(m, "rx_fail=%u\n", stats->rx_fail);
+
+	seq_printf(m, "napi_scheduled=%d\n",
+		   test_bit(NAPI_STATE_SCHED, &sipa_eth->napi.state));
+	seq_puts(m, "\nTX statistics:\n");
+	seq_printf(m, "tx_sum=%u, tx_cnt=%u\n", stats->tx_sum, stats->tx_cnt);
+	seq_printf(m, "tx_fail=%u\n", stats->tx_fail);
+
+	seq_puts(m, "*************************************************\n");
+
+	return 0;
+}
+
+static int sipa_eth_debug_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, sipa_eth_debug_show, inode->i_private);
+}
+
+static const struct file_operations sipa_eth_debug_fops = {
+	.open = sipa_eth_debug_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static int debugfs_gro_enable_get(void *data, u64 *val)
+{
+	*val = *(u64 *)data;
+	return 0;
+}
+
+static int debugfs_gro_enable_set(void *data, u64 val)
+{
+	*(u64 *)data = val;
+	return 0;
+}
+
+DEFINE_SIMPLE_ATTRIBUTE(fops_gro_enable, debugfs_gro_enable_get,
+			debugfs_gro_enable_set, "%llu\n");
+
+static int sipa_eth_debugfs_mknod(void *root, void *data)
+{
+	struct SIPA_ETH *sipa_eth = (struct SIPA_ETH *)data;
+
+	if (!sipa_eth)
+		return -ENODEV;
+
+	if (IS_ERR_OR_NULL(root))
+		return -ENXIO;
+
+	sipa_eth->debugfs_dir =
+		debugfs_create_dir(sipa_eth->netdev->name, root);
+	if (IS_ERR(sipa_eth->debugfs_dir))
+		return PTR_ERR(sipa_eth->debugfs_dir);
+
+	debugfs_create_file("stats", 0444, sipa_eth->debugfs_dir, data,
+			    &sipa_eth_debug_fops);
+
+	return 0;
+}
+
+static void __init sipa_eth_debugfs_init(void)
+{
+	root = debugfs_create_dir(SIPA_ETH_IFACE_PREF, NULL);
+	if (IS_ERR(root))
+		return;
+	/* This setting is shared by every interface, so create it only once. */
+	debugfs_create_file("gro_enable", 0600, root, &gro_enable,
+			    &fops_gro_enable);
+}
+
+static int __init sipa_eth_init(void)
+{
+	int ret;
+
+	sipa_eth_debugfs_init();
+	ret = platform_driver_register(&sipa_eth_driver);
+	if (ret)
+		debugfs_remove_recursive(root);
+	return ret;
+}
+
+static void __exit sipa_eth_exit(void)
+{
+	platform_driver_unregister(&sipa_eth_driver);
+	debugfs_remove_recursive(root);
+}
+
+module_init(sipa_eth_init);
+module_exit(sipa_eth_exit);
+
+MODULE_AUTHOR("Wade.Shu");
+MODULE_DESCRIPTION("Unisoc Ethernet device driver for IPA");
+MODULE_LICENSE("GPL");
diff --git a/drivers/staging/sprd/sipa/sipa_eth.h b/drivers/staging/sprd/sipa/sipa_eth.h
new file mode 100644
index 000000000..0e710f224
--- /dev/null
+++ b/drivers/staging/sprd/sipa/sipa_eth.h
@@ -0,0 +1,37 @@
+#ifndef _SIPA_ETH_H_
+#define _SIPA_ETH_H_
+
+#include <linux/sipa.h>
+#include <linux/if.h>
+
+/* Struct of data transfer statistics */
+struct sipa_eth_dtrans_stats {
+	u32 rx_sum;
+	u32 rx_cnt;
+	u32 rx_fail;
+
+	u32 tx_sum;
+	u32 tx_cnt;
+	u32 tx_fail;
+};
+
+/* Device instance data. */
+struct SIPA_ETH {
+	int state;
+	struct net_device *netdev; /* Linux net device */
+	struct dentry *debugfs_dir;
+	enum sipa_nic_id nic_id;
+	struct napi_struct napi; /* Napi instance */
+	/* Record data_transfer statistics */
+	struct sipa_eth_dtrans_stats dt_stats;
+	struct net_device_stats stats; /* Net statistics */
+	struct sipa_eth_init_data *pdata; /* Platform data */
+};
+
+struct sipa_eth_init_data {
+	char name[IFNAMSIZ];
+	u32 term_type;
+	s32 netid;
+	bool mac_h;
+};
+#endif
diff --git a/drivers/staging/sprd/sipa/sipa_flowtable.c b/drivers/staging/sprd/sipa/sipa_flowtable.c
new file mode 100644
index 000000000..0d52da7d0
--- /dev/null
+++ b/drivers/staging/sprd/sipa/sipa_flowtable.c
@@ -0,0 +1,819 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * UDX710 AP nft flowtable adapter and SIPA table builder.
+ * Wire format and hash follow the vendor SFP descriptor ABI, not vendor
+ * netfilter hooks. No flow is admitted until all hardware semantics below
+ * are established. The current revision has no qualified capability set.
+ */
+#include <linux/dma-mapping.h>
+#include <linux/etherdevice.h>
+#include <linux/if_arp.h>
+#include <linux/ip.h>
+#include <linux/ipv6.h>
+#include <linux/jhash.h>
+#include <linux/mutex.h>
+#include <linux/overflow.h>
+#include <linux/slab.h>
+#include <linux/sipa.h>
+#include <linux/tcp.h>
+#include <linux/udp.h>
+#include <net/flow_offload.h>
+#include <net/net_namespace.h>
+#include <net/pkt_cls.h>
+#include <uapi/linux/tc_act/tc_csum.h>
+
+#include "sipa_flowtable.h"
+#include "sipa_hal.h"
+
+#define SIPA_FT_BUCKETS 2048
+#define SIPA_FT_ENTRIES 4096
+#define SIPA_FT_DESC_BYTES 96
+#define SIPA_FT_BUCKET_BYTES 8
+#define SIPA_FT_TABLE_BYTES                       \
+	(SIPA_FT_BUCKETS * SIPA_FT_BUCKET_BYTES + \
+	 SIPA_FT_ENTRIES * SIPA_FT_DESC_BYTES)
+
+/* These are proof obligations, never user or DT feature override switches. */
+#define SIPA_FT_CAP_INGRESS_ISOLATION BIT(0)
+#define SIPA_FT_CAP_TCP_CONTROL_TRAP BIT(1)
+#define SIPA_FT_CAP_TTL_CSUM BIT(2)
+#define SIPA_FT_CAP_FRAGMENT_TRAP BIT(3)
+#define SIPA_FT_CAP_DMA_DRAIN BIT(4)
+#define SIPA_FT_CAP_DELETE_FAIL_CLOSED BIT(5)
+#define SIPA_FT_CAP_POWER_LIFETIME BIT(6)
+#define SIPA_FT_CAP_VCP_NETID BIT(7)
+
+struct sipa_ft_tuple {
+	__be32 dst[4];
+	__be32 src[4];
+	__be16 sport;
+	__be16 dport;
+	u8 family;
+	u8 protocol;
+} __packed;
+
+struct sipa_ft_desc {
+	struct sipa_ft_tuple original;
+	struct sipa_ft_tuple translated;
+	u8 dmac[ETH_ALEN];
+	u8 smac[ETH_ALEN];
+	u8 output_port;
+	u8 flags;
+	__be32 timestamp;
+	__be16 reserved;
+} __packed;
+
+struct sipa_ft_bucket {
+	u8 pad1;
+	__be16 count;
+	u8 pad2;
+	__be32 address;
+} __packed;
+
+static_assert(sizeof(struct sipa_ft_tuple) == 38);
+static_assert(sizeof(struct sipa_ft_desc) == SIPA_FT_DESC_BYTES);
+static_assert(offsetof(struct sipa_ft_desc, output_port) == 88);
+static_assert(offsetof(struct sipa_ft_desc, timestamp) == 90);
+static_assert(sizeof(struct sipa_ft_bucket) == SIPA_FT_BUCKET_BYTES);
+
+struct sipa_ft_table {
+	void *cpu;
+	dma_addr_t dma;
+};
+
+struct sipa_ft_block;
+struct sipa_ft_entry {
+	struct list_head list;
+	struct sipa_ft_block *owner;
+	unsigned long cookie;
+	struct sipa_ft_desc desc;
+	u16 bucket;
+	int ingress_ifindex;
+	u16 tcp_flags_mask;
+};
+
+struct sipa_ft_context {
+	struct device *dma_dev;
+	struct list_head entries;
+	struct sipa_ft_table tables[2];
+	u32 verified_caps;
+	unsigned int count;
+	unsigned int active;
+	bool published;
+	bool quarantine;
+};
+
+struct sipa_ft_block {
+	struct net_device *dev;
+	struct sipa_ft_context *ctx;
+};
+
+static DEFINE_MUTEX(sipa_ft_lock);
+static LIST_HEAD(sipa_ft_block_list);
+static struct sipa_ft_context *sipa_ft_context;
+
+static int sipa_ft_error(struct netlink_ext_ack *extack, const char *msg)
+{
+	NL_SET_ERR_MSG_FMT(extack, "%s", msg);
+	return -EOPNOTSUPP;
+}
+
+/* Same 36-byte key layout and jhash2 seed as vendor sfp_hash_conntrack(). */
+static u16 sipa_ft_hash(const struct sipa_ft_tuple *tuple)
+{
+	struct {
+		__be32 src[4];
+		__be16 sport;
+		u16 family;
+		__be32 dst[4];
+	} key;
+	u32 words[9];
+	u32 seed = ((u32)(__force u16)tuple->dport << 16) | tuple->protocol;
+
+	static_assert(sizeof(key) == sizeof(words));
+	memcpy(key.src, tuple->src, sizeof(key.src));
+	key.sport = tuple->sport;
+	key.family = tuple->family;
+	memcpy(key.dst, tuple->dst, sizeof(key.dst));
+	memcpy(words, &key, sizeof(words));
+	return jhash2(words, ARRAY_SIZE(words), seed) & (SIPA_FT_BUCKETS - 1);
+}
+
+static int sipa_ft_alloc_tables(struct sipa_ft_context *ctx)
+{
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		ctx->tables[i].cpu = dma_alloc_coherent(ctx->dma_dev,
+							SIPA_FT_TABLE_BYTES,
+							&ctx->tables[i].dma,
+							GFP_KERNEL | GFP_DMA32);
+		if (!ctx->tables[i].cpu)
+			goto nomem;
+		/* GFP_DMA32 alone does not constrain an IOMMU's DMA address. */
+		if (ctx->tables[i].dma > U32_MAX ||
+		    SIPA_FT_TABLE_BYTES - 1 > U32_MAX - ctx->tables[i].dma)
+			goto range;
+		memset(ctx->tables[i].cpu, 0, SIPA_FT_TABLE_BYTES);
+	}
+	return 0;
+range:
+	while (i >= 0) {
+		dma_free_coherent(ctx->dma_dev, SIPA_FT_TABLE_BYTES,
+				  ctx->tables[i].cpu, ctx->tables[i].dma);
+		ctx->tables[i--].cpu = NULL;
+	}
+	return -ERANGE;
+nomem:
+	while (--i >= 0) {
+		dma_free_coherent(ctx->dma_dev, SIPA_FT_TABLE_BYTES,
+				  ctx->tables[i].cpu, ctx->tables[i].dma);
+		ctx->tables[i].cpu = NULL;
+	}
+	return -ENOMEM;
+}
+
+static bool sipa_ft_skip(const struct sipa_ft_entry *entry,
+			 const struct sipa_ft_entry *replace,
+			 const struct sipa_ft_block *flush)
+{
+	return entry == replace || (flush && entry->owner == flush);
+}
+
+/* Build the inactive coherent table from a candidate software state. */
+static int sipa_ft_build(struct sipa_ft_context *ctx, unsigned int id,
+			 struct sipa_ft_entry *add,
+			 struct sipa_ft_entry *replace,
+			 struct sipa_ft_block *flush)
+{
+	struct sipa_ft_table *table = &ctx->tables[id];
+	struct sipa_ft_bucket *buckets = table->cpu;
+	struct sipa_ft_desc *descs =
+		table->cpu + SIPA_FT_BUCKETS * sizeof(*buckets);
+	struct sipa_ft_entry *entry;
+	u16 *counts, *cursor;
+	u32 used = 0;
+	unsigned int i;
+	int ret = 0;
+
+	counts = kcalloc(SIPA_FT_BUCKETS * 2, sizeof(*counts), GFP_KERNEL);
+	if (!counts)
+		return -ENOMEM;
+	cursor = counts + SIPA_FT_BUCKETS;
+	list_for_each_entry(entry, &ctx->entries, list) {
+		if (!sipa_ft_skip(entry, replace, flush))
+			counts[entry->bucket]++;
+	}
+	if (add)
+		counts[add->bucket]++;
+	memset(table->cpu, 0, SIPA_FT_TABLE_BYTES);
+	for (i = 0; i < SIPA_FT_BUCKETS; i++) {
+		dma_addr_t address;
+
+		if (used + counts[i] > SIPA_FT_ENTRIES) {
+			ret = -ENOSPC;
+			goto out;
+		}
+		cursor[i] = used;
+		if (counts[i]) {
+			address = table->dma +
+				  SIPA_FT_BUCKETS * sizeof(*buckets) +
+				  used * sizeof(*descs);
+			if (address > U32_MAX) {
+				ret = -ERANGE;
+				goto out;
+			}
+			buckets[i].address = cpu_to_be32(address);
+			buckets[i].count = cpu_to_be16(counts[i]);
+		}
+		used += counts[i];
+	}
+	list_for_each_entry(entry, &ctx->entries, list) {
+		if (!sipa_ft_skip(entry, replace, flush))
+			descs[cursor[entry->bucket]++] = entry->desc;
+	}
+	if (add)
+		descs[cursor[add->bucket]++] = add->desc;
+	dma_wmb();
+out:
+	kfree(counts);
+	return ret;
+}
+
+static int sipa_ft_commit(struct sipa_ft_context *ctx,
+			  struct sipa_ft_entry *add,
+			  struct sipa_ft_entry *replace,
+			  struct sipa_ft_block *flush)
+{
+	struct sipa_hash_table next, expected = {};
+	unsigned int id = ctx->published ? ctx->active ^ 1 : 0;
+	bool uncertain = false;
+	int ret;
+
+	if (ctx->quarantine)
+		return -EIO;
+	/* Both drain and failure containment must be proven before publication. */
+	if ((ctx->verified_caps &
+	     (SIPA_FT_CAP_DMA_DRAIN | SIPA_FT_CAP_DELETE_FAIL_CLOSED |
+	      SIPA_FT_CAP_POWER_LIFETIME)) !=
+	    (SIPA_FT_CAP_DMA_DRAIN | SIPA_FT_CAP_DELETE_FAIL_CLOSED |
+	     SIPA_FT_CAP_POWER_LIFETIME))
+		return -EOPNOTSUPP;
+	if (!ctx->tables[0].cpu) {
+		ret = sipa_ft_alloc_tables(ctx);
+		if (ret)
+			return ret;
+	}
+	ret = sipa_ft_build(ctx, id, add, replace, flush);
+	if (ret)
+		return ret;
+	next.depth = SIPA_FT_BUCKETS;
+	next.tbl_phy_addr = ctx->tables[id].dma;
+	if (ctx->published) {
+		expected.depth = SIPA_FT_BUCKETS;
+		expected.tbl_phy_addr = ctx->tables[ctx->active].dma;
+	}
+	ret = sipa_hal_ft_transaction(&next, &expected, &uncertain);
+	if (ret) {
+		/* Never free or reuse either candidate after an uncertain switch. */
+		ctx->quarantine |= uncertain || ctx->published;
+		return ret;
+	}
+	ctx->published = true;
+	ctx->active = id;
+	return 0;
+}
+
+static int sipa_ft_parse_match(struct net_device *dev,
+			       struct flow_cls_offload *f,
+			       struct sipa_ft_entry *entry)
+{
+	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
+	struct netlink_ext_ack *ack = f->common.extack;
+	struct flow_match_meta meta;
+	struct flow_match_control control;
+	struct flow_match_basic basic;
+	struct flow_match_ports ports;
+	u64 required = BIT_ULL(FLOW_DISSECTOR_KEY_META) |
+		       BIT_ULL(FLOW_DISSECTOR_KEY_CONTROL) |
+		       BIT_ULL(FLOW_DISSECTOR_KEY_BASIC) |
+		       BIT_ULL(FLOW_DISSECTOR_KEY_PORTS);
+	u64 used;
+
+	if (!rule || f->common.chain_index || f->classid)
+		return sipa_ft_error(
+			ack, "SIPA accepts only exact nft flowtable rules");
+	used = rule->match.dissector->used_keys;
+	if ((used & required) != required)
+		return sipa_ft_error(
+			ack,
+			"SIPA requires ingress, protocol and complete ports");
+	flow_rule_match_meta(rule, &meta);
+	if (meta.mask->ingress_ifindex != -1 || meta.mask->ingress_iftype ||
+	    meta.mask->l2_miss || meta.key->ingress_ifindex != dev->ifindex)
+		return sipa_ft_error(
+			ack,
+			"SIPA does not support wildcard or foreign ingress");
+	entry->ingress_ifindex = meta.key->ingress_ifindex;
+	flow_rule_match_control(rule, &control);
+	if (control.mask->addr_type != U16_MAX || control.mask->thoff ||
+	    control.mask->flags)
+		return sipa_ft_error(
+			ack,
+			"SIPA cannot represent control masks or fragments");
+	flow_rule_match_basic(rule, &basic);
+	if (basic.mask->n_proto != cpu_to_be16(U16_MAX) ||
+	    basic.mask->ip_proto != U8_MAX || basic.mask->padding ||
+	    (basic.key->ip_proto != IPPROTO_TCP &&
+	     basic.key->ip_proto != IPPROTO_UDP))
+		return sipa_ft_error(
+			ack, "SIPA supports exact IPv4/IPv6 TCP/UDP only");
+	entry->desc.original.protocol = basic.key->ip_proto;
+	if (basic.key->n_proto == htons(ETH_P_IP) &&
+	    control.key->addr_type == FLOW_DISSECTOR_KEY_IPV4_ADDRS) {
+		struct flow_match_ipv4_addrs ipv4;
+
+		required |= BIT_ULL(FLOW_DISSECTOR_KEY_IPV4_ADDRS);
+		if (!(used & BIT_ULL(FLOW_DISSECTOR_KEY_IPV4_ADDRS)))
+			return -EOPNOTSUPP;
+		flow_rule_match_ipv4_addrs(rule, &ipv4);
+		if (ipv4.mask->src != cpu_to_be32(U32_MAX) ||
+		    ipv4.mask->dst != cpu_to_be32(U32_MAX))
+			return sipa_ft_error(
+				ack, "SIPA requires exact IPv4 addresses");
+		entry->desc.original.family = AF_INET;
+		entry->desc.original.src[0] = ipv4.key->src;
+		entry->desc.original.dst[0] = ipv4.key->dst;
+	} else if (basic.key->n_proto == htons(ETH_P_IPV6) &&
+		   control.key->addr_type == FLOW_DISSECTOR_KEY_IPV6_ADDRS) {
+		struct flow_match_ipv6_addrs ipv6;
+
+		required |= BIT_ULL(FLOW_DISSECTOR_KEY_IPV6_ADDRS);
+		if (!(used & BIT_ULL(FLOW_DISSECTOR_KEY_IPV6_ADDRS)))
+			return -EOPNOTSUPP;
+		flow_rule_match_ipv6_addrs(rule, &ipv6);
+		if (memchr_inv(&ipv6.mask->src, 0xff, sizeof(ipv6.mask->src)) ||
+		    memchr_inv(&ipv6.mask->dst, 0xff, sizeof(ipv6.mask->dst)))
+			return sipa_ft_error(
+				ack, "SIPA requires exact IPv6 addresses");
+		entry->desc.original.family = AF_INET6;
+		memcpy(entry->desc.original.src, &ipv6.key->src,
+		       sizeof(ipv6.key->src));
+		memcpy(entry->desc.original.dst, &ipv6.key->dst,
+		       sizeof(ipv6.key->dst));
+	} else {
+		return sipa_ft_error(
+			ack, "SIPA address family and EtherType must agree");
+	}
+	flow_rule_match_ports(rule, &ports);
+	if (ports.mask->src != cpu_to_be16(U16_MAX) ||
+	    ports.mask->dst != cpu_to_be16(U16_MAX))
+		return sipa_ft_error(
+			ack,
+			"SIPA requires exact source and destination ports");
+	entry->desc.original.sport = ports.key->src;
+	entry->desc.original.dport = ports.key->dst;
+	if (entry->desc.original.protocol == IPPROTO_TCP) {
+		struct flow_match_tcp tcp;
+
+		required |= BIT_ULL(FLOW_DISSECTOR_KEY_TCP);
+		if (!(used & BIT_ULL(FLOW_DISSECTOR_KEY_TCP)))
+			return sipa_ft_error(
+				ack,
+				"SIPA needs the nft TCP FIN/RST exclusion");
+		flow_rule_match_tcp(rule, &tcp);
+		if (tcp.key->flags || tcp.mask->flags != htons(0x05))
+			return sipa_ft_error(
+				ack,
+				"SIPA cannot represent these TCP flag masks");
+		entry->tcp_flags_mask = ntohs(tcp.mask->flags);
+	}
+	if (used != required)
+		return sipa_ft_error(
+			ack,
+			"SIPA cannot represent VLAN, tunnel or extra match keys");
+	entry->desc.translated = entry->desc.original;
+	return 0;
+}
+
+/* Apply native-endian tc pedit values bytewise, checking every changed byte. */
+static int sipa_ft_mangle(const struct flow_action_entry *act,
+			  struct sipa_ft_desc *desc, u8 *eth_seen)
+{
+	const u8 *mask = (const u8 *)&act->mangle.mask;
+	const u8 *value = (const u8 *)&act->mangle.val;
+	u8 *target;
+	u32 offset = act->mangle.offset;
+	unsigned int size, i;
+
+	if (act->mangle.val & act->mangle.mask)
+		return -EOPNOTSUPP;
+	switch (act->mangle.htype) {
+	case FLOW_ACT_MANGLE_HDR_TYPE_ETH:
+		target = desc->dmac;
+		size = ETH_ALEN * 2;
+		break;
+	case FLOW_ACT_MANGLE_HDR_TYPE_IP4:
+		if (desc->original.family != AF_INET || act->mangle.mask ||
+		    (offset != offsetof(struct iphdr, saddr) &&
+		     offset != offsetof(struct iphdr, daddr)))
+			return -EOPNOTSUPP;
+		target = offset == offsetof(struct iphdr, saddr) ?
+				 (u8 *)desc->translated.src :
+				 (u8 *)desc->translated.dst;
+		offset = 0;
+		size = 4;
+		break;
+	case FLOW_ACT_MANGLE_HDR_TYPE_IP6:
+		if (desc->original.family != AF_INET6 || act->mangle.mask ||
+		    offset < offsetof(struct ipv6hdr, saddr) ||
+		    offset > offsetof(struct ipv6hdr, daddr) + 12 ||
+		    (offset & 3))
+			return -EOPNOTSUPP;
+		if (offset < offsetof(struct ipv6hdr, daddr)) {
+			target = (u8 *)desc->translated.src;
+			offset -= offsetof(struct ipv6hdr, saddr);
+		} else {
+			target = (u8 *)desc->translated.dst;
+			offset -= offsetof(struct ipv6hdr, daddr);
+		}
+		size = 16;
+		break;
+	case FLOW_ACT_MANGLE_HDR_TYPE_TCP:
+	case FLOW_ACT_MANGLE_HDR_TYPE_UDP:
+		if (offset ||
+		    (act->mangle.htype == FLOW_ACT_MANGLE_HDR_TYPE_TCP &&
+		     desc->original.protocol != IPPROTO_TCP) ||
+		    (act->mangle.htype == FLOW_ACT_MANGLE_HDR_TYPE_UDP &&
+		     desc->original.protocol != IPPROTO_UDP) ||
+		    (act->mangle.mask &&
+		     act->mangle.mask != (__force u32)htons(0xffff) &&
+		     act->mangle.mask != htonl(0xffff0000) &&
+		     act->mangle.mask != htonl(0x0000ffff)))
+			return -EOPNOTSUPP;
+		target = (u8 *)&desc->translated.sport;
+		size = 4;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	if (offset > size || size - offset < 4)
+		return -EOPNOTSUPP;
+	for (i = 0; i < 4; i++) {
+		if (mask[i] != 0 && mask[i] != 0xff)
+			return -EOPNOTSUPP;
+		if (!mask[i]) {
+			target[offset + i] = value[i];
+			if (act->mangle.htype == FLOW_ACT_MANGLE_HDR_TYPE_ETH)
+				eth_seen[offset + i] = 1;
+		}
+	}
+	return 0;
+}
+
+static int sipa_ft_parse_actions(struct net_device *dev,
+				 struct flow_cls_offload *f,
+				 struct sipa_ft_entry *entry)
+{
+	const struct flow_action_entry *act;
+	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
+	u8 eth_seen[ETH_ALEN * 2] = {};
+	bool redirected = false;
+	unsigned int csum = 0, required_csum;
+	int i, ret;
+
+	flow_action_for_each(i, act, &rule->action) {
+		if (redirected)
+			return sipa_ft_error(
+				f->common.extack,
+				"SIPA requires redirect to be last");
+		switch (act->id) {
+		case FLOW_ACTION_MANGLE:
+			ret = sipa_ft_mangle(act, &entry->desc, eth_seen);
+			if (ret)
+				return sipa_ft_error(
+					f->common.extack,
+					"SIPA cannot encode this mangle");
+			break;
+		case FLOW_ACTION_CSUM:
+			if (csum)
+				return -EOPNOTSUPP;
+			csum = act->csum_flags;
+			break;
+		case FLOW_ACTION_REDIRECT:
+			if (!act->dev ||
+			    !net_eq(dev_net(dev), dev_net(act->dev)))
+				return -EOPNOTSUPP;
+			ret = sipa_eth_flowtable_port(act->dev,
+						      &entry->desc.output_port);
+			if (ret)
+				return sipa_ft_error(
+					f->common.extack,
+					"SIPA output port is not a verified endpoint");
+			redirected = true;
+			break;
+		default:
+			return sipa_ft_error(f->common.extack,
+					     "SIPA action is unsupported");
+		}
+	}
+	if (!redirected || memchr_inv(eth_seen, 1, sizeof(eth_seen)) ||
+	    !is_valid_ether_addr(entry->desc.dmac) ||
+	    !is_valid_ether_addr(entry->desc.smac))
+		return sipa_ft_error(
+			f->common.extack,
+			"SIPA requires complete unicast MAC rewrite and redirect");
+	required_csum = entry->desc.original.protocol == IPPROTO_TCP ?
+				TCA_CSUM_UPDATE_FLAG_TCP :
+				TCA_CSUM_UPDATE_FLAG_UDP;
+	if (entry->desc.original.family == AF_INET)
+		required_csum |= TCA_CSUM_UPDATE_FLAG_IPV4HDR;
+	/* IPv6 nf_flowtable may omit explicit CSUM even for address/port NAT. */
+	if ((csum && csum != required_csum) ||
+	    (entry->desc.original.family == AF_INET &&
+	     memcmp(&entry->desc.original, &entry->desc.translated,
+		    sizeof(entry->desc.original)) &&
+	     csum != required_csum))
+		return sipa_ft_error(
+			f->common.extack,
+			"SIPA checksum action flags are unsupported");
+	entry->bucket = sipa_ft_hash(&entry->desc.original);
+	return 0;
+}
+
+static int sipa_ft_admit(struct sipa_ft_context *ctx,
+			 struct sipa_ft_entry *entry,
+			 struct netlink_ext_ack *ack)
+{
+	if (!(ctx->verified_caps & SIPA_FT_CAP_INGRESS_ISOLATION))
+		return sipa_ft_error(
+			ack,
+			"SIPA descriptor has no ingress match; isolation is unproven");
+	if (entry->tcp_flags_mask &&
+	    !(ctx->verified_caps & SIPA_FT_CAP_TCP_CONTROL_TRAP))
+		return sipa_ft_error(
+			ack,
+			"SIPA cannot prove TCP FIN/RST packets return to nft");
+	if (!(ctx->verified_caps & SIPA_FT_CAP_TTL_CSUM))
+		return sipa_ft_error(
+			ack,
+			"SIPA TTL/hop-limit and NAT checksum behavior is unproven");
+	if (!(ctx->verified_caps & SIPA_FT_CAP_FRAGMENT_TRAP))
+		return sipa_ft_error(
+			ack,
+			"SIPA fragment/extension-header fallback is unproven");
+	if (!(ctx->verified_caps & SIPA_FT_CAP_VCP_NETID))
+		return sipa_ft_error(
+			ack,
+			"SIPA VCP output does not encode the cellular netid");
+	if ((ctx->verified_caps &
+	     (SIPA_FT_CAP_DMA_DRAIN | SIPA_FT_CAP_DELETE_FAIL_CLOSED |
+	      SIPA_FT_CAP_POWER_LIFETIME)) !=
+	    (SIPA_FT_CAP_DMA_DRAIN | SIPA_FT_CAP_DELETE_FAIL_CLOSED |
+	     SIPA_FT_CAP_POWER_LIFETIME))
+		return sipa_ft_error(
+			ack,
+			"SIPA table retirement, delete failure and power lifetime are unproven");
+	return 0;
+}
+
+static struct sipa_ft_entry *sipa_ft_lookup(struct sipa_ft_context *ctx,
+					    struct sipa_ft_block *owner,
+					    unsigned long cookie)
+{
+	struct sipa_ft_entry *entry;
+
+	list_for_each_entry(entry, &ctx->entries, list)
+		if (entry->owner == owner && entry->cookie == cookie)
+			return entry;
+	return NULL;
+}
+
+static int sipa_ft_replace(struct sipa_ft_block *block,
+			   struct flow_cls_offload *f)
+{
+	struct sipa_ft_context *ctx = block->ctx;
+	struct sipa_ft_entry *entry, *old, *other;
+	int ret;
+
+	entry = kzalloc_obj(*entry, GFP_KERNEL);
+	if (!entry)
+		return -ENOMEM;
+	entry->owner = block;
+	entry->cookie = f->cookie;
+	ret = sipa_ft_parse_match(block->dev, f, entry);
+	if (ret)
+		goto out;
+	ret = sipa_ft_parse_actions(block->dev, f, entry);
+	if (ret)
+		goto out;
+	ret = sipa_ft_admit(ctx, entry, f->common.extack);
+	if (ret)
+		goto out;
+	old = sipa_ft_lookup(ctx, block, f->cookie);
+	if (!old && ctx->count >= SIPA_FT_ENTRIES) {
+		ret = -ENOSPC;
+		goto out;
+	}
+	list_for_each_entry(other, &ctx->entries, list) {
+		if (other != old &&
+		    !memcmp(&other->desc.original, &entry->desc.original,
+			    sizeof(entry->desc.original))) {
+			ret = -EEXIST;
+			goto out;
+		}
+	}
+	ret = sipa_ft_commit(ctx, entry, old, NULL);
+	if (ret)
+		goto out;
+	if (old) {
+		list_replace(&old->list, &entry->list);
+		kfree(old);
+	} else {
+		list_add_tail(&entry->list, &ctx->entries);
+		ctx->count++;
+	}
+	return 0;
+out:
+	kfree(entry);
+	return ret;
+}
+
+static int sipa_ft_destroy(struct sipa_ft_block *block, unsigned long cookie)
+{
+	struct sipa_ft_context *ctx = block->ctx;
+	struct sipa_ft_entry *entry = sipa_ft_lookup(ctx, block, cookie);
+	int ret;
+
+	if (!entry)
+		return -ENOENT;
+	ret = sipa_ft_commit(ctx, NULL, entry, NULL);
+	if (ret)
+		return ret;
+	list_del(&entry->list);
+	ctx->count--;
+	kfree(entry);
+	return 0;
+}
+
+static int sipa_ft_block_cb(enum tc_setup_type type, void *type_data,
+			    void *priv)
+{
+	struct sipa_ft_block *block = priv;
+	struct flow_cls_offload *f = type_data;
+	int ret;
+
+	if (type != TC_SETUP_CLSFLOWER)
+		return -EOPNOTSUPP;
+	mutex_lock(&sipa_ft_lock);
+	if (block->ctx->quarantine) {
+		ret = -EIO;
+		goto out;
+	}
+	switch (f->command) {
+	case FLOW_CLS_REPLACE:
+		ret = sipa_ft_replace(block, f);
+		break;
+	case FLOW_CLS_DESTROY:
+		ret = sipa_ft_destroy(block, f->cookie);
+		break;
+	case FLOW_CLS_STATS:
+		if (!sipa_ft_lookup(block->ctx, block, f->cookie)) {
+			ret = -ENOENT;
+			break;
+		}
+		/* No packet/byte counters; timestamp tick/epoch are not established. */
+		ret = sipa_ft_error(
+			f->common.extack,
+			"SIPA has no counters; timestamp epoch/read consistency is unqualified");
+		break;
+	default:
+		ret = -EOPNOTSUPP;
+	}
+out:
+	mutex_unlock(&sipa_ft_lock);
+	return ret;
+}
+
+static void sipa_ft_block_release(void *priv)
+{
+	struct sipa_ft_block *block = priv;
+
+	dev_put(block->dev);
+	kfree(block);
+}
+
+static int sipa_ft_flush(struct sipa_ft_block *block)
+{
+	struct sipa_ft_entry *entry, *tmp;
+	bool found = false;
+	int ret;
+
+	list_for_each_entry(entry, &block->ctx->entries, list)
+		found |= entry->owner == block;
+	if (!found)
+		return 0;
+	ret = sipa_ft_commit(block->ctx, NULL, NULL, block);
+	if (ret)
+		return ret;
+	list_for_each_entry_safe(entry, tmp, &block->ctx->entries, list) {
+		if (entry->owner != block)
+			continue;
+		list_del(&entry->list);
+		block->ctx->count--;
+		kfree(entry);
+	}
+	return 0;
+}
+
+int sipa_flowtable_setup_tc(struct net_device *dev, enum tc_setup_type type,
+			    void *type_data)
+{
+	struct flow_block_offload *f = type_data;
+	struct flow_block_cb *cb;
+	struct sipa_ft_block *block;
+	struct device *dma_dev;
+	int ret = 0;
+
+	/* Register only through nft FT; ordinary TC_SETUP_BLOCK is unsupported. */
+	if (type != TC_SETUP_FT ||
+	    f->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS ||
+	    !net_eq(dev_net(dev), &init_net))
+		return -EOPNOTSUPP;
+	mutex_lock(&sipa_ft_lock);
+	f->driver_block_list = &sipa_ft_block_list;
+	cb = flow_block_cb_lookup(f->block, sipa_ft_block_cb, dev);
+	switch (f->command) {
+	case FLOW_BLOCK_BIND:
+		if (cb) {
+			flow_block_cb_incref(cb);
+			break;
+		}
+		dma_dev = sipa_get_pdev();
+		if (!dma_dev) {
+			ret = -EPROBE_DEFER;
+			break;
+		}
+		if (!sipa_ft_context) {
+			sipa_ft_context =
+				kzalloc_obj(*sipa_ft_context, GFP_KERNEL);
+			if (!sipa_ft_context) {
+				ret = -ENOMEM;
+				break;
+			}
+			sipa_ft_context->dma_dev = get_device(dma_dev);
+			INIT_LIST_HEAD(&sipa_ft_context->entries);
+			/*
+			 * FIN/RST global punt is documented and checked at every switch.
+			 * Other contracts are unqualified; no DT/module-param bypass.
+			 */
+			sipa_ft_context->verified_caps =
+				SIPA_FT_CAP_TCP_CONTROL_TRAP;
+		}
+		if (sipa_ft_context->dma_dev != dma_dev ||
+		    sipa_ft_context->quarantine) {
+			ret = -EBUSY;
+			break;
+		}
+		block = kzalloc_obj(*block, GFP_KERNEL);
+		if (!block) {
+			ret = -ENOMEM;
+			break;
+		}
+		block->dev = dev;
+		block->ctx = sipa_ft_context;
+		dev_hold(dev);
+		cb = flow_block_cb_alloc(sipa_ft_block_cb, dev, block,
+					 sipa_ft_block_release);
+		if (IS_ERR(cb)) {
+			ret = PTR_ERR(cb);
+			sipa_ft_block_release(block);
+			break;
+		}
+		flow_block_cb_incref(cb);
+		flow_block_cb_add(cb, f);
+		list_add_tail(&cb->driver_list, &sipa_ft_block_list);
+		break;
+	case FLOW_BLOCK_UNBIND:
+		if (!cb) {
+			ret = -ENOENT;
+			break;
+		}
+		if (cb->refcnt > 1) {
+			flow_block_cb_decref(cb);
+			break;
+		}
+		ret = sipa_ft_flush(cb->cb_priv);
+		if (ret)
+			break;
+		if (!flow_block_cb_decref(cb)) {
+			flow_block_cb_remove(cb, f);
+			list_del(&cb->driver_list);
+		}
+		break;
+	default:
+		ret = -EOPNOTSUPP;
+	}
+	mutex_unlock(&sipa_ft_lock);
+	return ret;
+}
