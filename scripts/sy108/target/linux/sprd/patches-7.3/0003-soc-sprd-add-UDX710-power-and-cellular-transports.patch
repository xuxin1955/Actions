+	struct cproc_init_data *initdata;
+	void *vbase;
+	int wdtirq;
+	int wdtcnt;
+	wait_queue_head_t wdtwait;
+	char *name;
+	int status;
+	int type;
+	struct cproc_proc_fs procfs;
+};
