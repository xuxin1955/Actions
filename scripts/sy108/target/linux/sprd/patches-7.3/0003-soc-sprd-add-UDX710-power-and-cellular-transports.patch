+			     *)(((u64)ipa_term_fifo->rx_fifo.fifo_base_addr_l) |
+				((u64)ipa_term_fifo->rx_fifo.fifo_base_addr_h
+				 << 32));
+
+	if (node != NULL) {
+		for (i = 0; i < num; i++) {
+			memcpy(fifo_addr + i, node + i,
+			       sizeof(struct sipa_node_description_tag));
+		}
+	} else {
+		return FALSE;
+	}
+
+	return TRUE;
+}
