+#define SBLOCK_NOTIFY_GET 0x01
+#define SBLOCK_NOTIFY_RECV 0x02
+#define SBLOCK_NOTIFY_STATUS 0x04
+#define SBLOCK_NOTIFY_OPEN 0x08
+#define SBLOCK_NOTIFY_CLOSE 0x10
+#define SBLOCK_NOTIFY_OPEN_FAILED 0x20
+
