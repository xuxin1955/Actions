+	if (enable) {
+		tmp = readl_relaxed(reg_base + IPA_CTRL);
+		tmp |= ENABLE_PCIE_MEM_INTR_MODE_MASK;
+		writel_relaxed(tmp, reg_base + IPA_CTRL);
+	} else {
+		tmp = readl_relaxed(reg_base + IPA_CTRL);
+		tmp &= ~ENABLE_PCIE_MEM_INTR_MODE_MASK;
+		writel_relaxed(tmp, reg_base + IPA_CTRL);
+	}
+}
