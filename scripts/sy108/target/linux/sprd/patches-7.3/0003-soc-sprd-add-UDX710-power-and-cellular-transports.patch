+};
+
+struct cproc_proc_fs {
+	struct proc_dir_entry *procdir;
+	struct cproc_proc_entry entries[MAX_CPROC_ENTRY_NUM];
+};
+
+struct cproc_device {
+	struct list_head node;
+	struct kref ref;
+	struct mutex control_lock;
+	bool misc_registered;
