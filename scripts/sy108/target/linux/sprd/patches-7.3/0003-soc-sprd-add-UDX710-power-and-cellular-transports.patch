+
+#define pr_fmt(fmt) "sipa_rm: %s " fmt, __func__
+
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+#include <linux/completion.h>
+#include <linux/sipa.h>
+#include "sipa_rm.h"
+#include "sipa_rm_res.h"
+#include "sipa_rm_peers_list.h"
