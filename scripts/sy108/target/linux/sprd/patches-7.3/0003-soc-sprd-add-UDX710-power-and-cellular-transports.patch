+int sblock_get_for_generation(u8 dst, u8 channel, struct sblock *blk,
+			      int timeout, u32 generation);
+int sblock_receive_for_generation(u8 dst, u8 channel, struct sblock *blk,
+				  int timeout, u32 generation);
