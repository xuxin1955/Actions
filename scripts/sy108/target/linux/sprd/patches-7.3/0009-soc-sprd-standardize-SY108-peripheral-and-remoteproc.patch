-static __poll_t vser_poll(struct file *file, poll_table *wait)
-{
-	struct vser *v = file->private_data;
-
-	poll_wait(file, &v->wait, wait);
-	if (READ_ONCE(v->dead))
-		return EPOLLHUP | EPOLLERR;
-	if (READ_ONCE(v->tx_error) || READ_ONCE(v->faulted))
