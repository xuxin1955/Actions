-
-		sipc_debug_putline(m, '-', 80);
-		seq_puts(m, "ctrl reg list:\n");
-
-		for (i = 0; i < ctrl->reg_nr; i++)
-			seq_printf(m, "reg[%2d]: reg=0x%08x, mask=0x%08x\n", i,
-				   ctrl->ctrl_reg[i], ctrl->ctrl_mask[i]);
