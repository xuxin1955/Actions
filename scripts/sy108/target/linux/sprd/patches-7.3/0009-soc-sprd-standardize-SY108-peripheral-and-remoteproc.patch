-	pr_debug("%s: cp watchdog enable !\n", __func__);
-	WRITE_ONCE(cproc->wdtcnt, CPROC_WDT_TRUE);
-	WRITE_ONCE(cproc->status, CP_WDTIRQ_STATUS);
-	wake_up_interruptible_all(&cproc->wdtwait);
-	return IRQ_HANDLED;
