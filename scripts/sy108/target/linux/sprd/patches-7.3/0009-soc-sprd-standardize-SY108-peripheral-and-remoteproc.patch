-		if (out_ret || in_ret) {
-			WRITE_ONCE(v->faulted, true);
-			pr_err("vser: endpoint drain failed (%d, %d); resources pinned\n",
-			       out_ret, in_ret);
-			wake_up_all(&v->wait);
-		}
-	}
