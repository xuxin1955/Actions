-			EPOLLOUT | EPOLLWRNORM :
-			0) |
-	       (READ_ONCE(v->rx_remaining) && READ_ONCE(v->rx_generation) ==
-						      READ_ONCE(v->generation) ?
-			EPOLLIN | EPOLLRDNORM :
