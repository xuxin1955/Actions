-
-	segs = pdata->segs;
-	sipc_debug_putline(m, '-', 80);
-	seq_puts(m, "segment list:\n");
-
-	for (i = 0; i < pdata->segnr; i++)
-		seq_printf(m,
-			   "segment[%2d]:base=0x%08x, size=0x%08x, name=%s\n",
-			   i, segs[i].base, segs[i].maxsz, segs[i].name);
-
-	sipc_debug_putline(m, '-', 80);
-
-	return 0;
