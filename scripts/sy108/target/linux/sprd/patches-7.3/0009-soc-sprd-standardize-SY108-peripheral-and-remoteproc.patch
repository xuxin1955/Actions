-
-static int vser_open(struct inode *inode, struct file *file)
-{
-	struct miscdevice *misc = file->private_data;
-	struct vser *v = container_of(misc, struct vser, misc);
-
-	if (READ_ONCE(v->dead))
-		return -ENODEV;
-	if (atomic_inc_return(&v->opens) > 2) {
-		atomic_dec(&v->opens);
-		return -EBUSY;
-	}
