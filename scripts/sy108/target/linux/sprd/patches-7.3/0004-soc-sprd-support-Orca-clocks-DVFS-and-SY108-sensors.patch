 {
-	unsigned long val;
-	unsigned int reg;
-
-	val = divider_get_val(rate, parent_rate, NULL,
-			      div->width, 0);
-
-	regmap_read(common->regmap, common->reg + div->offset, &reg);
-	reg &= ~GENMASK(div->width + div->shift - 1, div->shift);
-
-	regmap_write(common->regmap, common->reg + div->offset,
