diff --git a/Documentation/devicetree/bindings/clock/sprd,orca-clk.yaml b/Documentation/devicetree/bindings/clock/sprd,orca-clk.yaml
new file mode 100644
index 000000000..76a371763
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/sprd,orca-clk.yaml
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/sprd,orca-clk.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum Orca clock controllers
+
+maintainers:
+  - Orson Zhai <orsonzhai@gmail.com>
+  - Baolin Wang <baolin.wang7@gmail.com>
+  - Chunyan Zhang <zhang.lyra@gmail.com>
+
+description: |
+  Clock controllers for the nine public Orca providers and the SP-AHB
+  provider on Spreadtrum Orca (UDX710). The SP-AHB provider exposes clock
+  ID 0, the SP UART0 gate. IDs are defined in
+  dt-bindings/clock/sprd,orca-clk.h.
+
+  The SP-AHB controller has a 0x3000-byte register window. Its UART gate
+  uses bit 9 at offset 0, with set and clear aliases at offsets 0x1000
+  and 0x2000. Preserve unused-clock state because firmware may also use
+  this domain. Registering this provider does not establish UART interrupt
+  ownership or implement the pmsys notification protocol.
+
+  The current port retains global CCF parent-name lookup. The supplied board
+  uses roots named ext-26m, ext-32k and rco-100m. The clocks property records
+  the BSP connection but is not a generic replacement for those name-based
+  dependencies. An arbitrary differently named clock phandle is not enough.
+  clk-12m remains unresolved for two AON USB reference mux inputs. See the
+  source guards for controls that are registered but not safe to program.
+
+properties:
+  compatible:
+    enum:
+      - sprd,orca-pmu-gate
+      - sprd,orca-g3-pll
+      - sprd,orca-apcpu-clk
+      - sprd,orca-apahb-gate
+      - sprd,orca-ap-clk
+      - sprd,orca-apapb-gate
+      - sprd,orca-ipa-gate
+      - sprd,orca-spahb-gate
+      - sprd,orca-aon-clk
+      - sprd,orca-aon-gate
+
+  reg:
+    maxItems: 1
+
+  sprd,syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Syscon that owns the controller registers.
+
+  clocks:
+    maxItems: 1
+    description: Board 26 MHz reference; current driver retains CCF name lookup.
+
+  '#clock-cells':
+    const: 1
+
+required:
+  - compatible
+  - clocks
+  - '#clock-cells'
+
+oneOf:
+  - required: [reg]
+  - required: [sprd,syscon]
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: sprd,orca-spahb-gate
+    then:
+      required: [reg]
+      properties:
+        sprd,syscon: false
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@21100000 {
+        compatible = "sprd,orca-ap-clk";
+        reg = <0x21100000 0x1000>;
+        clocks = <&ext_26m>;
+        #clock-cells = <1>;
+    };
+...
diff --git a/Documentation/devicetree/bindings/cpufreq/sprd,orca-cpufreq.yaml b/Documentation/devicetree/bindings/cpufreq/sprd,orca-cpufreq.yaml
new file mode 100644
index 000000000..9b4846be6
--- /dev/null
+++ b/Documentation/devicetree/bindings/cpufreq/sprd,orca-cpufreq.yaml
@@ -0,0 +1,41 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/cpufreq/sprd,orca-cpufreq.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum Orca secure-firmware CPU DVFS interface
+
+maintainers:
+  - Orson Zhai <orsonzhai@gmail.com>
+  - Baolin Wang <baolin.wang7@gmail.com>
+
+description: |
+  The Orca AP CPU frequency driver obtains its CPU OPP frequency/voltage pairs
+  through the secure SIP DVFS service (SMC32 fast calls 0x82000200..207).
+  This is not the public BSP sprd,orca-cpudvfs MMIO interface. No reg or static
+  operating-points property is required on this node. The secure firmware
+  retained from the stock boot chain owns regulator and clock sequencing.
+
+  Each CPU references its cluster parameter node with the legacy
+  cpufreq-data-v1 phandle. The existing supported cluster0 parameter node
+  provides voltage-step in microvolts, tuning-latency-us, and boost-duration
+  equal to zero. The supplied board uses 750000, 200, and 0 respectively.
+  These are firmware request parameters, not a CPU voltage OPP table.
+  The driver obtains all actual frequency/voltage pairs from firmware.
+
+properties:
+  compatible:
+    const: sprd,orca-cpufreq
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    cpufreq {
+        compatible = "sprd,orca-cpufreq";
+    };
+...
diff --git a/Documentation/devicetree/bindings/thermal/sprd,orca-aggregate-thermal.yaml b/Documentation/devicetree/bindings/thermal/sprd,orca-aggregate-thermal.yaml
new file mode 100644
index 000000000..1d2f33942
--- /dev/null
+++ b/Documentation/devicetree/bindings/thermal/sprd,orca-aggregate-thermal.yaml
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/sprd,orca-aggregate-thermal.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum Orca cluster and SoC aggregate temperature sensors
+
+maintainers:
+  - Orson Zhai <orsonzhai@gmail.com>
+  - Baolin Wang <baolin.wang7@gmail.com>
+
+description: |
+  Legacy Orca board descriptions name the input thermal zones. If any input
+  reaches 30000 millicelsius the output is the maximum input; otherwise the
+  output is their arithmetic mean truncated towards zero. Cluster aggregates
+  may consume only sprd,orca-thermal sensors and SoC aggregates may consume
+  only sprd,cluster0-thermal providers. This enforces an acyclic dependency.
+
+  Sensor IDs are specified by the consuming thermal-zone's thermal-sensors
+  argument, not guessed from a unit address. The existing board uses ID15
+  for cluster0 and ID17 for SoC. Legacy PID fields may remain for reference;
+  this temperature provider does not implement a power/energy model or
+  implicitly select the power_allocator governor.
+
+properties:
+  compatible:
+    enum:
+      - sprd,cluster0-thermal
+      - sprd,soc-thermal
+  "#thermal-sensor-cells":
+    const: 1
+  sensor-names:
+    $ref: /schemas/types.yaml#/definitions/string-array
+    minItems: 1
+    maxItems: 16
+    uniqueItems: true
+    description: Names of enabled child nodes below /thermal-zones.
+  k-po:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    deprecated: true
+  k-pu:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    deprecated: true
+  k-i:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    deprecated: true
+  k-d:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    deprecated: true
+  cutoff:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    deprecated: true
+
+required:
+  - compatible
+  - "#thermal-sensor-cells"
+  - sensor-names
+additionalProperties: false
+...
diff --git a/Documentation/devicetree/bindings/thermal/sprd,orca-thermal.yaml b/Documentation/devicetree/bindings/thermal/sprd,orca-thermal.yaml
new file mode 100644
index 000000000..04f4789c9
--- /dev/null
+++ b/Documentation/devicetree/bindings/thermal/sprd,orca-thermal.yaml
@@ -0,0 +1,125 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/sprd,orca-thermal.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Unisoc Orca thermal sensor controller
+
+maintainers:
+  - Orson Zhai <orsonzhai@gmail.com>
+  - Baolin Wang <baolin.wang7@gmail.com>
+  - Chunyan Zhang <zhang.lyra@gmail.com>
+
+$ref: thermal-sensor.yaml#
+
+properties:
+  compatible:
+    const: sprd,orca-thermal
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    minItems: 1
+    maxItems: 2
+    description:
+      Bus enable gate followed optionally by the controller functional mux.
+      On Orca the THM0/1/2 muxes select ext-32k or ext-26m divided by 104.
+      Supplying the mux establishes clock ownership without changing its
+      boot-selected parent or rate. Legacy gate-only descriptions are accepted;
+      neither description by itself establishes the sampling period in seconds.
+
+  clock-names:
+    minItems: 1
+    items:
+      - const: enable
+      - const: functional
+
+  nvmem-cells:
+    maxItems: 2
+    description:
+      One-bit sign and seven-bit ratio calibration values. Cells must provide
+      little-endian, zero-extended values. An Orca-compatible NVMEM provider
+      must interpret offsets as bytes, not fuse block numbers.
+
+  nvmem-cell-names:
+    items:
+      - const: thm_sign_cal
+      - const: thm_ratio_cal
+
+  "#thermal-sensor-cells":
+    const: 1
+
+  "#address-cells":
+    const: 1
+
+  "#size-cells":
+    const: 0
+
+patternProperties:
+  "^([a-z0-9]+-)?sensor@[0-7]$":
+    type: object
+    description:
+      Represent one thermal sensor.
+
+    properties:
+      reg:
+        description: Specify the sensor id.
+        maxItems: 1
+
+      nvmem-cells:
+        maxItems: 1
+        description:
+          Eight-bit delta calibration, in 250 millicelsius steps around 128.
+          The controller uses a nominal slope of 262 millicelsius per raw
+          code and an offset of 66400 millicelsius.
+
+      nvmem-cell-names:
+        const: sen_delta_cal
+
+    required:
+      - reg
+      - nvmem-cells
+      - nvmem-cell-names
+
+    additionalProperties: false
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - nvmem-cells
+  - nvmem-cell-names
+  - "#address-cells"
+  - "#size-cells"
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    thermal@63410000 {
+        compatible = "sprd,orca-thermal";
+        reg = <0x63410000 0x10000>;
+        clock-names = "enable";
+        clocks = <&aonapb_gate 52>;
+        #thermal-sensor-cells = <1>;
+        nvmem-cells = <&thm0_sign>, <&thm0_ratio>;
+        nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        prometheus-sensor@0 {
+            reg = <0>;
+            nvmem-cells = <&thm0_sen0>;
+            nvmem-cell-names = "sen_delta_cal";
+        };
+
+        ank-sensor@1 {
+            reg = <1>;
+            nvmem-cells = <&thm0_sen1>;
+            nvmem-cell-names = "sen_delta_cal";
+        };
+    };
+...
