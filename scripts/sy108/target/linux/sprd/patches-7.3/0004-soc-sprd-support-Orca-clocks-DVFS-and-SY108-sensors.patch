@@ -24,7 +24,8 @@ unsigned long sprd_div_helper_recalc_rate(struct sprd_clk_common *common,
 	unsigned long val;
 	unsigned int reg;
 
-	regmap_read(common->regmap, common->reg + div->offset, &reg);
+	if (regmap_read(common->regmap, common->reg + div->offset, &reg))
