#!/bin/sh
# Confirm this boot after the ordinary management services become usable.
tries=0
last=
kmsg() {
	[ -w /dev/kmsg ] || return 0
	printf '<4>udx-boot: %s\n' "$*" > /dev/kmsg 2>/dev/null || true
}
while [ "$tries" -lt 36 ]; do
	if out=$(/usr/libexec/udx-boot-state accept 2>&1); then
		logger -t udx-boot -p daemon.notice "boot accepted after $((tries * 5))s"
		kmsg "accepted after $((tries * 5))s: ${out:-ready}"
		exit 0
	fi
	tries=$((tries + 1))
	if [ "$out" != "$last" ]; then
		logger -t udx-boot -p daemon.warn "boot accept: ${out:-unknown}"
		kmsg "accept pending: ${out:-unknown}"
	fi
	last=$out
	if [ $((tries % 6)) -eq 0 ]; then
		detail=$(/usr/libexec/udx-boot-state management-ready 2>&1)
		logger -t udx-boot -p daemon.warn "$detail"
		kmsg "$detail"
	fi
	sleep 5
done
logger -t sy108 'Boot confirmation failed; watchdog Recovery fallback remains active'
kmsg 'boot confirmation failed; recovery fallback remains active'
exit 1
