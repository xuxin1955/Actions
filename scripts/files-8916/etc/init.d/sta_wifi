#!/bin/sh /etc/rc.common

START=21
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c '
		L=/tmp/apfirst.log
		F=/etc/apfirst.rebooted
		G=/etc/apfirst.gate
		RB=0
		RUN=/var/run/sta_guard
		SCANIV=120
		MINRSSI=-80
		MISS=3
		RELOADCD=600
		SETTLE=25
		mkdir -p "$RUN"
		lg() {
			echo "t=$(cut -d. -f1 /proc/uptime) $*" >> "$L"
			if [ "$(wc -l < "$L" 2>/dev/null)" -gt 3000 ]; then
				tail -n 2000 "$L" > "$L.n"
				mv "$L.n" "$L"
			fi
		}
		now() {
			cut -d. -f1 /proc/uptime
		}
		jget() {
			jsonfilter -e "$1" 2>/dev/null
		}
		JOK=0
		JQN=none
		[ "$(printf "{\"a\":1}" | jget "@.a")" = "1" ] && JOK=1
		[ "$JOK" = "1" ] || JQN=$(command -v jsonfilter 2>/dev/null || echo none)
		stamp() {
			cat "$RUN/$1" 2>/dev/null || echo 0
		}
		mark() {
			echo "$2" > "$RUN/$1"
		}
		dbm() {
			case "$1" in
			-*) ;;
			*) return 1 ;;
			esac
			case "${1#-}" in
			"" | *[!0-9]*) return 1 ;;
			esac
			[ "$1" -ge -100 ] && [ "$1" -le -5 ]
		}
		sta_list() {
			for q in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
				[ "$(uci -q get "wireless.$q.mode")" = "sta" ] && echo "$q"
			done
		}
		scan_of() {
			if [ "$1" != "$SC_DEV" ]; then
				SC_DEV=$1
				SC_S=$(timeout 20 ubus call iwinfo scan "{\"device\":\"$1\"}" 2>/dev/null)
			fi
			[ -n "$SC_S" ]
		}
		peer_sig() {
			if [ -n "$1" ]; then
				printf "%s" "$SC_S" | jget "@.results[@.bssid=\"$1\"].signal"
			else
				printf "%s" "$SC_S" | jget "@.results[@.ssid=\"$2\"].signal"
			fi
		}
		aif() {
			for d in /sys/class/net/*; do
				case "${d##*/}" in *-ap*) echo "${d##*/}"; return 0 ;; esac
			done
			N=$(iw dev 2>/dev/null | awk "\$1 == \"Interface\" { n = \$2 } \$1 == \"type\" && \$2 == \"AP\" { print n; exit }")
			[ -n "$N" ] && { echo "$N"; return 0; }
			return 1
		}
		sif() {
			iw dev 2>/dev/null | awk "\$1 == \"Interface\" { n = \$2 } \$1 == \"type\" && \$2 == \"managed\" { print n; exit }"
		}
		hok() {
			pidof hostapd >/dev/null 2>&1 && return 0
			pidof wpad >/dev/null 2>&1 && return 0
			return 1
		}
		aok() {
			C=0
			for d in /sys/class/net/*; do
				case "${d##*/}" in
				*-ap*)
					C=$((C + 1))
					case "$(cat "$d/operstate" 2>/dev/null)" in
					up|dormant) ;;
					*) return 1 ;;
					esac
					;;
				esac
			done
			[ "$C" -gt 0 ] && return 0
			AI=$(iw dev 2>/dev/null | awk "\$1 == \"Interface\" { n = \$2 } \$1 == \"type\" && \$2 == \"AP\" { print n; exit }")
			[ -n "$AI" ] || return 1
			[ "$(cat "/sys/class/net/$AI/operstate" 2>/dev/null)" = "up" ] || return 1
			return 0
		}
		sstate() {
			S=$(sif)
			[ -n "$S" ] || { echo none; return 0; }
			if iw dev "$S" link 2>/dev/null | grep -q "Connected to"; then
				echo COMPLETED
			else
				echo DISCONNECTED
			fi
		}
		sok() {
			S=$(sif)
			[ -n "$S" ] || return 1
			iw dev "$S" link 2>/dev/null | grep -q "Connected to" || return 1
			return 0
		}
		netof() {
			for n in $(uci -q get "wireless.$2.network" 2>/dev/null) "$2" $(ubus list "network.interface.*" 2>/dev/null | sed -n "s/^network\.interface\.//p"); do
				[ -n "$n" ] || continue
				NS=$(ifstatus "$n" 2>/dev/null)
				[ -n "$NS" ] || continue
				for d in $(printf "%s" "$NS" | jget "@.l3_device") $(printf "%s" "$NS" | jget "@.device"); do
					[ "$d" = "$1" ] && { echo "$n"; return 0; }
				done
			done
			return 1
		}
		rc() {
			if command -v wpa_cli >/dev/null 2>&1; then
				wpa_cli -i "$1" reassociate >/dev/null 2>&1 && return 0
			fi
			N=$(netof "$1" "$3")
			[ -n "$N" ] || return 1
			i=0
			while [ "$i" -lt 3 ]; do
				ubus call network.interface."$N" down >/dev/null 2>&1
				sleep 1
				ubus call network.interface."$N" up >/dev/null 2>&1
				sleep 3
				[ "$(ubus call network.interface."$N" status 2>/dev/null | jget "@.up")" = "true" ] && return 0
				i=$((i + 1))
			done
			return 1
		}
		pick() {
			for s in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
				[ "$(uci -q get "wireless.$s.mode")" = "$1" ] && { echo "$s"; return 0; }
			done
			return 1
		}
		pickon() {
			for s in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
				[ "$(uci -q get "wireless.$s.mode")" = "$1" ] || continue
				[ "$(uci -q get "wireless.$s.disabled")" != "1" ] && { echo "$s"; return 0; }
			done
			return 1
		}
		devof() {
			for s in "$@"; do
				[ -n "$s" ] || continue
				d=$(uci -q get "wireless.$s.device")
				[ -n "$d" ] && { echo "$d"; return 0; }
			done
			echo radio0
		}
		ifoff() {
			[ -n "$1" ] || return 0
			[ -n "$(uci -q get "wireless.$1.mode")" ] || return 0
			uci set "wireless.$1.disabled=1" 2>/dev/null
			uci commit wireless 2>/dev/null
			sync
		}
		ifon() {
			[ -n "$1" ] || return 0
			[ -n "$(uci -q get "wireless.$1.mode")" ] || return 0
			uci set "wireless.$1.disabled=0" 2>/dev/null
			uci commit wireless 2>/dev/null
			sync
		}
		wup() {
			if [ "$MULTI" = "1" ]; then
				timeout 45 wifi up >/dev/null 2>&1
			else
				timeout 45 wifi up "$DEV" >/dev/null 2>&1
			fi
		}
		apkick() {
			if [ "$MULTI" = "1" ]; then
				timeout 45 wifi up >/dev/null 2>&1
			else
				ubus call network.wireless up "{\"device\":\"$DEV\"}" >/dev/null 2>&1
			fi
			AK=0
			while [ "$AK" -lt 14 ]; do
				aok && return 0
				AK=$((AK + 1))
				sleep 1
			done
			mark apguard $(( $(now) + 120 ))
			timeout 45 wifi reload >/dev/null 2>&1
			AK=0
			while [ "$AK" -lt 12 ]; do
				aok && return 0
				AK=$((AK + 1))
				sleep 1
			done
			wup
			sleep 8
		}
		aheal() {
			mark apguard $(( $(now) + 120 ))
			case "$1" in
			1)
				AD="${ADS:-$DEV}"
				if [ -f "$G" ]; then
					GS=$(cat "$G" 2>/dev/null)
					if [ -n "$GS" ]; then
						ifon "$GS"
						rm -f "$G"
						sync
						lg "ap L1 gate released $GS"
					fi
				fi
				lg "ap L1 reload $AD"
				timeout 45 wifi reload >/dev/null 2>&1
				AK=0
				while [ "$AK" -lt 10 ]; do
					aok && return 0
					AK=$((AK + 1))
					sleep 1
				done
				sleep 5
				;;
			2)
				lg "ap L2 ungated up $DEV"
				ifon "$ASP"
				apkick
				sleep 10
				;;
			3)
				lg "ap L3 hold, never kill ap"
				wup
				sleep 20
				;;
			*)
				if [ -z "$ASP" ]; then
					lg "ap L4 skip no-section"
					sleep 60
				elif [ "$RB" != "1" ]; then
					lg "ap L4 reboot disabled, stay"
					sleep 60
				elif [ -f "$F" ]; then
					lg "ap L4 skip rebooted"
					sleep 60
				else
					lg "ap L4 reboot"
					tail -n 300 "$L" > /etc/apfirst.last
					touch "$F"
					sync
					reboot
				fi
				apstage=0
				;;
			esac
		}
		i=0
		while [ "$i" -lt 20 ]; do
			ubus list network.wireless >/dev/null 2>&1 && break
			i=$((i + 1))
			sleep 1
		done
		i=0
		PHY=""
		while [ "$i" -lt 30 ]; do
			PHY=$(ls /sys/class/ieee80211/ 2>/dev/null | head -n 1)
			[ -n "$PHY" ] && break
			i=$((i + 1))
			sleep 1
		done
		JSE="jok=$JOK"
		[ "$JOK" = "1" ] || JSE="$JSE jq=$JQN"
		lg "boot: phy=${PHY:-none} after ${i}s $JSE"
		[ -f /etc/apfirst.last ] && lg "boot: prev log /etc/apfirst.last lines=$(wc -l < /etc/apfirst.last)"
		ASPANY=$(pick ap)
		STANY=$(pick sta)
		DEV=$(devof "$STANY" "$ASPANY")
		if [ -f "$G" ]; then
			GS=$(cat "$G" 2>/dev/null)
			if [ -n "$GS" ]; then
				ifon "$GS"
				lg "boot: stale gate $GS released"
			fi
			rm -f "$G"
			sync
		fi
		ASP=$(pickon ap)
		STP=$(pickon sta)
		AP_ON=0
		STA_ON=0
		[ -n "$ASP" ] && AP_ON=1
		[ -n "$STP" ] && STA_ON=1
		MULTI=0
		ADS=$(uci -q get "wireless.$ASP.device")
		SDS=$(uci -q get "wireless.$STP.device")
		if [ -n "$ADS" ] && [ -n "$SDS" ] && [ "$ADS" != "$SDS" ]; then
			MULTI=1
			lg "boot: multi-radio ap=$ADS sta=$SDS, no ordering"
		fi
		if [ "$AP_ON" = "1" ]; then
			if [ "$MULTI" = "1" ]; then
				lg "boot: ap=$ASP on $ADS"
			else
				lg "boot: ap=$ASP on dev=$DEV"
			fi
		elif [ -n "$ASPANY" ]; then
			lg "boot: ap=$ASPANY disabled by user, skip"
		else
			lg "boot: no ap section"
		fi
		if [ "$STA_ON" = "1" ]; then
			lg "boot: sta=$STP on net=$(uci -q get wireless.$STP.network)"
		elif [ -n "$STANY" ]; then
			lg "boot: sta=$STANY disabled by user, skip"
		else
			lg "boot: no sta section"
		fi
		if [ "$AP_ON" = "0" ] && [ "$STA_ON" = "0" ]; then
			lg "boot: nothing enabled, idle"
		fi
		if [ "$(uci -q get "wireless.$DEV.disabled")" = "1" ]; then
			if [ "$AP_ON" = "1" ] || [ "$STA_ON" = "1" ]; then
				uci set "wireless.$DEV.disabled=0" 2>/dev/null
				uci commit wireless 2>/dev/null
				sync
				lg "boot: radio $DEV enabled"
			fi
		fi
		if [ "$MULTI" = "1" ]; then
			lg "boot: step1 all radios up"
			timeout 60 wifi up >/dev/null 2>&1
		elif [ "$STA_ON" = "1" ]; then
			if [ "$AP_ON" = "1" ]; then
				echo "$ASP" > "$G"
				sync
				ifoff "$ASP"
				lg "boot: step1 ap off, sta first"
			else
				lg "boot: step1 sta only, no ap"
			fi
			timeout 45 wifi up "$DEV" >/dev/null 2>&1
			i=0
			while [ "$i" -lt 25 ]; do
				if sok; then
					lg "boot: sta ok after ${i}s"
					break
				fi
				[ $((i % 5)) -eq 0 ] && lg "boot: sta wait ${i}s st=$(sstate) if=$(sif)"
				i=$((i + 1))
				sleep 1
			done
			sok || lg "boot: step2 sta timeout 25s, st=$(sstate) if=$(sif)"
			if [ "$AP_ON" = "1" ]; then
				ifon "$ASP"
				rm -f "$G"
				sync
				lg "boot: step3 ap on"
				apkick
			fi
		elif [ "$AP_ON" = "1" ]; then
			lg "boot: step1 ap direct"
			timeout 45 wifi up "$DEV" >/dev/null 2>&1
		fi
		if [ "$AP_ON" = "1" ]; then
			i=0
			while [ "$i" -lt 20 ]; do
				if aok; then
					lg "boot: ap ready after ${i}x2s"
					break
				fi
				i=$((i + 1))
				sleep 2
			done
		fi
		if [ "$AP_ON" = "1" ]; then
			aok || lg "boot: ap not ready, enter loop"
		fi
		apfail=0
		apstage=0
		apcool=0
		apcoolon=0
		while :; do
			if [ "$apcoolon" = "1" ] && [ "$(now)" -ge "$apcool" ]; then
				apcoolon=0
				lg "ap cool over, retry"
			fi
			if [ "$AP_ON" = "1" ] && [ "$apcoolon" = "0" ] && ! aok; then
				apfail=$((apfail + 1))
				A=$(aif)
				[ "$apfail" -eq 1 ] && lg "ap bad if=${A:-none} hd=$(hok && echo 1 || echo 0)"
				if [ "$apfail" -lt 2 ]; then
					sleep 15
					continue
				fi
				apfail=0
				apstage=$((apstage + 1))
				ASTAGE=$apstage
				aheal "$apstage"
				if [ "$apstage" -ge 3 ]; then
					apcool=$(( $(now) + 600 ))
					apcoolon=1
					apstage=0
				fi
				sleep 5
				if aok; then
					lg "ap healed stage=$ASTAGE"
					[ -f "$F" ] && rm -f "$F"
					apstage=0
					apcoolon=0
					apcool=0
				fi
				sleep 15
				continue
			fi
			if [ "$AP_ON" = "1" ] && aok; then
				[ "$apstage" != "0" ] && lg "ap ok stage=$apstage"
				[ -f "$F" ] && rm -f "$F"
				apfail=0
				apstage=0
				apcool=0
				apcoolon=0
			fi
			if [ -f "$G" ] && [ "$STA_ON" = "1" ] && [ "$(uci -q get "wireless.$STP.disabled")" = "1" ]; then
				if [ "$AP_ON" = "0" ] || aok; then
					ifon "$STP"
					rm -f "$G"
					sync
					lg "sta regated $STP, no reload"
				fi
			fi
			if [ "$STA_ON" = "1" ]; then
				WN=$(ubus call network.wireless status 2>/dev/null)
				SC_DEV=""
				SC_S=""
				for SSH in $(sta_list); do
					[ "$(uci -q get "wireless.$SSH.disabled")" = "1" ] && continue
					SDV=$(uci -q get "wireless.$SSH.device")
					[ -n "$SDV" ] || continue
					SB=$(uci -q get "wireless.$SSH.bssid")
					SQ=$(uci -q get "wireless.$SSH.ssid")
					[ -n "$SB" ] || [ -n "$SQ" ] || continue
					SX=$(printf "%s" "$WN" | jget "@.$SDV.interfaces[@.section=\"$SSH\"].section")
					SF=$(printf "%s" "$WN" | jget "@.$SDV.interfaces[@.section=\"$SSH\"].ifname")
					if [ -z "$SX" ] || [ -z "$SF" ]; then
						[ -f "$RUN/$SSH.empty" ] || { touch "$RUN/$SSH.empty"; lg "sta $SSH read empty, skip"; }
						continue
					fi
					SV=$(ubus call iwinfo info "{\"device\":\"$SF\"}" 2>/dev/null | jget "@.signal")
					if [ -z "$SV" ]; then
						[ -f "$RUN/$SSH.empty" ] || { touch "$RUN/$SSH.empty"; lg "sta $SSH signal empty, skip"; }
						continue
					fi
					rm -f "$RUN/$SSH.empty"
					SST=unassoc
					dbm "$SV" && SST=up
					if [ "$SST" = "up" ]; then
						if [ -f "$RUN/$SSH.down" ]; then
							lg "sta up $SSH if=$SF sig=$SV"
							rm -f "$RUN/$SSH.down"
						fi
						mark "$SSH.miss" 0
						continue
					fi
					if [ ! -f "$RUN/$SSH.down" ]; then
						touch "$RUN/$SSH.down"
						lg "sta down $SSH st=$SST if=$SF sdv=$SDV wn=${#WN} sx=${#SX}"
					fi
					if [ "$(stamp "$SSH.rc")" = "0" ]; then
						aok || { lg "sta $SSH $SST first, ap not ok, hold"; continue; }
						mark "$SSH.rc" "$(now)"
						lg "sta $SSH $SST first, reassoc if=$SF"
						if rc "$SF" "$SDV" "$SSH"; then
							lg "sta $SSH reassoc ok $SF"
						else
							lg "sta $SSH reassoc failed, ap kept"
						fi
						continue
					fi
					[ $(( $(now) - $(stamp "$SSH.scan") )) -ge "$SCANIV" ] || continue
					mark "$SSH.scan" "$(now)"
					if ! scan_of "$SDV"; then
						lg "sta $SSH $SST scan fail, hold"
						continue
					fi
					if [ -z "$(printf "%s" "$SC_S" | jget "@.results[0].bssid")" ]; then
						lg "sta $SSH $SST scan empty, hold"
						continue
					fi
					SPS=$(peer_sig "$SB" "$SQ")
					if [ -z "$SPS" ]; then
						SM=$(( $(stamp "$SSH.miss") + 1 ))
						[ "$SM" -gt "$MISS" ] && SM=$MISS
						mark "$SSH.miss" "$SM"
						lg "sta $SSH $SST peer miss $SM/$MISS"
						if [ "$SM" -ge "$MISS" ]; then
							mark "$SSH.miss" 0
							mark "$SSH.scan" $(( $(now) + 600 ))
							lg "sta $SSH $SST peer offline, hold ap"
						fi
						continue
					fi
					mark "$SSH.miss" 0
					if ! dbm "$SPS"; then
						lg "sta $SSH $SST peer sig invalid, hold"
						continue
					fi
					if [ "$SPS" -lt "$MINRSSI" ]; then
						lg "sta $SSH $SST peer weak $SPS, hold"
						continue
					fi
					[ $(( $(now) - $(stamp "$SSH.rc") )) -lt "$RELOADCD" ] && continue
					aok || { lg "sta $SSH unassoc, ap not ok, hold"; continue; }
					mark "$SSH.rc" "$(now)"
					lg "sta $SSH unassoc if=$SF peer=$SPS, reassoc"
					if rc "$SF" "$SDV" "$SSH"; then
						lg "sta $SSH reassoc ok $SF"
					else
						lg "sta $SSH reassoc failed, ap kept"
					fi
					break
				done
			fi
			sleep 15
		done'
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
