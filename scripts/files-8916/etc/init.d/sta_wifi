#!/bin/sh /etc/rc.common

START=21
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c '
		L=/etc/apfirst.log
		F=/etc/apfirst.rebooted
		G=/etc/apfirst.gate
		RB=0
		lg() {
			echo "t=$(cut -d. -f1 /proc/uptime) $*" >> "$L"
			if [ "$(wc -l < "$L" 2>/dev/null)" -gt 600 ]; then
				tail -n 350 "$L" > "$L.n"
				mv "$L.n" "$L"
			fi
		}
		now() {
			cut -d. -f1 /proc/uptime
		}
		aif() {
			for d in /sys/class/net/*; do
				case "${d##*/}" in *-ap*) echo "${d##*/}"; return 0 ;; esac
			done
			N=$(iw dev 2>/dev/null | awk "\$1 == \"Interface\" { n = \$2 } \$1 == \"type\" && \$2 == \"AP\" { print n; exit }")
			[ -n "$N" ] && { echo "$N"; return 0; }
			return 1
		}
		sif() {
			iw dev 2>/dev/null | awk "\$1 == \"Interface\" { n = \$2 } \$1 == \"type\" && \$2 == \"managed\" { print n; exit }"
		}
		hok() {
			pidof hostapd >/dev/null 2>&1 && return 0
			pidof wpad >/dev/null 2>&1 && return 0
			return 1
		}
		aok() {
			C=0
			for d in /sys/class/net/*; do
				case "${d##*/}" in
				*-ap*)
					C=$((C + 1))
					case "$(cat "$d/operstate" 2>/dev/null)" in
					up|dormant) ;;
					*) return 1 ;;
					esac
					;;
				esac
			done
			[ "$C" -gt 0 ] && return 0
			AI=$(iw dev 2>/dev/null | awk "\$1 == \"Interface\" { n = \$2 } \$1 == \"type\" && \$2 == \"AP\" { print n; exit }")
			[ -n "$AI" ] || return 1
			[ "$(cat "/sys/class/net/$AI/operstate" 2>/dev/null)" = "up" ] || return 1
			return 0
		}
		sstate() {
			S=$(sif)
			[ -n "$S" ] || { echo none; return 0; }
			wpa_cli -i "$S" status 2>/dev/null | sed -n "s/^wpa_state=//p" | head -n 1
		}
		sok() {
			S=$(sif)
			[ -n "$S" ] || return 1
			iw dev "$S" link 2>/dev/null | grep -q "Connected to" || return 1
			case "$(wpa_cli -i "$S" status 2>/dev/null | sed -n "s/^wpa_state=//p" | head -n 1)" in
			COMPLETED|"") return 0 ;;
			*) return 1 ;;
			esac
		}
		pick() {
			for s in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
				[ "$(uci -q get "wireless.$s.mode")" = "$1" ] && { echo "$s"; return 0; }
			done
			return 1
		}
		pickon() {
			for s in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
				[ "$(uci -q get "wireless.$s.mode")" = "$1" ] || continue
				[ "$(uci -q get "wireless.$s.disabled")" != "1" ] && { echo "$s"; return 0; }
			done
			return 1
		}
		devof() {
			for s in "$@"; do
				[ -n "$s" ] || continue
				d=$(uci -q get "wireless.$s.device")
				[ -n "$d" ] && { echo "$d"; return 0; }
			done
			echo radio0
		}
		ifoff() {
			[ -n "$1" ] || return 0
			[ -n "$(uci -q get "wireless.$1.mode")" ] || return 0
			uci set "wireless.$1.disabled=1" 2>/dev/null
			uci commit wireless 2>/dev/null
			sync
		}
		ifon() {
			[ -n "$1" ] || return 0
			[ -n "$(uci -q get "wireless.$1.mode")" ] || return 0
			uci set "wireless.$1.disabled=0" 2>/dev/null
			uci commit wireless 2>/dev/null
			sync
		}
		wup() {
			if [ "$MULTI" = "1" ]; then
				timeout 45 wifi up >/dev/null 2>&1
			else
				timeout 45 wifi up "$DEV" >/dev/null 2>&1
			fi
		}
		apkick() {
			if [ "$MULTI" = "1" ]; then
				timeout 45 wifi up >/dev/null 2>&1
			else
				ubus call network.wireless up "{\"device\":\"$DEV\"}" >/dev/null 2>&1
			fi
			sleep 6
			aok && return 0
			timeout 45 wifi reload >/dev/null 2>&1
			sleep 8
			aok && return 0
			wup
			sleep 8
		}
		aheal() {
			case "$1" in
			1)
				lg "ap L1 up $DEV"
				wup
				sleep 20
				;;
			2)
				lg "ap L2 ungated up $DEV"
				ifon "$ASP"
				apkick
				sleep 10
				;;
			3)
				if [ "$MULTI" = "1" ]; then
					lg "ap L3 skip, multi-radio"
					sleep 10
					return
				fi
				STG=0
				if [ "$STA_ON" = "1" ] && [ -n "$STP" ]; then
					lg "ap L3 pause sta $STP"
					echo "$STP" > "$G"
					sync
					ifoff "$STP"
					STG=1
				fi
				lg "ap L3 radio reset"
				timeout 45 wifi down >/dev/null 2>&1
				sleep 2
				wup
				sleep 25
				if [ "$STG" = "1" ]; then
					ifon "$STP"
					rm -f "$G"
					sync
					ubus call network.wireless up "{\"device\":\"$DEV\"}" >/dev/null 2>&1
					if aok; then
						lg "ap L3 sta back $STP"
					else
						lg "ap L3 failed, sta restored $STP"
					fi
				fi
				sleep 5
				;;
			*)
				if [ -z "$ASP" ]; then
					lg "ap L4 skip no-section"
					sleep 60
				elif [ "$RB" != "1" ]; then
					lg "ap L4 reboot disabled, stay"
					sleep 60
				elif [ -f "$F" ]; then
					lg "ap L4 skip rebooted"
					sleep 60
				else
					lg "ap L4 reboot"
					touch "$F"
					sync
					reboot
				fi
				apstage=0
				;;
			esac
		}
		sheal() {
			SIF=$(sif)
			[ -n "$SIF" ] || return 0
			case "$1" in
			1)
				lg "sta L1 reassoc $SIF"
				wpa_cli -i "$SIF" reassociate >/dev/null 2>&1
				sleep 8
				;;
			2)
				lg "sta L2 reconnect $SIF"
				wpa_cli -i "$SIF" disconnect >/dev/null 2>&1
				sleep 2
				wpa_cli -i "$SIF" reconnect >/dev/null 2>&1
				sleep 3
				wpa_cli -i "$SIF" reassociate >/dev/null 2>&1
				sleep 7
				;;
			*)
				lg "sta L3 reconf $SIF"
				wpa_cli -i "$SIF" reconfigure >/dev/null 2>&1
				sleep 10
				;;
			esac
		}
		i=0
		while [ "$i" -lt 20 ]; do
			ubus list network.wireless >/dev/null 2>&1 && break
			i=$((i + 1))
			sleep 1
		done
		i=0
		PHY=""
		while [ "$i" -lt 30 ]; do
			PHY=$(ls /sys/class/ieee80211/ 2>/dev/null | head -n 1)
			[ -n "$PHY" ] && break
			i=$((i + 1))
			sleep 1
		done
		lg "boot: phy=${PHY:-none} after ${i}s"
		ASPANY=$(pick ap)
		STANY=$(pick sta)
		DEV=$(devof "$STANY" "$ASPANY")
		if [ -f "$G" ]; then
			GS=$(cat "$G" 2>/dev/null)
			if [ -n "$GS" ]; then
				ifon "$GS"
				lg "boot: stale gate $GS released"
			fi
			rm -f "$G"
			sync
		fi
		ASP=$(pickon ap)
		STP=$(pickon sta)
		AP_ON=0
		STA_ON=0
		[ -n "$ASP" ] && AP_ON=1
		[ -n "$STP" ] && STA_ON=1
		MULTI=0
		ADS=$(uci -q get "wireless.$ASP.device")
		SDS=$(uci -q get "wireless.$STP.device")
		if [ -n "$ADS" ] && [ -n "$SDS" ] && [ "$ADS" != "$SDS" ]; then
			MULTI=1
			lg "boot: multi-radio ap=$ADS sta=$SDS, no ordering"
		fi
		if [ "$AP_ON" = "1" ]; then
			if [ "$MULTI" = "1" ]; then
				lg "boot: ap=$ASP on $ADS"
			else
				lg "boot: ap=$ASP on dev=$DEV"
			fi
		elif [ -n "$ASPANY" ]; then
			lg "boot: ap=$ASPANY disabled by user, skip"
		else
			lg "boot: no ap section"
		fi
		if [ "$STA_ON" = "1" ]; then
			lg "boot: sta=$STP on net=$(uci -q get wireless.$STP.network)"
		elif [ -n "$STANY" ]; then
			lg "boot: sta=$STANY disabled by user, skip"
		else
			lg "boot: no sta section"
		fi
		if [ "$AP_ON" = "0" ] && [ "$STA_ON" = "0" ]; then
			lg "boot: nothing enabled, idle"
		fi
		if [ "$(uci -q get "wireless.$DEV.disabled")" = "1" ]; then
			if [ "$AP_ON" = "1" ] || [ "$STA_ON" = "1" ]; then
				uci set "wireless.$DEV.disabled=0" 2>/dev/null
				uci commit wireless 2>/dev/null
				sync
				lg "boot: radio $DEV enabled"
			fi
		fi
		if [ "$MULTI" = "1" ]; then
			lg "boot: step1 all radios up"
			timeout 60 wifi up >/dev/null 2>&1
		elif [ "$STA_ON" = "1" ]; then
			if [ "$AP_ON" = "1" ]; then
				echo "$ASP" > "$G"
				sync
				ifoff "$ASP"
				lg "boot: step1 ap off, sta first"
			else
				lg "boot: step1 sta only, no ap"
			fi
			timeout 45 wifi up "$DEV" >/dev/null 2>&1
			i=0
			while [ "$i" -lt 25 ]; do
				if sok; then
					lg "boot: sta ok after ${i}s"
					break
				fi
				[ $((i % 5)) -eq 0 ] && lg "boot: sta wait ${i}s st=$(sstate) if=$(sif)"
				i=$((i + 1))
				sleep 1
			done
			sok || lg "boot: step2 sta timeout 25s, st=$(sstate) if=$(sif)"
			if [ "$AP_ON" = "1" ]; then
				ifon "$ASP"
				rm -f "$G"
				sync
				lg "boot: step3 ap on"
				apkick
			fi
		elif [ "$AP_ON" = "1" ]; then
			lg "boot: step1 ap direct"
			timeout 45 wifi up "$DEV" >/dev/null 2>&1
		fi
		if [ "$AP_ON" = "1" ]; then
			i=0
			while [ "$i" -lt 20 ]; do
				if aok; then
					lg "boot: ap ready after ${i}x2s"
					break
				fi
				i=$((i + 1))
				sleep 2
			done
		fi
		if [ "$AP_ON" = "1" ]; then
			aok || lg "boot: ap not ready, enter loop"
		fi
		apfail=0
		apstage=0
		apcool=0
		apcoolon=0
		stfail=0
		ststage=0
		sback=0
		stcool=0
		sbust=0
		sup=0
		tick=0
		fbt0=0
		fbdone=0
		while :; do
			tick=$((tick + 1))
			# sta 兜底：独立按真实秒数计时；掉线满 180s 且 AP 正常才补一次，只试一次
			if [ "$STA_ON" = "1" ]; then
				FBDIS=$(uci -q get "wireless.$STP.disabled")
				if sok && [ "$FBDIS" != "1" ]; then
					fbt0=0
					fbdone=0
				else
					FBN=$(now)
					[ "$fbt0" = "0" ] && fbt0=$FBN
					if [ "$fbdone" = "0" ] && [ $((FBN - fbt0)) -ge 180 ]; then
						if [ "$AP_ON" = "0" ] || aok; then
							FBIF=$(sif)
							if [ "$FBDIS" = "1" ] || [ -z "$FBIF" ]; then
								fbdone=1
								if [ "$FBDIS" = "1" ]; then
									lg "sta fallback: re-enable $STP"
									ifon "$STP"
								fi
								if [ -f "$G" ]; then rm -f "$G"; fi
								sync
								lg "sta fallback: wifi reload iface=${FBIF:-none}"
								timeout 45 wifi reload >/dev/null 2>&1
								sleep 10
							else
								FBST=$(sstate)
								case "$FBST" in
								SCANNING|ASSOCIATING|AUTHENTICATING|ASSOCIATED|4WAY_HANDSHAKE|GROUP_HANDSHAKE) ;;
								*)
									fbdone=1
									lg "sta fallback reassoc $FBIF st=$FBST"
									wpa_cli -i "$FBIF" reassociate >/dev/null 2>&1
									;;
								esac
							fi
						fi
					fi
				fi
			fi
			if [ "$apcoolon" = "1" ] && [ "$(now)" -ge "$apcool" ]; then
				apcoolon=0
				lg "ap cool over, retry"
			fi
			if [ "$AP_ON" = "1" ] && [ "$apcoolon" = "0" ] && ! aok; then
				apfail=$((apfail + 1))
				A=$(aif)
				[ "$apfail" -eq 1 ] && lg "ap bad if=${A:-none} hd=$(hok && echo 1 || echo 0)"
				if [ "$apfail" -lt 2 ]; then
					sleep 15
					continue
				fi
				apfail=0
				apstage=$((apstage + 1))
				ASTAGE=$apstage
				aheal "$apstage"
				if [ "$apstage" -ge 3 ]; then
					apcool=$(( $(now) + 600 ))
					apcoolon=1
					apstage=0
				fi
				sleep 5
				if aok; then
					lg "ap healed stage=$ASTAGE"
					[ -f "$F" ] && rm -f "$F"
					apstage=0
					apcoolon=0
					apcool=0
				fi
				sleep 15
				continue
			fi
			if [ "$AP_ON" = "1" ] && aok; then
				[ "$apstage" != "0" ] && lg "ap ok stage=$apstage"
				[ -f "$F" ] && rm -f "$F"
				apfail=0
				apstage=0
				apcool=0
				apcoolon=0
			fi
			if [ -f "$G" ] && [ "$STA_ON" = "1" ] && [ "$(uci -q get "wireless.$STP.disabled")" = "1" ]; then
				if [ "$AP_ON" = "0" ] || aok; then
					ifon "$STP"
					rm -f "$G"
					sync
					ubus call network.wireless up "{\"device\":\"$DEV\"}" >/dev/null 2>&1
					lg "sta regated $STP"
				fi
			fi
			if [ "$STA_ON" = "1" ] && [ "$tick" -ge "$stcool" ]; then
				ST=$(sstate)
				if sok; then
					[ "$sup" != "1" ] && lg "sta up st=$ST"
					sup=1
					stfail=0
					ststage=0
					sback=0
					sbust=0
				elif [ "$ST" = "SCANNING" ] || [ "$ST" = "ASSOCIATING" ] || [ "$ST" = "AUTHENTICATING" ] || [ "$ST" = "ASSOCIATED" ] || [ "$ST" = "4WAY_HANDSHAKE" ] || [ "$ST" = "GROUP_HANDSHAKE" ]; then
					sup=0
					if [ "$sbust" = "0" ]; then
						sbust=$tick
						lg "sta busy st=$ST"
					elif [ $((tick - sbust)) -ge 4 ]; then
						sbust=0
						stfail=$((stfail + 1))
						lg "sta stuck st=$ST n=$stfail"
					fi
				else
					sup=0
					sbust=0
					stfail=$((stfail + 1))
					[ "$stfail" -eq 1 ] && lg "sta bad st=$ST stage=$ststage"
				fi
				if [ "$stfail" -ge 3 ]; then
					if [ "$AP_ON" = "1" ] && ! aok; then
						[ "$stfail" -lt 9 ] && lg "sta held, ap not ok"
						stfail=9
					else
						stfail=0
						ststage=$((ststage + 1))
						[ "$ststage" -gt 3 ] && ststage=3
						sheal "$ststage"
						if [ "$ststage" -eq 3 ]; then
							sback=$((sback + 1))
							[ "$sback" -gt 4 ] && sback=4
							case "$sback" in
							1) stcool=$((tick + 4)) ;;
							2) stcool=$((tick + 8)) ;;
							3) stcool=$((tick + 16)) ;;
							4) stcool=$((tick + 40)) ;;
							esac
						fi
						sleep 5
						if sok; then
							lg "sta healed stage=$ststage"
							ststage=0
							stfail=0
							sback=0
							stcool=0
							sbust=0
						fi
					fi
				fi
			fi
			sleep 15
		done'
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
