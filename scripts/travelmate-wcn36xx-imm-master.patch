 }
+
+f_wcn36xx_cfg_exists() {
+	[ -n "${1}" ] && uci -q get "wireless.${1}" >/dev/null 2>&1
+}
+
+f_wcn36xx_is_radio() {
+	local radio="${1}" path
+	f_wcn36xx_cfg_exists "${radio}" || return 1
+	path="$(uci -q get "wireless.${radio}.path" 2>/dev/null)"
+	case "${path}" in
+		*wcnss:wifi*|*WCNSS_CTRL*) return 0 ;;
+	esac
+	return 1
+}
+f_wcn36xx_sta_ifname() {
+	local radio="${1}" raw ifname section
+	f_wcn36xx_cfg_exists "${radio}" || { printf "%s" ""; return 1; }
+
+	# Prefer netifd runtime status, it's more reliable than guessing from sysfs.
+	raw="$("${trm_ubuscmd}" -S call network.wireless status 2>/dev/null)"
+	ifname="$(printf "%s" "${raw}" | "${trm_jsoncmd}" -ql1 -e '@.*.interfaces[@.section!="" && @.config.mode="sta" && @.config.device="'"${radio}"'"].ifname')"
+	if [ -n "${ifname}" ]; then
+		printf "%s" "${ifname}"
+		return 0
+	fi
+	# Fallback for older/partial netifd state
+	ifname="$(printf "%s" "${raw}" | "${trm_jsoncmd}" -ql1 -e '@.*.interfaces[@.config.mode="sta"].ifname')"
+	printf "%s" "${ifname}"
+}
+
+f_wcn36xx_freq_to_channel() {
+	case "${1}" in
+		2412) printf "1" ;;
+		2417) printf "2" ;;
+		2422) printf "3" ;;
+		2427) printf "4" ;;
+		2432) printf "5" ;;
+		2437) printf "6" ;;
+		2442) printf "7" ;;
+		2447) printf "8" ;;
+		2452) printf "9" ;;
+		2457) printf "10" ;;
+		2462) printf "11" ;;
+		2467) printf "12" ;;
+		2472) printf "13" ;;
+		2484) printf "14" ;;
+		*) printf "" ;;
+	esac
+}
+
+f_wcn36xx_sta_channel() {
+	local ifname="${1}" channel freq raw
+	# Prefer iwinfo/ubus channel, which is usually available earlier than
+	# 'iw dev ... link' right after association.
+	raw="$("${trm_ubuscmd}" -S call iwinfo info "{\"device\":\"${ifname}\"}" 2>/dev/null)"
+	channel="$(printf "%s" "${raw}" | "${trm_jsoncmd}" -ql1 -e '@.channel')"
+	if [ -n "${channel}" ] && [ "${channel}" != "0" ] && [ "${channel}" != "auto" ]; then
+		printf "%s" "${channel}"
+		return 0
+	fi
+	# Fallback to freq from nl80211 link info.
+	freq="$(iw dev "${ifname}" link 2>/dev/null | "${trm_awkcmd}" '/freq:/ { print $2; exit }')"
+	[ -n "${freq}" ] || return 1
+	f_wcn36xx_freq_to_channel "${freq}"
+}
+
+f_wcn36xx_save_ap_state() {
+	local radio="${1}" state_file="${trm_apdisabled}.${radio}" channel_file="${trm_apchannel}.${radio}"
+	local current_channel
+	f_wcn36xx_cfg_exists "${radio}" || return 1
+	: > "${state_file}"
+	current_channel="$(uci -q get "wireless.${radio}.channel" 2>/dev/null)"
+	[ -n "${current_channel}" ] && printf "%s" "${current_channel}" > "${channel_file}"
+	config_foreach f_wcn36xx_save_ap_state_cb wifi-iface "${radio}" "${state_file}"
+}
+f_wcn36xx_save_ap_state_cb() {
+	local section="${1}" radio="${2}" state_file="${3}" mode disabled device
+	f_wcn36xx_cfg_exists "${section}" || return
+	device="$(uci -q get "wireless.${section}.device" 2>/dev/null)"
+	[ "${device}" = "${radio}" ] || return
+	mode="$(uci -q get "wireless.${section}.mode" 2>/dev/null)"
+	disabled="$(uci -q get "wireless.${section}.disabled" 2>/dev/null)"
+	[ -z "${disabled}" ] && disabled="0"
+	if [ "${mode}" = "ap" ] && [ "${disabled}" != "1" ]; then
+		printf "%s\n" "${section}" >> "${state_file}"
+	fi
+}
+f_wcn36xx_disable_ap() {
+	local radio="${1}"
+	f_wcn36xx_cfg_exists "${radio}" || return 1
+	config_foreach f_wcn36xx_disable_ap_cb wifi-iface "${radio}"
+}
+f_wcn36xx_disable_ap_cb() {
+	local section="${1}" radio="${2}" device mode
+	f_wcn36xx_cfg_exists "${section}" || return
+	device="$(uci -q get "wireless.${section}.device" 2>/dev/null)"
+	[ "${device}" = "${radio}" ] || return
+	mode="$(uci -q get "wireless.${section}.mode" 2>/dev/null)"
+	if [ "${mode}" = "ap" ] && f_wcn36xx_cfg_exists "${section}"; then
+		uci_set "wireless" "${section}" "disabled" "1"
+	fi
+}
+f_wcn36xx_enable_saved_ap() {
+	local radio="${1}" state_file="${trm_apdisabled}.${radio}" section
+	[ -f "${state_file}" ] || return 0
+	while read -r section; do
+		[ -n "${section}" ] && uci -q delete "wireless.${section}.disabled" 2>/dev/null
+	done < "${state_file}"
+}
+f_wcn36xx_restore_channel() {
+	local radio="${1}" saved_channel
+	f_wcn36xx_cfg_exists "${radio}" || return 1
+	saved_channel="$(cat "${trm_apchannel}.${radio}" 2>/dev/null)"
+	[ -n "${saved_channel}" ] && uci_set "wireless" "${radio}" "channel" "${saved_channel}"
+}
+f_wcn36xx_sync_channel() {
+	local radio="${1}" sta_ifname="${2}" target_channel current_channel
+	f_wcn36xx_cfg_exists "${radio}" || return 1
+	target_channel="$(f_wcn36xx_sta_channel "${sta_ifname}")"
+	f_log "debug" "f_wcn36xx_sync_channel ::: radio: ${radio:-"-"}, sta_ifname: ${sta_ifname:-"-"}, target_channel: ${target_channel:-"-"}"
+	[ -n "${target_channel}" ] || return 1
+	current_channel="$(uci -q get "wireless.${radio}.channel" 2>/dev/null)"
+	if [ "${target_channel}" != "${current_channel}" ]; then
+		uci_set "wireless" "${radio}" "channel" "${target_channel}"
+		f_log "info" "wcn36xx channel sync '${radio}': ${current_channel:-"-"} => ${target_channel}"
+	fi
+	return 0
+}
